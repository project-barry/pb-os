#!/bin/bash
# sm8550-run-bottom -- <command> [args...]
# Run <command> on the bottom panel (AYN Thor, Retroid Pocket Duo) while Game
# Mode drives the top one (after Armada's armada-run-bottom). Game Mode's
# gamescope lends the bottom connector
# over its lease socket (--lease-connector) and forwards the bottom
# touchscreen (--ignore-touch-device); this nested gamescope takes that lease.
set -euo pipefail

fail() {
  echo "sm8550-run-bottom: $*" >&2
  exit 1
}

[[ "${1:-}" == -- ]] || fail "usage: sm8550-run-bottom -- <command> [args...]"
shift
(( $# > 0 )) || fail "no command specified"

sock="${GAMESCOPE_LEASE_SOCK:-/tmp/gamescope-lease.sock}"
[[ -S "$sock" ]] || fail "no lease socket at $sock (is Game Mode running?)"

# The Thor's bottom panel is portrait-native and turned right; the Retroid
# Pocket Duo's (il97680a, 1280x960) is landscape-native (barry_device's
# BARRY_TOUCH_TURN).
. /usr/lib/barry_launcher/barry_device
orientation="$BARRY_TOUCH_TURN"

# The top screen's X server, for Barry's top-screen keyboard (letters off
# the US layout go there through XTest).
export BARRY_TOP_DISPLAY="${DISPLAY:-}"
unset DISPLAY WAYLAND_DISPLAY GAMESCOPE_WAYLAND_DISPLAY
# Its PipeWire stream gets a name of its own: Steam's game recorder connects to
# the stream named "gamescope" and otherwise could pick this one (no game here).
export GAMESCOPE_PIPEWIRE_NAME=gamescope-bottom
exec gamescope \
  --backend drm \
  --drm-lease-client "$sock" \
  --drm-lease-yield \
  --expose-wayland \
  --force-windows-fullscreen \
  --xwayland-count 1 \
  --default-touch-mode 4 \
  --force-orientation "$orientation" \
  --force-composition-rotation \
  -- "$@"
