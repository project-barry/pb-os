def log(msg: str) -> None:
    print(msg, flush=True)


class State:
    def __init__(self) -> None:
        self.lock = threading.Lock()
        self.visible = False
        self.top = False
        self.apps: dict[str, subprocess.Popen] = {}
        self.services: dict[str, subprocess.Popen] = {}  # user app -> its service (barry_apps)
        self.status: dict[str, str] = {}  # app -> what its tile says meanwhile
        self.overlay_marked = False
        self.input_focus: bool | None = None
        self.quiet_until = 0.0  # monotonic time: no keyboard for text focus before it
        self.last_touch: float | None = None  # monotonic; None: no touchscreen found
        self.touch_began: float | None = None  # monotonic: the latest touch's first finger down
        self.touch_at: tuple[int, int] | None = None  # where (screen pixels) that finger came down
        self.hidden_by_hand = 0.0  # monotonic: the keyboard's own hide (its ⌄ key, a tap beside it)
        self.curtain = ""  # the name of the app opening under the cover, if any
        self.curtain_app: str | None = None
        self.curtain_shows = 0.0  # monotonic: when the cover shows (CURTAIN "delay")
        self.text_acc = None  # the focused editable field, if any
        self.keyboard_height = 0  # the key panel's height, as Keyboard.qml reports it
        self.inset: int | None = None  # GAMESCOPE_FOCUS_BOTTOM_INSET last set
        self.home_serial = 0  # counts trips home, for the home screen's slide-in
        self.home_ready = threading.Event()
        self.im = None  # Desktop Mode: barry_desktop.InputMethod
        self.last_top_click: float | None = None  # monotonic: trackpad click or top-screen touch
        self.top_keyboard = {"serial": 0, "visible": False}  # the Trackpad app's keyboard
        self.opened_for_game: dict[str, str] = {}  # game appid -> the app it opened

    def set_top_keyboard(self, visible: bool, why: str) -> None:
        with self.lock:
            self.top_keyboard = {"serial": self.top_keyboard["serial"] + 1, "visible": visible}
        log(f"{why}: trackpad keyboard {'up' if visible else 'down'}")

    def keyboard(self) -> dict:
        with self.lock:
            return {"visible": self.visible, "top": self.top}

    def set_keyboard(self, visible: bool, top: bool | None = None) -> None:
        if visible and dashboard_up():
            visible = False
        with self.lock:
            self.visible = visible
            if top is not None:
                self.top = top
        # Touches go to the keyboard's window only while it (or the cover
        # over an opening app) shows; it turns opaque on its next poll.
        keyboard_input_focus(visible or STATE.curtain_app is not None)
        apply_inset()


STATE = State()


def dashboard_up() -> bool:
    try:
        with open(DASHBOARD_FLAG, encoding="utf-8") as fh:
            return fh.read().strip() == "1"
    except OSError:
        return False


def set_keyboard_prop(prop: str, value: str, quiet: bool = False) -> bool:
    r = subprocess.run(
        ["xprop", "-name", KEYBOARD_TITLE, "-f", prop, "32c", "-set", prop, value],
        capture_output=True, text=True,
    )
    if r.returncode != 0 and not quiet:
        log(f"cannot set {prop} on the keyboard: {r.stderr.strip()}")
    return r.returncode == 0


def apply_inset() -> None:
    """While the keyboard shows, gamescope makes the app that much shorter
    and draws it from the top: the keyboard pushes the app up instead of
    covering it."""
    with STATE.lock:
        inset = STATE.keyboard_height if STATE.visible else 0
        if inset == STATE.inset:
            return
        STATE.inset = inset
    if DESKTOP:
        barry_desktop.set_inset(inset)
        return
    r = subprocess.run(["xprop", "-root", "-f", INSET_PROP, "32c", "-set", INSET_PROP, str(inset)],
                       capture_output=True, text=True)
    if r.returncode != 0:
        log(f"cannot set {INSET_PROP}: {r.stderr.strip()}")


def mark_keyboard_overlay(quiet: bool = False) -> bool:
    """Make the (always mapped, transparent) keyboard window an overlay."""
    if DESKTOP:
        return True  # KWin: the keyboard window refuses focus itself
    if not STATE.overlay_marked:
        if set_keyboard_prop("STEAM_INPUT_FOCUS", "0", quiet) and set_keyboard_prop("STEAM_OVERLAY", "1", quiet):
            STATE.overlay_marked = True
            STATE.input_focus = False
            log("keyboard marked as overlay")
    return STATE.overlay_marked


def keyboard_input_focus(on: bool) -> None:
    if DESKTOP:
        return
    if STATE.input_focus == on or not mark_keyboard_overlay():
        return
    if set_keyboard_prop("STEAM_INPUT_FOCUS", "2" if on else "0"):
        STATE.input_focus = on


def write_firefox_prefs(profile: str, zoom: str, extra: dict) -> None:
    os.makedirs(profile, exist_ok=True)
    prefs = dict(FIREFOX_PREFS, **{"layout.css.devPixelsPerPx": zoom}, **extra)
    lines = [f"user_pref({json.dumps(k)}, {json.dumps(v)});" for k, v in prefs.items()]
    with open(f"{profile}/user.js", "w", encoding="utf-8") as fh:
        fh.write("// Written by barry_launcher_shelld at every start; change other settings in about:config.\n")
        fh.write("\n".join(lines) + "\n")


def running(app: str) -> subprocess.Popen | None:
    proc = STATE.apps.get(app)
    return proc if proc and proc.poll() is None else None


def activate(args: list[str]) -> bool:
    """Bring the first window matching xdotool search ARGS forward: map it
    again, so it is gamescope's most recently mapped window."""
    r = subprocess.run(["xdotool", "search", "--onlyvisible", *args], capture_output=True, text=True)
    wins = r.stdout.split()
    if not wins:
        return False
    r = subprocess.run(["xdotool", "windowunmap", "--sync", wins[0], "windowmap", "--sync", wins[0]],
                       capture_output=True, text=True)
    return r.returncode == 0


def bring_forward(app: str | None) -> bool:
    """Bring an app's window (None: the home screen) forward."""
    spec = APPS.get(app, {}) if app else {}
    proc = running(app) if app else None
    if DESKTOP:
        if app is None:
            return barry_desktop.activate(caption=f"^{HOME_TITLE}$")
        if "flatpak" in spec:
            return barry_desktop.activate(classes=spec.get("classes"))
        if "qml" in spec or "qmlfile" in spec or "main" in spec:
            return barry_desktop.activate(caption=spec["window"])
        return barry_desktop.activate(classes=[f"barry-{app}"])
    if app is None:
        return activate(["--name", f"^{HOME_TITLE}$"])
    if "flatpak" in spec:
        # Its window, or a launch dialog still waiting for an answer.
        return activate(["--classname", spec["window"]]) or activate(["--classname", DIALOG_CLASS])
    if "qml" in spec or "qmlfile" in spec or "main" in spec:
        return activate(["--pid", str(proc.pid), "--name", spec["window"]])
    return activate(["--pid", str(proc.pid), "--classname", "Navigator"])


def go_home() -> None:
    # The home screen slides in (Shell.qml): it sees the new serial, puts
    # itself at the animation's start while still hidden, and says so; then
    # it comes forward. Not waiting long: it comes forward regardless.
    lower_curtain("left for home")
    with STATE.lock:
        STATE.home_serial += 1
        STATE.home_ready.clear()
    STATE.home_ready.wait(HOME_READY_S)
    STATE.set_keyboard(False)
    # The trackpad is a tool, not an app to come back to: leaving it closes
    # it. Their exit lets go of anything held on top (watch).
    for app, spec in APPS.items():
        if "qml" in spec and running(app):
            close(app)
    if not bring_forward(None):
        log("cannot find the home screen window")


def app_env(**extra: str) -> dict:
    env = dict(os.environ, GNOME_ACCESSIBILITY="1", **extra)
    if not DESKTOP:
        env.pop("WAYLAND_DISPLAY", None)  # X11, where gamescope's stacking applies
    env.pop("BARRY_DESKTOP", None)
    return env


def surface_dialogs(proc: subprocess.Popen) -> None:
    """Bring forward the dialogs a Flatpak's launch script opens before the
    app (Signal's asks about its password store on the first start, and
    quits on No): gamescope shows the most recently mapped window, so they
    would wait unseen behind the home screen."""
    shown: set[str] = set()
    deadline = time.monotonic() + DIALOG_WATCH_S
    while proc.poll() is None and time.monotonic() < deadline:
        r = subprocess.run(["xdotool", "search", "--onlyvisible", "--classname", DIALOG_CLASS],
                           capture_output=True, text=True)
        for win in r.stdout.split():
            if win not in shown:
                shown.add(win)
                subprocess.run(["xdotool", "windowunmap", "--sync", win, "windowmap", "--sync", win],
                               capture_output=True)
                log("brought a launch dialog forward")
        time.sleep(0.5)


def app_log(app: str):
    d = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "barry_launcher")
    os.makedirs(d, exist_ok=True)
    return open(os.path.join(d, f"{app}.log"), "w")


def flatpak_installed(ref: str) -> bool:
    return subprocess.run(["flatpak", "info", ref], capture_output=True).returncode == 0


def flatpak_location(ref: str) -> str | None:
    r = subprocess.run(["flatpak", "info", "--show-location", ref], capture_output=True, text=True)
    return r.stdout.strip() or None


def warm_apps() -> None:
    """Read the "warm" apps' files into the page cache, so their first start
    does not wait on the SD card. The kernel drops them again under memory
    pressure."""
    time.sleep(WARM_DELAY_S)
    for app, spec in APPS.items():
        if "warm" not in spec or running(app) or not flatpak_installed(spec["flatpak"]):
            continue
        ref = spec["flatpak"]
        paths = [os.path.expanduser(p) for p in spec["warm"]]
        loc = flatpak_location(ref)
        if loc:
            paths.append(os.path.join(loc, "files"))
        r = subprocess.run(["flatpak", "info", "--show-runtime", ref], capture_output=True, text=True)
        rt = flatpak_location(r.stdout.strip()) if r.stdout.strip() else None
        if rt:
            paths += [os.path.join(rt, "files", d) for d in WARM_RUNTIME_DIRS]
        paths = [p for p in paths if os.path.isdir(p)]
        started = time.monotonic()
        r = subprocess.run(
            ["ionice", "-c", "3", "nice", "-n", "19", "sh", "-c",
             'find "$@" -name "*.noindex" -prune -o -type f -print0 | xargs -0 -r cat | wc -c', "warm", *paths],
            capture_output=True, text=True,
        )
        size = int(r.stdout.strip() or 0)
        log(f"warmed {app}: {size // 1048576} MB in {time.monotonic() - started:.0f} s")


def start_flatpak(app: str, spec: dict) -> None:
    """Install the app from Flathub for this user if needed, then start it."""
    ref = spec["flatpak"]
    try:
        if not flatpak_installed(ref):
            STATE.status[app] = "Installing…"
            log(f"installing {ref} from Flathub")
            subprocess.run(["flatpak", "remote-add", "--user", "--if-not-exists", "flathub", FLATHUB],
                           capture_output=True)
            r = subprocess.run(["flatpak", "install", "--user", "-y", "--noninteractive", "flathub", ref],
                               capture_output=True, text=True)
            if r.returncode != 0:
                log(f"cannot install {ref}: {r.stderr.strip()[-300:]}")
                return
        for path, text in spec.get("seed", {}).items():
            path = os.path.expanduser(path)
            if not os.path.exists(path):
                os.makedirs(os.path.dirname(path), exist_ok=True)
                with open(path, "w", encoding="utf-8") as fh:
                    fh.write(text)
                log(f"wrote {path}")
        raise_curtain(app, "flatpak")
        with app_log(app) as out:
            STATE.apps[app] = subprocess.Popen(
                ["flatpak", "run", ref, *spec.get("desktop_args" if DESKTOP else "args", [])],
                env=app_env(ACCESSIBILITY_ENABLED="1"),
                stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT,
            )
        watch_opening(app, "flatpak", lambda: window_shown(["--classname", spec["window"]]))
        if not DESKTOP:  # KWin shows launch dialogs itself
            threading.Thread(target=surface_dialogs, args=(STATE.apps[app],), daemon=True).start()
        STATE.quiet_until = time.monotonic() + LAUNCH_QUIET_S
        log(f"started {app} (pid {STATE.apps[app].pid})")
    finally:
        STATE.status.pop(app, None)


def launch(app: str) -> tuple[int, dict]:
    keyboard = app == TOP_KEYBOARD
    if keyboard:
        app = TOP_INPUT_APP
        if running(app):
            STATE.set_top_keyboard(True, "keyboard asked for")
    spec = APPS.get(app)
    if spec is None:
        return 404, {"error": f"no app {app!r}"}
    if app in STATE.status:
        return 200, {"ok": True, "running": False}
    proc = running(app)
    if proc:
        STATE.quiet_until = time.monotonic() + SWITCH_QUIET_S
        bring_forward(app)
        return 200, {"ok": True, "running": True}
    if "flatpak" in spec:
        STATE.status[app] = "Starting…"
        threading.Thread(target=start_flatpak, args=(app, spec), daemon=True).start()
        return 200, {"ok": True, "running": False}
    if "main" in spec:  # a user app in QML; a web one is a Firefox app below
        # Its XDG folders inside its data folder: all it saves is there.
        extra = barry_apps.app_env(app)
        data = extra["BARRY_APP_DATA"]
        for d in (data, extra["XDG_CONFIG_HOME"], extra["XDG_DATA_HOME"]):
            os.makedirs(d, exist_ok=True)
        if DESKTOP:
            extra["QT_QPA_PLATFORM"] = "wayland"
        args = ["qml6", APP_HOST_QML, "--", spec["dir"], spec["main"], app, spec["name"], data, "fullscreen"]
        with app_log(app) as out:
            if spec.get("service"):
                # One left by a window that ended unseen goes first.
                barry_apps.stop_service(STATE.services.pop(app, None))
                proc, url, token = barry_apps.start_service(spec["dir"], spec["service"],
                                                            app_env(**barry_apps.app_env(app)), out)
                STATE.services[app] = proc
                args += [url, token]
                log(f"started {app}'s service (pid {proc.pid})")
            raise_curtain(app, "qml")
            STATE.apps[app] = subprocess.Popen(
                args,
                env=app_env(**extra),
                stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT,
            )
        log(f"started {app} {spec['version']} (pid {STATE.apps[app].pid})")
        proc = STATE.apps[app]
        watch_opening(app, "qml", lambda: window_shown(["--pid", str(proc.pid), "--name", spec["window"]]))
        return 200, {"ok": True, "running": False}
    if "qml" in spec or "qmlfile" in spec:
        cmd = (["qml6", TOP_INPUT_QML, "--", spec["qml"]] if "qml" in spec
               else ["qml6", os.path.join(SHELL_DIR, spec["qmlfile"])])
        if keyboard:
            cmd.append("keyboard")  # opens with its keyboard up
        extra = {}
        if DESKTOP and "qml" in spec:
            # The top screen's trackpad and keyboard must never take focus
            # from the top screen's window: a KWin rule (barry_launcher_desktop)
            # says so, so they can be Wayland windows, with proper multitouch.
            cmd.insert(cmd.index("--") + 1, "desktop")
            extra["QT_QPA_PLATFORM"] = "wayland"
        STATE.apps[app] = subprocess.Popen(
            cmd,
            env=app_env(**extra),
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        log(f"started {app} (pid {STATE.apps[app].pid})")
        return 200, {"ok": True, "running": False}
    profile = os.path.join(DATA, spec["profile"])  # a user web app's is a full path already
    zoom = spec["zoom"]
    if DESKTOP:
        zoom = spec.get("desktop_zoom") or str(round(float(zoom) / DESKTOP_SCALE, 3))
    write_firefox_prefs(profile, zoom, spec.get("prefs", {}))
    # Start clean: a session left by a killed instance makes Firefox offer
    # "Open previous tabs?", which a kiosk app cannot act on.
    for leftover in ("sessionstore.jsonlz4", "sessionstore-backups"):
        path = os.path.join(profile, leftover)
        if os.path.isdir(path):
            shutil.rmtree(path, ignore_errors=True)
        elif os.path.exists(path):
            os.remove(path)
    if DESKTOP:
        # Wayland, so KWin hands its text fields to the input method; named
        # so KWin's scripts can tell it from the top screen's Firefox.
        cmd = ["firefox", "--name", f"barry-{app}", "--no-remote", "--profile", profile, *spec["args"]]
        env = app_env(MOZ_ENABLE_WAYLAND="1")
    else:
        cmd = ["firefox", "--no-remote", "--profile", profile, *spec["args"]]
        # Firefox draws through Vulkan; gamescope's WSI layer then gives its
        # window a gamescope swapchain, and a resize (the keyboard pushing it
        # up) can make a second one: gamescope drops the connection and the
        # window freezes. Plain Xwayland presents it instead.
        env = app_env(MOZ_USE_XINPUT2="1", MOZ_ENABLE_WAYLAND="0", DISABLE_GAMESCOPE_WSI="1")
    raise_curtain(app, "firefox")
    STATE.apps[app] = subprocess.Popen(
        cmd,
        env=env,
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    STATE.quiet_until = time.monotonic() + LAUNCH_QUIET_S
    log(f"started {app} (pid {STATE.apps[app].pid})")
    proc = STATE.apps[app]
    watch_opening(app, "firefox", lambda: page_shown(proc.pid))
    return 200, {"ok": True, "running": False}


def raise_curtain(app: str, kind: str) -> None:
    """Cover the screen while an app opens (Keyboard.qml draws it, over
    everything, and takes the touches meanwhile). Game Mode only: under
    KWin, windows open without that flicker."""
    if DESKTOP:
        return
    STATE.curtain_app = app
    STATE.curtain = APPS[app]["name"]
    STATE.curtain_shows = time.monotonic() + CURTAIN[kind]["delay"]
    keyboard_input_focus(True)


def lower_curtain(why: str) -> None:
    if STATE.curtain_app is None:
        return
    log(f"{STATE.curtain_app} {why}: cover off")
    STATE.curtain_app = None
    STATE.curtain = ""
    keyboard_input_focus(STATE.keyboard()["visible"])


def watch_opening(app: str, kind: str, ready) -> None:
    """Take the cover off app once ready() and its first paint (see
    watch_curtain)."""
    if STATE.curtain_app == app:
        GLib.timeout_add(CURTAIN_POLL_MS, watch_curtain, app, kind, ready, STATE.apps[app], time.monotonic(),
                         [None])


def window_shown(search: list[str]) -> bool:
    """Is a window matching xdotool search ARGS mapped?"""
    r = subprocess.run(["xdotool", "search", "--onlyvisible", *search], capture_output=True, text=True)
    return bool(r.stdout.split())


def page_shown(pid: int) -> bool:
    """Has the Firefox with this pid a web page (not about:) in its window?
    Still loading counts: WhatsApp draws its own loading screen at about 3 s,
    and stays "busy" until about 13 s."""
    desk = Atspi.get_desktop(0)
    for i in range(desk.get_child_count()):
        fx = desk.get_child_at_index(i)
        if fx is None or fx.get_process_id() != pid:
            continue
        # This side keeps the app's tree as it last saw it (no listener for
        # its changes here): a Firefox just started looked empty for good.
        fx.clear_cache()
        todo = [(fx, 0)]
        while todo:
            acc, depth = todo.pop()
            if acc.get_role() == Atspi.Role.DOCUMENT_WEB:
                url = (acc.get_document_attributes() or {}).get("DocURL", "")
                if url.startswith("http") and acc.get_state_set().contains(Atspi.StateType.SHOWING):
                    return True
                continue  # not inside a page
            # application > frame > panel > scroll pane > internal frame >
            # document web; not into the toolbars and their menus.
            if depth < 5 and acc.get_role() not in (Atspi.Role.TOOL_BAR, Atspi.Role.MENU, Atspi.Role.MENU_BAR):
                for j in range(acc.get_child_count()):
                    c = acc.get_child_at_index(j)
                    if c is not None:
                        todo.append((c, depth + 1))
    return False


def watch_curtain(app: str, kind: str, ready, proc: subprocess.Popen, started: float, ready_at: list) -> bool:
    """Every CURTAIN_POLL_MS while app opens: the cover comes off once it is
    ready and has had time to paint, if it quits, if it asks something in a
    launch dialog (Signal's password store), or at the latest after its
    kind's "max"."""
    if STATE.curtain_app != app:
        return False  # off already (home, another app)
    if proc.poll() is not None:
        lower_curtain("quit while opening")
        return False
    now = time.monotonic()
    limit = CURTAIN[kind]["max"]
    if now - started > limit:
        lower_curtain(f"not ready after {limit:.0f} s")
        return False
    if kind == "flatpak" and window_shown(["--classname", DIALOG_CLASS]):
        lower_curtain("asks something")
        return False
    if ready_at[0] is None:
        try:
            if ready():
                ready_at[0] = now
        except GLib.Error as err:
            log(f"{app}: cannot tell whether it is ready: {err}")
    elif now - ready_at[0] >= CURTAIN[kind]["paint"]:
        lower_curtain(f"ready in {ready_at[0] - started:.1f} s")
        return False
    return True


def close(app: str) -> tuple[int, dict]:
    if app == TOP_KEYBOARD:
        app = TOP_INPUT_APP
    if app not in APPS:
        return 404, {"error": f"no app {app!r}"}
    proc = running(app)
    if proc:
        if "flatpak" in APPS[app]:
            # The app runs in flatpak's sandbox, not as our child.
            subprocess.run(["flatpak", "kill", APPS[app]["flatpak"]], capture_output=True)
        else:
            proc.terminate()
        log(f"closing {app}")
    return 200, {"ok": True}


def check_app(body: dict) -> tuple[int, dict]:
    """Would the archive install, and what is in it (the plugin asks
    before installing an app with a service)."""
    path = body.get("path")
    if not isinstance(path, str) or not os.path.isabs(path):
        return 400, {"ok": False, "error": "path must be the archive's full path"}
    try:
        m = barry_apps.check(path)
    except barry_apps.AppError as err:
        return 400, {"ok": False, "error": str(err)}
    except OSError as err:
        return 400, {"ok": False, "error": f"cannot read it: {err.strerror or err}"}
    if m["id"] in BUILTIN_APPS:
        return 400, {"ok": False, "error": f'"{m["id"]}" is one of Barry Launcher\'s own apps'}
    return 200, {"ok": True, "app": m}


def install_app(body: dict) -> tuple[int, dict]:
    path = body.get("path")
    if not isinstance(path, str) or not os.path.isabs(path):
        return 400, {"ok": False, "error": "path must be the archive's full path"}
    try:
        m = barry_apps.install(path, reserved=set(BUILTIN_APPS))
    except barry_apps.AppError as err:
        log(f"cannot install {path}: {err}")
        return 400, {"ok": False, "error": str(err)}
    except OSError as err:
        log(f"cannot install {path}: {err}")
        return 400, {"ok": False, "error": f"cannot install: {err.strerror or err}"}
    # A running copy is the old version: it closes, to start anew.
    if running(m["id"]):
        close(m["id"])
    refresh_user_apps(force=True)
    log(f"{'updated' if m['updated'] else 'installed'} {m['id']} {m['version']}")
    return 200, {"ok": True, "app": m}


def stop(app: str, wait_s: float = 3.0) -> None:
    """Close an app and wait until it has ended: one that saves as it
    quits could otherwise write into a folder just removed."""
    proc = running(app)
    if proc:
        close(app)
        try:
            proc.wait(wait_s)
        except subprocess.TimeoutExpired:
            log(f"{app} did not quit; killing it")
            proc.kill()
            proc.wait(2)
    barry_apps.stop_service(STATE.services.pop(app, None), wait_s)


def remove_app(body: dict) -> tuple[int, dict]:
    app = str(body.get("app", ""))
    if app in BUILTIN_APPS:
        return 400, {"ok": False, "error": f"{APPS[app]['name']} is part of Barry Launcher"}
    stop(app)
    try:
        removed = barry_apps.remove(app, keep_data=bool(body.get("keepData")))
    except OSError as err:
        return 400, {"ok": False, "error": f"cannot remove: {err.strerror or err}"}
    if not removed:
        return 404, {"ok": False, "error": f"no app {app!r}"}
    drop_game_links(app)
    refresh_user_apps(force=True)
    log(f"removed {app}")
    return 200, {"ok": True}


# Apps that open with games: Steam's appid (a non-Steam game's shortcut id)
# -> a Barry Launcher app. The Barry Launcher plugin sets them and reports
# games starting and stopping; an app opened for a game closes with it
# when its link says so (and only if it was opened for it).
GAME_LINKS = os.path.join(os.path.dirname(HOME_LAYOUT), "game-links.json")


def game_links() -> list[dict]:
    try:
        with open(GAME_LINKS, encoding="utf-8") as fh:
            links = json.load(fh).get("links", [])
    except (OSError, ValueError, AttributeError):
        return []
    return [l for l in links if isinstance(l, dict) and str(l.get("game", "")).isdigit()
            and l.get("app") in APPS]


def game_links_json() -> dict:
    return {"links": [dict(l, appName=APPS[l["app"]]["name"]) for l in game_links()]}


def set_game_links(body: dict) -> tuple[int, dict]:
    links = body.get("links")
    if not isinstance(links, list):
        return 400, {"error": "links is a list"}
    clean = {}
    for l in links:
        if not isinstance(l, dict):
            continue
        game, app = str(l.get("game", "")), l.get("app")
        if not game.isdigit() or app not in APPS:
            return 400, {"error": f"no app {app!r}" if game.isdigit() else "game is a Steam appid"}
        clean[game] = {"game": game, "gameName": str(l.get("gameName", ""))[:100], "app": app,
                       "close": bool(l.get("close", True))}  # one app per game: the last wins
    os.makedirs(os.path.dirname(GAME_LINKS), exist_ok=True)
    with open(GAME_LINKS + ".tmp", "w", encoding="utf-8") as fh:
        json.dump({"links": list(clean.values())}, fh, indent=1)
        fh.write("\n")
    os.replace(GAME_LINKS + ".tmp", GAME_LINKS)
    return 200, game_links_json()


def drop_game_links(app: str) -> None:
    """An app removed: no game opens it any more."""
    links = game_links()
    kept = [l for l in links if l["app"] != app]
    if len(kept) != len(links):
        set_game_links({"links": kept})


def game_event(body: dict) -> tuple[int, dict]:
    game = str(body.get("game", ""))
    link = next((l for l in game_links() if l["game"] == game), None)
    if not game.isdigit() or link is None:
        return 200, {"ok": True, "app": None}
    app = link["app"]
    if body.get("running"):
        opened = not running(app)
        log(f"game {game} ({link['gameName'] or '?'}) started: {app}")
        code, r = launch(app)
        if code == 200 and opened:
            STATE.opened_for_game[game] = app
        return code, dict(r, app=app)
    # Stopped: close the app only if this game opened it.
    if STATE.opened_for_game.pop(game, None) == app and link["close"] and running(app):
        log(f"game {game} ({link['gameName'] or '?'}) stopped: closing {app}")
        close(app)
    return 200, {"ok": True, "app": app}


def setup_bundled_apps() -> None:
    """Install the apps that come with Barry Launcher (barry_apps), and move
    the old built-in Dino's place on the home screen and best score to the
    Dino app."""
    for app in barry_apps.install_bundled():
        log(f"installed {app}, which comes with Barry Launcher")
    try:
        with open(HOME_LAYOUT, encoding="utf-8") as fh:
            saved = json.load(fh)
        if isinstance(saved, dict) and OLD_DINO in saved.get("order", []):
            saved["order"] = [NEW_DINO if a == OLD_DINO else a for a in saved["order"]]
            saved["hidden"] = [NEW_DINO if a == OLD_DINO else a for a in saved.get("hidden", [])]
            with open(HOME_LAYOUT + ".tmp", "w", encoding="utf-8") as fh:
                json.dump(saved, fh, indent=1)
                fh.write("\n")
            os.replace(HOME_LAYOUT + ".tmp", HOME_LAYOUT)
            log("moved Dino's place on the home screen to the Dino app")
    except (OSError, ValueError):
        pass
    # The old Dino kept its best score in qml6's own settings ([dino] best=N).
    ini = os.path.join(barry_apps.APP_DATA_DIR, NEW_DINO, "dino.ini")
    if os.path.isdir(os.path.dirname(ini)) and not os.path.exists(ini):
        for conf in glob.glob(f"{HOME}/.config/*.conf") + glob.glob(f"{HOME}/.config/*/*.conf"):
            try:
                with open(conf, encoding="utf-8") as fh:
                    text = fh.read()
            except (OSError, UnicodeDecodeError):
                continue
            section = text.split("[dino]", 1)[1].split("\n[", 1)[0] if "[dino]" in text else ""
            best = next((line.split("=", 1)[1].strip() for line in section.splitlines()
                         if line.startswith("best=")), None)
            if best and best.isdigit():
                with open(ini, "w", encoding="utf-8") as fh:
                    fh.write(f"[dino]\nbest={best}\n")
                # And out of the shared file: nothing of the old Dino left.
                before, _, rest = text.partition("[dino]")
                after = rest.split("\n[", 1)
                left = before.rstrip("\n") + ("\n\n[" + after[1] if len(after) > 1 else "\n")
                if left.strip():
                    with open(conf, "w", encoding="utf-8") as fh:
                        fh.write(left)
                else:
                    os.remove(conf)
                log(f"moved Dino's best score ({best}) from {conf}")
                break


def release_top_input() -> None:
    """Let go of anything the trackpad or keyboard held on the top screen,
    and (Desktop Mode) give KWin the bottom touchscreen back at once."""
    for path, body in (("/release", b"{}"), ("/trackpad", b'{"active": false}')):
        req = urllib.request.Request(f"{INPUTD}{path}", body, {"Content-Type": "application/json"})
        try:
            urllib.request.urlopen(req, timeout=1).close()
        except OSError:
            pass


TYPE_LOCK = threading.Lock()  # one typing request at a time, in the order they came


def caret_holder(acc):
    """The object that holds the caret's text. A rich text field (Signal's,
    Discord's: Chromium contenteditable) reports focus on its outer box,
    whose text is one placeholder per paragraph; the caret's text is in the
    paragraph under it, and in that paragraph's text under that."""
    for _ in range(8):
        for i in range(min(acc.get_child_count(), 64)):
            child = acc.get_child_at_index(i)
            if child is not None and child.get_text_iface() is not None \
                    and Atspi.Text.get_caret_offset(child) >= 0:
                acc = child
                break
        else:
            return acc
    return acc


def text_before_caret(n: int) -> str | None:
    """Up to n characters before the caret in the focused field, read over
    AT-SPI on the main loop; None if they cannot be read."""
    acc = STATE.text_acc
    if acc is None:
        return None
    result: dict = {}
    done = threading.Event()

    def read() -> bool:
        try:
            holder = caret_holder(acc)
            offset = Atspi.Text.get_caret_offset(holder)
            if offset >= 0:
                result["text"] = Atspi.Text.get_text(holder, max(0, offset - n), offset)
        except Exception:  # noqa: BLE001 - the field may be gone
            pass
        done.set()
        return False

    GLib.idle_add(read)
    return result.get("text") if done.wait(0.5) else None


def ends_with_word(word: str) -> bool:
    """The text before the caret ends with word, as a whole word."""
    im = STATE.im
    if im is not None and im.active:
        full = im.before_cursor()
        before = None if full is None else full[-(len(word) + 1):]
    else:
        before = text_before_caret(len(word) + 1)
    if before is None or not before.endswith(word):
        return False
    return len(before) == len(word) or not before[-len(word) - 1].isalnum()


def type_input(body: dict) -> tuple[int, dict]:
    # "back": backspaces first, in the same request, so a glided word can be
    # swapped for another without the two racing.
    # "expect": only if the field's text before the caret ends with it
    # (checked over AT-SPI), else nothing is typed.
    # "correct": the word just typed; autocorrect swaps it for the word
    # meant before typing the rest, if the field really ends with it.
    # "keep": a word the user undid a correction of; never corrected again.
    back = body.get("back", 0)
    if not isinstance(back, int) or not 0 <= back <= 100:
        return 400, {"error": "back must be 0-100"}
    if "combo" in body:
        return type_combo(body["combo"])
    with TYPE_LOCK:
        cmds = []
        reply: dict = {"ok": True}
        expect = body.get("expect")
        if isinstance(expect, str) and expect and not ends_with_word(expect):
            return 409, {"error": "the field does not end with the expected text"}
        if isinstance(body.get("keep"), str):
            with GLIDE["lock"]:
                corrector().keep(body["keep"])
        word = body.get("correct")
        if isinstance(word, str) and word and not back:
            with GLIDE["lock"]:
                fixed = corrector().correct(word)
            if fixed and ends_with_word(word):
                cmds.append(["xdotool", "key", "--delay", "0", "--repeat", str(len(word)), "BackSpace"])
                cmds.append(["xdotool", "type", "--delay", "0", "--", fixed])
                reply["corrected"] = fixed
                log(f"autocorrect: {word} -> {fixed}")
        if back:
            cmds.append(["xdotool", "key", "--delay", "0", "--repeat", str(back), "BackSpace"])
        if isinstance(body.get("text"), str) and body["text"]:
            cmds.append(["xdotool", "type", "--delay", "0", "--", body["text"]])
        elif body.get("key") in KEYS:
            cmds.append(["xdotool", "key", "--", body["key"]])
        elif not back and "keep" not in body:
            return 400, {"error": "need text, a known key or back"}
        im = STATE.im
        if im is not None and im.active:
            # Desktop Mode: into the active field through KWin's input method.
            return type_through_im(im, cmds, reply)
        for cmd in cmds:
            r = subprocess.run(cmd, capture_output=True, text=True)
            if r.returncode != 0:
                return 500, {"error": r.stderr.strip()}
        return 200, reply


def type_combo(keys) -> tuple[int, dict]:
    """Modifiers and a key (["ctrl", "c"]): xdotool in Game Mode; in Desktop
    Mode barry_launcher_inputd's keyboard, a real one to KWin, so the
    focused window gets the modifiers."""
    if not (isinstance(keys, list) and 1 <= len(keys) <= 4 and all(isinstance(k, str) for k in keys)
            and all(k in MODIFIERS for k in keys[:-1])):
        return 400, {"error": "combo: modifiers, then a key"}
    last = keys[-1]
    if not (last in KEYS or (len(last) == 1 and (last.isalnum() or last in XDO_SYMBOLS))):
        return 400, {"error": f"combo: no key {last!r}"}
    with TYPE_LOCK:
        if DESKTOP:
            req = urllib.request.Request(f"{INPUTD}/key", json.dumps({"combo": keys}).encode(),
                                         {"Content-Type": "application/json"})
            try:
                urllib.request.urlopen(req, timeout=2).close()
            except OSError as err:
                return 500, {"error": f"barry_launcher_inputd: {err}"}
            return 200, {"ok": True}
        name = "+".join(keys[:-1] + [XDO_SYMBOLS.get(last, last)])
        r = subprocess.run(["xdotool", "key", "--", name], capture_output=True, text=True)
        if r.returncode != 0:
            return 500, {"error": r.stderr.strip()}
        return 200, {"ok": True}


def type_through_im(im, cmds: list, reply: dict) -> tuple[int, dict]:
    """type_input's xdotool commands, sent through barry_launcher_imd."""
    for cmd in cmds:
        if cmd[1] == "type":
            ok = im.commit(cmd[-1])
        elif "--repeat" in cmd:
            ok = im.back(int(cmd[cmd.index("--repeat") + 1]))
        else:
            ok = im.key(cmd[-1])
        if not ok:
            return 500, {"error": "the input method went away"}
    return 200, reply


GLIDE = {"decoder": None, "corrector": None, "lock": threading.Lock()}


def decoder() -> barry_glide.Decoder:
    """The dictionary, loaded on first use (call with GLIDE["lock"] held)."""
    if GLIDE["decoder"] is None:
        GLIDE["decoder"] = barry_glide.Decoder(GLIDE_WORDS)
    return GLIDE["decoder"]


def corrector() -> barry_glide.Corrector:
    if GLIDE["corrector"] is None:
        GLIDE["corrector"] = barry_glide.Corrector(decoder(), os.path.join(DATA, "personal-words.txt"))
    return GLIDE["corrector"]


def load_dictionary() -> None:
    with GLIDE["lock"]:
        corrector()


def suggest(body: dict) -> tuple[int, dict]:
    """The strip's words for the word being typed: near words, completions."""
    prefix = body.get("prefix")
    if not isinstance(prefix, str) or len(prefix) > 40:
        return 400, {"error": "need prefix"}
    with GLIDE["lock"]:
        return 200, {"words": corrector().suggest(prefix)}


def glide(body: dict) -> tuple[int, dict]:
    """The likeliest words for a glide over the keyboard (barry_glide)."""
    path, keys, size = body.get("path"), body.get("keys"), body.get("size")
    point = lambda p: (isinstance(p, list) and len(p) == 2
                       and all(isinstance(v, (int, float)) for v in p))
    if not (isinstance(path, list) and 2 <= len(path) <= 4000 and all(map(point, path))
            and isinstance(keys, dict) and all(isinstance(k, str) and point(v) for k, v in keys.items())
            and isinstance(size, (int, float)) and size > 0):
        return 400, {"error": "need path, keys and size"}
    with GLIDE["lock"]:
        return 200, {"words": decoder().decode(path, keys, float(size))}


class Handler(BaseHTTPRequestHandler):
    def _json(self, code: int, obj) -> None:
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _body(self) -> dict:
        try:
            n = int(self.headers.get("Content-Length", "0"))
            data = json.loads(self.rfile.read(n) if 0 < n <= 4096 else b"{}")
            return data if isinstance(data, dict) else {}
        except ValueError:
            return {}

    def do_GET(self) -> None:
        path, _, query = self.path.partition("?")
        if path == "/home":
            self._json(200, {"serial": STATE.home_serial})
        elif path == "/keyboard":
            # Keyboard.qml polls with its panel height (?h=).
            h = urllib.parse.parse_qs(query).get("h", [""])[0]
            if h.isdigit() and int(h) != STATE.keyboard_height:
                STATE.keyboard_height = int(h)
                apply_inset()
            curtain = STATE.curtain if time.monotonic() >= STATE.curtain_shows else ""
            self._json(200, dict(STATE.keyboard(), curtain=curtain))
        elif path == "/top-keyboard":
            with STATE.lock:
                self._json(200, dict(STATE.top_keyboard))
        elif path == "/apps":
            refresh_user_apps()
            order, hidden = home_layout()
            self._json(200, {name: {"running": running(name) is not None,
                                    "status": STATE.status.get(name, ""),
                                    "name": APPS[name]["name"], "icon": APPS[name]["icon"],
                                    "closable": APPS[name].get("closable", True),
                                    "user": APPS[name].get("user", False),
                                    "hidden": name in hidden, "pos": order.index(name)}
                             for name in APPS})
        elif path == "/layout":
            refresh_user_apps()
            self._json(200, layout_json())
        elif path == "/game-links":
            refresh_user_apps()
            self._json(200, game_links_json())
        else:
            self._json(404, {"error": "not found"})

    def _local(self) -> bool:
        return (self.headers.get("Host", "") in (f"127.0.0.1:{PORT}", f"localhost:{PORT}")
                and self.headers.get("Origin") is None
                and self.headers.get("Content-Type", "").split(";")[0].strip() == "application/json")

    def do_POST(self) -> None:
        path = self.path.split("?", 1)[0]
        body = self._body()
        if not self._local():
            self._json(403, {"error": "local JSON requests only"})
        elif path == "/launch":
            self._json(*launch(str(body.get("app", ""))))
        elif path == "/close":
            self._json(*close(str(body.get("app", ""))))
        elif path == "/home":
            go_home()
            self._json(200, {"ok": True})
        elif path == "/home-ready":
            if body.get("serial") == STATE.home_serial:
                STATE.home_ready.set()
            self._json(200, {"ok": True})
        elif path == "/keyboard":
            if not body.get("visible") and STATE.keyboard()["visible"]:
                STATE.hidden_by_hand = time.monotonic()
            STATE.set_keyboard(bool(body.get("visible")))
            self._json(200, STATE.keyboard())
        elif path == "/type":
            self._json(*type_input(body))
        elif path == "/glide":
            self._json(*glide(body))
        elif path == "/suggest":
            self._json(*suggest(body))
        elif path == "/layout":
            self._json(*set_layout(body))
        elif path == "/apps/check":
            self._json(*check_app(body))
        elif path == "/apps/install":
            self._json(*install_app(body))
        elif path == "/apps/remove":
            self._json(*remove_app(body))
        elif path == "/game-links":
            self._json(*set_game_links(body))
        elif path == "/game-event":
            self._json(*game_event(body))
        else:
            self._json(404, {"error": "not found"})

    def log_message(self, *_args) -> None:
        pass


def enable_accessibility() -> None:
    """Tell apps an assistive technology is listening (like GNOME's switch)."""
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        bus.call_sync(
            "org.a11y.Bus", "/org/a11y/bus", "org.freedesktop.DBus.Properties", "Set",
            GLib.Variant("(ssv)", ("org.a11y.Status", "IsEnabled", GLib.Variant("b", True))),
            None, Gio.DBusCallFlags.NONE, 2000, None,
        )
    except GLib.Error as err:
        log(f"cannot enable accessibility: {err.message}")


def watch_touches() -> None:
    """Note when a finger touches the bottom screen. Reading an evdev node
    does not take its events away from gamescope."""
    for name_file in glob.glob("/sys/class/input/event*/device/name"):
        try:
            with open(name_file, encoding="utf-8") as fh:
                if fh.read().strip() != TOUCH_NAME:
                    continue
        except OSError:
            continue
        dev = "/dev/input/" + name_file.split("/")[4]
        try:
            fd = os.open(dev, os.O_RDONLY)
        except OSError as err:
            log(f"cannot read {dev} ({TOUCH_NAME}): {err}; the keyboard follows focus alone")
            return
        STATE.last_touch = 0.0
        log(f"watching touches on {dev}")
        # Per slot, as the kernel keeps them: a new contact repeats no
        # coordinate that has not changed.
        slot = 0
        pos: dict[int, list] = {}
        down: set[int] = set()
        lead = None  # the slot of the touch's first finger
        multi = False  # a second finger joined: neither tap nor swipe
        start = None  # the first finger's first position
        started_at = 0.0
        with os.fdopen(fd, "rb", buffering=0) as fh:
            while True:
                data = fh.read(INPUT_EVENT.size)
                if len(data) < INPUT_EVENT.size:
                    return
                _, _, etype, code, value = INPUT_EVENT.unpack(data)
                if (etype == EV_KEY and code == BTN_TOUCH) or (etype == EV_ABS and code == ABS_MT_TRACKING_ID):
                    STATE.last_touch = time.monotonic()
                if etype == EV_SYN:
                    p = pos.get(lead)
                    if lead in down and start is None and p and None not in p:
                        start, started_at = tuple(p), time.monotonic()
                        STATE.touch_at = raw_to_screen(*start)
                    continue
                if etype != EV_ABS:
                    continue
                if code == ABS_MT_SLOT:
                    slot = value
                elif code == ABS_MT_TRACKING_ID:
                    if value >= 0:
                        if not down:
                            lead, multi, start = slot, False, None
                            STATE.touch_began = time.monotonic()
                        else:
                            multi = True
                        down.add(slot)
                    else:
                        down.discard(slot)
                        if not down:
                            end = pos.get(lead)
                            if not multi and start and end and None not in end:
                                touch_ended(start, tuple(end), time.monotonic() - started_at)
                            start = None
                elif code in (ABS_MT_POSITION_X, ABS_MT_POSITION_Y):
                    pos.setdefault(slot, [None, None])[code - ABS_MT_POSITION_X] = value
    log(f"no {TOUCH_NAME} input device; the keyboard follows focus alone")


def raw_to_screen(raw_x: int, raw_y: int) -> tuple[int, int]:
    """The panel is portrait and turned right: its y runs left to right on
    screen, its x bottom to top."""
    screen_h = int(os.environ.get("THOR_BOTTOM_HEIGHT", "1080"))
    return raw_y, screen_h - 1 - raw_x


def touch_ended(start: tuple, end: tuple, seconds: float) -> None:
    """A one-finger touch lifted: a tap, or a swipe up from the bottom edge."""
    if abs(end[0] - start[0]) + abs(end[1] - start[1]) < TAP_SLOP:
        GLib.idle_add(on_tap, *end)
        return
    # Raw x runs bottom to top on screen (see on_tap).
    screen_h = int(os.environ.get("THOR_BOTTOM_HEIGHT", "1080"))
    start_y, end_y = screen_h - 1 - start[0], screen_h - 1 - end[0]
    if start_y >= screen_h - HOME_SWIPE_EDGE and start_y - end_y >= HOME_SWIPE_MIN and seconds <= HOME_SWIPE_S:
        GLib.idle_add(on_home_swipe)


def on_home_swipe() -> bool:
    log("swipe up from the bottom edge: home")
    go_home()
    return False


def text_field(acc) -> tuple[bool, bool]:
    """(editable, in the lower half of the screen) for an accessible."""
    states = acc.get_state_set()
    editable = states.contains(Atspi.StateType.EDITABLE) and not states.contains(Atspi.StateType.READ_ONLY)
    top = False
    if editable:
        ext = acc.get_extents(Atspi.CoordType.SCREEN)
        screen_h = int(os.environ.get("THOR_BOTTOM_HEIGHT", "1080"))
        top = ext.y + ext.height / 2 > screen_h * 0.5
    return editable, top


def on_this_screen(acc) -> bool:
    """Game Mode: the accessibility bus is the whole session's, so a field
    in a top-screen app (an emulator's text dialog, say) comes by too, and a
    finger typing on the bottom screen then made it look tapped. Only apps on
    this screen's X display count; one whose display cannot be read (an
    app's bus proxy) does."""
    if DESKTOP:
        return True
    try:
        pid = acc.get_process_id()
        with open(f"/proc/{pid}/environ", "rb") as fh:
            env = fh.read().split(b"\0")
    except (GLib.Error, OSError):
        return True
    for var in env:
        if var.startswith(b"DISPLAY="):
            return var[8:].decode(errors="replace") == os.environ.get("DISPLAY", "")
    return True


def touched_lately() -> bool:
    return STATE.last_touch is None or time.monotonic() - STATE.last_touch < TOUCH_S


def show_for_text(top: bool, why: str) -> None:
    began = STATE.touch_began
    if began is not None and began < STATE.hidden_by_hand:
        # The touch that put the keyboard away (its ⌄ key, over a field the
        # keyboard covers, say) is no tap on that field, and the caret
        # moves and focus changes it brings are not either: only a new
        # touch brings the keyboard back.
        log(f"{why} from the touch that hid the keyboard: no keyboard")
        return
    if time.monotonic() < STATE.quiet_until:
        log(f"{why} while an app opens: no keyboard")
        return
    if not touched_lately():
        log(f"{why} without a touch: no keyboard")
        return
    if not DESKTOP and running(TOP_INPUT_APP):
        # The Trackpad app fills the screen: no field of ours is in sight,
        # and this keyboard would squeeze that app above it.
        log(f"{why} under the top screen's trackpad: no keyboard")
        return
    if not STATE.keyboard()["visible"]:
        log(f"{why}{' (lower half)' if top else ''}: keyboard")
    # Always at the bottom: the app moves up above it (apply_inset).
    STATE.set_keyboard(True, False)
    for ms in REVEAL_MS:
        GLib.timeout_add(ms, reveal_field)


def finger_on(acc) -> bool:
    """Did the latest touch come down on this field? (True when there is no
    telling: no touchscreen, or no position yet.) An app moving focus by
    itself right after a tap elsewhere (WhatsApp, to its message box, after
    a tap on a chat) is no tap on the field."""
    at = STATE.touch_at
    if at is None:
        return True
    try:
        ext = acc.get_extents(Atspi.CoordType.SCREEN)
    except GLib.Error:
        return True
    if ext.width <= 0 or ext.height <= 0:
        return True
    x, y = at
    return (ext.x - FIELD_SLOP <= x < ext.x + ext.width + FIELD_SLOP
            and ext.y - FIELD_SLOP <= y < ext.y + ext.height + FIELD_SLOP)


def address_bar(acc) -> bool:
    """A field of the Firefox app's own window (its address bar), not of a
    page. Firefox's home page search box is no field: a tap on it hands
    focus to the address bar, and so does the new-tab button."""
    try:
        with open(f"/proc/{acc.get_process_id()}/cmdline", "rb") as fh:
            args = fh.read().decode(errors="replace").split("\0")
        node = acc.get_parent()
        while node is not None:
            if node.get_role() == Atspi.Role.DOCUMENT_WEB:
                return False
            node = node.get_parent()
    except (GLib.Error, OSError):
        return False
    profile = os.path.join(DATA, APPS["browser"]["profile"])
    return "--kiosk" not in args and any(a == profile for a in args)


def finger_report(acc) -> str:
    """Where the touch and the field were (positions only), for the log."""
    try:
        ext = acc.get_extents(Atspi.CoordType.SCREEN)
        return f" (touch {STATE.touch_at}, field {ext.x},{ext.y} {ext.width}x{ext.height})"
    except GLib.Error:
        return ""


def reveal_field() -> bool:
    """The keyboard pushed the app up, but the focused field can still be
    under it: an app (WhatsApp Web) that will not lay itself out shorter
    than some height is cut off at the bottom instead. Scroll the field's
    bar (the small box around it, with its buttons) into view, just above
    the keyboard."""
    acc = STATE.text_acc
    if acc is None or not STATE.keyboard()["visible"] or DESKTOP:
        return False
    screen_h = int(os.environ.get("THOR_BOTTOM_HEIGHT", "1080"))
    above = screen_h - STATE.keyboard_height
    try:
        if not acc.get_state_set().contains(Atspi.StateType.FOCUSED):
            return False
        ext = acc.get_extents(Atspi.CoordType.SCREEN)
        if ext.height <= 0 or ext.y + ext.height <= above:
            return False  # in sight
        bar = acc
        parent = acc.get_parent()
        while parent is not None:
            pe = parent.get_extents(Atspi.CoordType.SCREEN)
            if pe.height > REVEAL_ROW_MAX or pe.height <= 0:
                break
            bar, parent = parent, parent.get_parent()
        if bar.scroll_to(Atspi.ScrollType.BOTTOM_EDGE):
            log("the focused field was under the keyboard: scrolled into view")
    except GLib.Error:
        pass
    return False


def im_decides() -> bool:
    """Desktop Mode with barry_launcher_imd: KWin says which field is active."""
    return STATE.im is not None and STATE.im.connected


def on_focus(event) -> None:
    if im_decides():
        return
    if event.detail1 != 1:
        return  # the next focus gain decides
    if not on_this_screen(event.source):
        top_text_focus(event.source, "top-screen text focus in")
        return
    try:
        editable, top = text_field(event.source)
    except GLib.Error:
        return
    if editable:
        STATE.text_acc = event.source
        why = "text focus in"
        if not STATE.keyboard()["visible"] and not finger_on(event.source):
            if not address_bar(event.source):
                log(f"text focus in, away from the finger{finger_report(event.source)}: no keyboard")
                return
            why = "text focus in the address bar"
        show_for_text(top, why)
        return
    STATE.text_acc = None
    if STATE.keyboard()["visible"]:
        GLib.timeout_add(FOCUS_OUT_HIDE_MS, hide_after_focus_out)


def hide_after_focus_out() -> bool:
    """Focus left the field: hide the keyboard, unless a field took focus
    since. Signal moves focus out of its message box and back after Send."""
    if STATE.text_acc is None and STATE.keyboard()["visible"]:
        log("text focus out")
        STATE.set_keyboard(False)
    return False


def top_text_focus(acc, why: str) -> None:
    """Game Mode: a click on a text field on the top screen brings up the
    Trackpad app's keyboard. Only a click: games and apps focus and move
    carets by themselves too. Focus leaving a field does not put it away,
    since typing can move focus (a list of suggestions, say): the ⌄ key
    does."""
    if DESKTOP or not running(TOP_INPUT_APP):
        return
    if STATE.top_keyboard["visible"] and why.startswith("caret"):
        return  # typing moves the caret all the time
    last = STATE.last_top_click
    if last is None or time.monotonic() - last >= TOP_CLICK_S:
        return
    try:
        editable, _ = text_field(acc)
    except GLib.Error:
        return
    if editable:
        STATE.set_top_keyboard(True, why)


def on_caret(event) -> None:
    """A tap in a field that already has focus moves only its caret."""
    if im_decides() or STATE.keyboard()["visible"]:
        return
    try:
        acc = event.source
        if not acc.get_state_set().contains(Atspi.StateType.FOCUSED):
            return
        if not on_this_screen(acc):
            top_text_focus(acc, "caret moved in a top-screen field")
            return
        editable, top = text_field(acc)
    except GLib.Error:
        return
    if editable:
        STATE.text_acc = acc
    if editable and touched_lately() and finger_on(acc):  # apps move their own carets all the time
        show_for_text(top, "caret moved in a focused field")


def on_tap(raw_x: int, raw_y: int) -> bool:
    """A one-finger tap ended: on the focused field with the keyboard
    hidden (by hand, say), show it again."""
    acc = STATE.text_acc
    if im_decides() or acc is None or STATE.keyboard()["visible"]:
        return False
    sx, sy = raw_to_screen(raw_x, raw_y)
    try:
        if not acc.get_state_set().contains(Atspi.StateType.FOCUSED):
            return False
        editable, top = text_field(acc)
        ext = acc.get_extents(Atspi.CoordType.SCREEN)
    except GLib.Error:
        return False
    if editable and ext.x <= sx < ext.x + ext.width and ext.y <= sy < ext.y + ext.height:
        show_for_text(top, "tap on the focused field")
    return False


# Timing log, to tell a click on a field from an app focusing one by itself
# (no text, only times and caret offsets).
TIMING = os.environ.get("BARRY_TIMING") == "1"
IM_HIDE_DELAY_MS = 200  # a field handing over to the next one: no flicker


def on_im_event(ev: dict) -> None:
    kind = ev.get("event")
    if TIMING and kind in ("activate", "deactivate", "surrounding"):
        extra = f" cursor {ev.get('cursor')}" if kind == "surrounding" else ""
        log(f"timing: field {kind}{extra} {time.monotonic():.3f}")
    if kind == "activate":
        show_for_text(False, "text field active")
    elif kind == "deactivate":
        def hide_if_still_inactive() -> bool:
            if STATE.im is not None and not STATE.im.active and STATE.keyboard()["visible"]:
                log("text field inactive")
                STATE.set_keyboard(False)
            return False
        GLib.timeout_add(IM_HIDE_DELAY_MS, hide_if_still_inactive)
    elif kind == "surrounding":
        # A tap in the field that is already active moves its caret: show a
        # keyboard hidden by hand again.
        if not STATE.keyboard()["visible"] and STATE.im is not None and STATE.im.active and touched_lately():
            show_for_text(False, "caret moved in the active field")


def watch_presses(name: str, codes: tuple, attr: str = "last_touch", retry: bool = False) -> None:
    """A press on another touch device (the top screen, the trackpad's
    clicks) is noted in STATE.attr: Desktop Mode counts it as a touch for
    showing the keyboard; Game Mode as a click for the Trackpad app's. With
    retry, a device not there yet (barry_launcher_inputd makes the trackpad's)
    is looked for again, and again after it goes away."""
    while True:
        found = watch_presses_once(name, codes, attr)
        if not retry:
            return
        time.sleep(1 if found else 5)


def watch_presses_once(name: str, codes: tuple, attr: str) -> bool:
    for name_file in glob.glob("/sys/class/input/event*/device/name"):
        try:
            with open(name_file, encoding="utf-8") as fh:
                if fh.read().strip() != name:
                    continue
            fd = os.open("/dev/input/" + name_file.split("/")[4], os.O_RDONLY)
        except OSError as err:
            log(f"cannot read {name}: {err}")
            continue
        log(f"watching presses on {name}")
        try:
            with os.fdopen(fd, "rb", buffering=0) as fh:
                while True:
                    data = fh.read(INPUT_EVENT.size)
                    if len(data) < INPUT_EVENT.size:
                        return True
                    _, _, etype, code, value = INPUT_EVENT.unpack(data)
                    if etype == EV_KEY and code in codes and value == 1:
                        setattr(STATE, attr, time.monotonic())
                    if TIMING and etype == EV_KEY and code in codes and value in (0, 1):
                        log(f"timing: {name} {'press' if value else 'release'} {time.monotonic():.3f}")
        except OSError:
            return True  # the device went away (inputd restarted)
    return False


def start_desktop() -> None:
    """Desktop Mode: KWin's window placement, the input method, and the
    other devices whose presses count as touches."""
    def place() -> bool:
        if barry_desktop.place_windows():
            log("KWin places Barry's windows on " + barry_desktop.OUTPUT)
            return False
        return True  # KWin not ready yet: again shortly
    if place():
        GLib.timeout_add(1000, place)
    STATE.im = barry_desktop.InputMethod(on_im_event)
    threading.Thread(target=STATE.im.run, daemon=True).start()
    for name, codes in TOP_PRESS_DEVICES:
        threading.Thread(target=watch_presses, args=(name, codes), daemon=True).start()


def main() -> None:
    srv = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    srv.daemon_threads = True
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    setup_bundled_apps()
    refresh_user_apps(force=True)
    enable_accessibility()
    Atspi.init()
    listener = Atspi.EventListener.new(on_focus)
    listener.register("object:state-changed:focused")
    caret = Atspi.EventListener.new(on_caret)
    caret.register("object:text-caret-moved")
    threading.Thread(target=watch_touches, daemon=True).start()
    if DESKTOP:
        start_desktop()
    else:
        for name, codes in TOP_PRESS_DEVICES:
            threading.Thread(target=watch_presses, args=(name, codes, "last_top_click", True),
                             daemon=True).start()
    apply_inset()  # no inset left over from before a restart
    threading.Thread(target=warm_apps, daemon=True).start()
    threading.Thread(target=load_dictionary, daemon=True).start()
    def home_request_stamp() -> int | None:
        try:
            return os.stat(HOME_REQUEST).st_mtime_ns
        except OSError:
            return None

    last_home = home_request_stamp()
    top_input_written: bool | None = None

    def watch() -> bool:
        nonlocal last_home, top_input_written
        # The keyboard window appears shortly after we start; mark it then,
        # so gamescope does not take it for an app.
        if not STATE.overlay_marked:
            mark_keyboard_overlay(quiet=True)
        # An app ending means its fields are gone too.
        for name, proc in list(STATE.apps.items()):
            if proc.poll() is not None:
                log(f"{name} exited ({proc.returncode})")
                del STATE.apps[name]
                if name in STATE.services:
                    threading.Thread(target=barry_apps.stop_service, args=(STATE.services.pop(name),),
                                     daemon=True).start()
                if "qml" in APPS.get(name, {}):
                    threading.Thread(target=release_top_input, daemon=True).start()
                STATE.set_keyboard(False)
        # AYN held: home.
        stamp = home_request_stamp()
        if stamp != last_home:
            last_home = stamp
            if stamp is not None:
                go_home()
        # Overlays draw above the dashboard: step aside while it is up.
        if STATE.keyboard()["visible"] and dashboard_up():
            STATE.set_keyboard(False)
        top_input = not DESKTOP and running(TOP_INPUT_APP) is not None
        if top_input != top_input_written:
            try:
                with open(TOP_INPUT_FLAG, "w", encoding="utf-8") as fh:
                    fh.write("1" if top_input else "0")
                top_input_written = top_input
            except OSError:
                pass  # no sm8550-thor-backlightd (not a Thor); tried again next pass
        return True
    GLib.timeout_add(200, watch)
    Atspi.event_main()


if __name__ == "__main__":
    main()
