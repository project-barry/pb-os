[Unit]
Description=AYN Thor, Retroid Pocket Duo: Plasma's brightness sliders share each screen's brightness with Game Mode
PartOf=graphical-session.target
After=plasma-powerdevil.service

[Service]
ExecCondition=/bin/sh -c 'grep -qaE "ayn,thor|retroidpocket,rpduo" /sys/firmware/devicetree/base/compatible'
ExecStart=/usr/lib/pbos-platformd/pbos-platformd --user --only thor-desktop-brightness
Restart=on-failure
RestartSec=3

[Install]
WantedBy=plasma-workspace.target
