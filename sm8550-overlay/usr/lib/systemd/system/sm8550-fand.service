[Unit]
Description=SM8550 fan curve (Retroid Pocket 6, Retroid Pocket Duo)
ConditionPathExists=/sys/firmware/devicetree/base/compatible

[Service]
Type=simple
ExecCondition=/bin/sh -c 'grep -qaE "qcom,sm8550|retroidpocket,rpduo" /sys/firmware/devicetree/base/compatible'
ExecStart=/usr/lib/pbos-platformd/pbos-platformd --system --only fan
ExecReload=/bin/kill -HUP $MAINPID
# Never leave the fan low if the daemon goes away (Armada's safe duty).
ExecStopPost=/bin/sh -c 'for d in /sys/class/hwmon/hwmon*; do [ "$(cat $d/name 2>/dev/null)" = pwmfan ] && echo 128 > $d/pwm1; done; true'
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
