[Unit]
Description=SM8550 power button (sleep / power menu, like the Steam Deck)
ConditionPathExists=/sys/firmware/devicetree/base/compatible

[Service]
Type=simple
ExecCondition=/bin/sh -c 'grep -qaE "qcom,sm8550|retroidpocket,rpduo" /sys/firmware/devicetree/base/compatible'
ExecStart=/usr/lib/pbos-platformd/pbos-platformd --system --only power-button
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
