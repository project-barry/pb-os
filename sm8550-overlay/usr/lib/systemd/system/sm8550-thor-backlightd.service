[Unit]
Description=AYN Thor, Retroid Pocket Duo: bottom-screen brightness, switch and sleep
ConditionPathExists=/sys/class/backlight/ae96000.dsi.0
# Before Game Mode: Steam must open ae94000's brightness (the Thor's bottom
# panel, the Duo's top one) after this has put its own file over it.
Before=display-manager.service

[Service]
Type=simple
ExecCondition=/bin/sh -c 'grep -qaE "ayn,thor|retroidpocket,rpduo" /sys/firmware/devicetree/base/compatible'
ExecStart=/usr/lib/pbos-platformd/pbos-platformd --system --only thor-backlight
Restart=always
RestartSec=2
# In case it died without undoing it.
ExecStopPost=-/bin/sh -c 'while mountpoint -q "$(realpath /sys/class/backlight/ae94000.dsi.0)/brightness"; do umount -l "$(realpath /sys/class/backlight/ae94000.dsi.0)/brightness" || break; done'
ExecStopPost=-/bin/sh -c 'while mountpoint -q "$(realpath /sys/class/backlight/ae94000.dsi.0)/type"; do umount -l "$(realpath /sys/class/backlight/ae94000.dsi.0)/type" || break; done'
ExecStopPost=-/bin/sh -c 'while mountpoint -q "$(realpath /sys/class/backlight/ae94000.dsi.0)/max_brightness"; do umount -l "$(realpath /sys/class/backlight/ae94000.dsi.0)/max_brightness" || break; done'
ExecStopPost=-/bin/sh -c 'while mountpoint -q "$(realpath /sys/class/backlight/ae96000.dsi.0)/max_brightness"; do umount -l "$(realpath /sys/class/backlight/ae96000.dsi.0)/max_brightness" || break; done'

[Install]
WantedBy=multi-user.target
