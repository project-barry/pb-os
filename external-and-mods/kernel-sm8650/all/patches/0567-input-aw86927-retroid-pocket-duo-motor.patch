+static int aw86927_probe(struct i2c_client *client)
+{
+	struct aw86927_data *haptics;
+	int err;
+
+	haptics = devm_kzalloc(&client->dev, sizeof(struct aw86927_data), GFP_KERNEL);
+	if (!haptics)
+		return -ENOMEM;
+
+	haptics->dev = &client->dev;
+	haptics->client = client;
+
+	haptics->gain = AW86927_VENDOR_GAIN;
+	haptics->id = -1;
+	spin_lock_init(&haptics->lock);
+	device_property_read_u32(haptics->dev, "pbos,f0-hertz", &haptics->f0);
+	if (haptics->f0 && (haptics->f0 < 100 || haptics->f0 > 500))
+		return dev_err_probe(haptics->dev, -EINVAL, "f0 %u Hz\n", haptics->f0);
+
