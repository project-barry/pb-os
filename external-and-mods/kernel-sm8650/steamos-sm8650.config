# SM8650-only additions (merged after steamos.config).

# KONKR MCU UART client (system buttons + stick RGB). Built as a module and
# blacklisted by default on the Pocket FIT; enable with `konkr-mcu enable`.
CONFIG_INPUT_KONKR_SYSBTN=m

# USB/IP host (vhci_hcd) for InputPlumber's "deck" target: the Pocket FIT pad
# reaches Steam as a real Steam Deck controller (28de:1205) instead of
# deck-uhid's generic 28de:12f0, so Steam names it "Steam Deck Controller"
# and emulator defaults bound to that name (EmuDeck's Dolphin) find it.
CONFIG_USBIP_CORE=m
CONFIG_USBIP_VHCI_HCD=m
