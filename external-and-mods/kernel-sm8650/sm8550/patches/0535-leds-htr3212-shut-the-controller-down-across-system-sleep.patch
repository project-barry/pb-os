From: lavachemist <48248311+lavachemist@users.noreply.github.com>
Subject: [PATCH] leds: htr3212: shut the controller down across system sleep

The HTR3212 stick-LED controllers on the Retroid Pocket 6/Nova and the AYN
Thor stayed enabled (SDB high) through system sleep. Measured on the Nova
with an inline USB-C meter at full charge: about 0.34 W asleep with SDB
high, 0.19 W with both controllers shut down, LEDs at 0 either way.

Pull SDB low in suspend; on resume raise it, re-initialise the chip and
restore every LED's brightness.
---
--- a/drivers/leds/leds-htr3212.c
+++ b/drivers/leds/leds-htr3212.c
@@ -288,6 +288,41 @@
 	regulator_disable(priv->vdd);
 }
 
+/*
+ * With SDB high the two stick-LED controllers drew about 150 mW (5 V input)
+ * in system sleep with every LED at 0. Pull SDB low for sleep, then bring
+ * the chip back up and restore each LED's brightness on resume. No I2C in
+ * the suspend path.
+ */
+static int htr3212_suspend(struct device *dev)
+{
+	struct htr3212_priv *priv = dev_get_drvdata(dev);
+
+	gpiod_set_value_cansleep(priv->sdb, 0);
+	return 0;
+}
+
+static int htr3212_resume(struct device *dev)
+{
+	struct htr3212_priv *priv = dev_get_drvdata(dev);
+	unsigned int i;
+	int ret;
+
+	gpiod_set_value_cansleep(priv->sdb, 1);
+	usleep_range(10000, 11000);
+
+	ret = htr3212_init_regs(priv);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < priv->num_leds; i++)
+		htr3212_brightness_set(&priv->leds[i].cdev,
+				       priv->leds[i].cdev.brightness);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(htr3212_pm_ops, htr3212_suspend, htr3212_resume);
+
 static const struct of_device_id of_htr3212_match[] = {
 	{ .compatible = "heroic,htr3212", },
 	{ /* sentinel */ }
@@ -306,6 +341,7 @@
 	.driver = {
 		.name	= "htr3212",
 		.of_match_table = of_htr3212_match,
+		.pm = pm_sleep_ptr(&htr3212_pm_ops),
 	},
 	.probe		= htr3212_probe,
 	.remove		= htr3212_remove,
