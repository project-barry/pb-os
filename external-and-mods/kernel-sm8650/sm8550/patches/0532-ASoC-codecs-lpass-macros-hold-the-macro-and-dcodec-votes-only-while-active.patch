From: lavachemist <48248311+lavachemist@users.noreply.github.com>
Subject: [PATCH] ASoC: codecs: lpass-*-macro: hold the macro and dcodec votes only while active

The rx, tx, wsa and va macros enable their "macro" and "dcodec" clocks in
probe and only disable them in remove. On SM8550 those are q6prm votes
(LPASS_HW_MACRO / LPASS_HW_DCODEC) that keep the LPASS core powered, so the
ADSP never let the SoC collapse CX or put DDR in self-refresh in system
sleep, even with every codec runtime-suspended and no stream open.

Drop both votes at the end of runtime suspend and take them again first in
runtime resume, as Qualcomm's downstream audio driver does. The register
cache is already cache-only while suspended and resynced on resume. Tested
on the Retroid Pocket Nova: speakers still work, and the SoC now reaches
full sleep (aosd/cxsd/ddr).
---
--- a/sound/soc/codecs/lpass-rx-macro.c
+++ b/sound/soc/codecs/lpass-rx-macro.c
@@ -3966,7 +3966,7 @@
 };
 MODULE_DEVICE_TABLE(of, rx_macro_dt_match);
 
-static int rx_macro_runtime_suspend(struct device *dev)
+static int rx_macro_runtime_suspend_clks(struct device *dev)
 {
 	struct rx_macro *rx = dev_get_drvdata(dev);
 
@@ -3980,7 +3980,7 @@
 	return 0;
 }
 
-static int rx_macro_runtime_resume(struct device *dev)
+static int rx_macro_runtime_resume_clks(struct device *dev)
 {
 	struct rx_macro *rx = dev_get_drvdata(dev);
 	int ret;
@@ -4014,6 +4014,48 @@
 	return ret;
 }
 
+
+/*
+ * The "macro" and "dcodec" clocks are q6prm votes that keep the LPASS core
+ * powered. Probe takes them and only remove dropped them, so the ADSP kept
+ * LPASS (and its CX/XO votes) up while the codec was idle and the SoC could
+ * never reach full sleep. Hold them only while the macro is runtime-active.
+ * Registers are already cache-only while suspended and resynced on resume.
+ */
+static int rx_macro_runtime_suspend(struct device *dev)
+{
+	struct rx_macro *rx = dev_get_drvdata(dev);
+	int ret = rx_macro_runtime_suspend_clks(dev);
+
+	if (ret)
+		return ret;
+	clk_disable_unprepare(rx->dcodec);
+	clk_disable_unprepare(rx->macro);
+	return 0;
+}
+
+static int rx_macro_runtime_resume(struct device *dev)
+{
+	struct rx_macro *rx = dev_get_drvdata(dev);
+	int ret;
+
+	ret = clk_prepare_enable(rx->macro);
+	if (ret)
+		return ret;
+	ret = clk_prepare_enable(rx->dcodec);
+	if (ret)
+		goto err_dcodec;
+	ret = rx_macro_runtime_resume_clks(dev);
+	if (ret)
+		goto err_clks;
+	return 0;
+err_clks:
+	clk_disable_unprepare(rx->dcodec);
+err_dcodec:
+	clk_disable_unprepare(rx->macro);
+	return ret;
+}
+
 static const struct dev_pm_ops rx_macro_pm_ops = {
 	RUNTIME_PM_OPS(rx_macro_runtime_suspend, rx_macro_runtime_resume, NULL)
 };
