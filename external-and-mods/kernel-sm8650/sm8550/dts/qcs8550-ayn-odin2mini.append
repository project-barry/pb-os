
/*
 * Stock AYN settings (factory DT, KalamaP HDK overlay, same on the Odin 2,
 * Odin 2 Portal and Odin 2 Mini): the haptics base voltage is 3200 mV (the
 * per-effect voltages already match AYN-common), and the fan PWM period is
 * 50 us. AYN-common, which the Thor shares, has 5000 mV and 40 us.
 */
&pm8550b_hv_haptics {
	qcom,vmax-mv = <3200>;
};

&pwm_fan {
	pwms = <&pm8550_pwm 3 50000>;
};

/*
 * Linux 7.3 has no driver for the crypto engine (QCE is marked BROKEN), so
 * this node never gets one and the interconnect providers wait for it
 * forever ("sync_state() pending due to 1dfa000.crypto"). Until they sync,
 * every bus and memory vote stays at its maximum, asleep too, and the SoC
 * never reaches its low-power state (AYN Thor, 2026-11-20: about 100 mA
 * asleep). As in the Retroid Pocket DTs.
 */
&crypto {
	status = "disabled";
};
