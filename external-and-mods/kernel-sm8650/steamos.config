# SteamOS additions on top of ROCKNIX devices/<SOC>/linux/linux.aarch64.conf
# (all SoCs; steamos-<soc>.config adds the SoC-specific ones).
# One CONFIG per line: =y, =m, =n or a value. build.sh reports any that
# Kconfig refuses.

# /etc and /var overlays are mounted early by SteamOS; don't depend on
# module autoload before /usr/lib/modules is reachable.
CONFIG_OVERLAY_FS=y

# InputPlumber deck-uhid needs the kernel hid-steam driver bound to the
# virtual Valve controller so Steam sees a real Deck pad.
CONFIG_HID_STEAM=m
CONFIG_STEAM_FF=y

# USB/IP host (vhci_hcd) for InputPlumber's "deck" target: a real Steam Deck
# controller (28de:1205) instead of deck-uhid's generic 28de:12f0. Steam
# shows a controller's trackpads only on the real one, so the AYN Thor uses
# it for Barry Launcher's Deck controls (sm8550-inputplumber-ext-hid).
CONFIG_USBIP_CORE=m
CONFIG_USBIP_VHCI_HCD=m

# Proton / FEX: fast NT sync primitives (Wine ntsync)
CONFIG_NTSYNC=m

# Bluetooth HFP / controllers that use RFCOMM (ROCKNIX leaves it off)
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m

# Steam formats SD cards as ext4 with casefold (for Proton); mounting a
# casefold filesystem needs the kernel's UTF-8 tables.
CONFIG_UNICODE=y

# Steam runtime / flatpak containers
CONFIG_EROFS_FS=m
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y

# systemd resource control that SteamOS units use
CONFIG_CFS_BANDWIDTH=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CGROUP_MISC=y

# zram is set up by SteamOS (zram-generator)
CONFIG_ZRAM=m
CONFIG_ZSWAP=y

# BPF JIT for systemd cgroup/IP filters
CONFIG_BPF_JIT_ALWAYS_ON=y

# SteamOS wifi uses iwd by default (the overlay pins wpa_supplicant, but keep iwd working)
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_AEAD=y

# LED pattern trigger: power-LED "breathing" feedback from pbosd
CONFIG_LEDS_TRIGGER_PATTERN=m

# Per-thread utilisation clamps: pbosd boosts game threads (uclamp.min) so
# schedutil ramps the big cores at once — Android's game-mode equivalent.
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
# Process events (netlink proc connector): sm8550-boostd gets fork/exec/comm/
# exit events instead of scanning /proc. CONNECTOR needs NET.
CONFIG_CONNECTOR=y
CONFIG_PROC_EVENTS=y
# ROCKNIX defaults to `performance` on every core (A520s included).
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# sched_ext: the Frame rootfs ships scx_lavd, scx.service and a steamos-manager
# "CPU scheduler: LAVD" option, but scx.service is skipped without
# /sys/kernel/sched_ext. Off unless someone picks it. Needs BTF, which needs
# unreduced DWARF (modules are installed stripped; BTF survives stripping).
CONFIG_SCHED_CLASS_EXT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_REDUCED=n
# scx_lavd exits with "kernel is missing CONFIG_FUNCTION_TRACER" and wants
# the syscall tracepoints (sys_enter_futex, ...). With DYNAMIC_FTRACE the
# function-trace call sites are patched to NOPs until something traces.
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
# TEO idle governor next to menu (select with cpuidle.governor=teo).
CONFIG_CPU_IDLE_GOV_TEO=y

# Tracing filesystem (/sys/kernel/tracing). The Frame's userspace needs it:
# - mangoapp (Performance Overlay) reads Adreno busy/memory via tracefs and
#   aborts with "failed to create instance" without it;
# - steamos-manager -r exits EPERM trying to create /sys/kernel/tracing,
#   stalling Game Mode ~3 minutes while its D-Bus activation times out.
# The function tracer enabled for sched_ext (further up) provides tracefs;
# ENABLE_DEFAULT_TRACERS only exists when no other tracer is on.
CONFIG_FTRACE=y

# The Thor sound dropout hunt (pbos-report audio-trace): probes on the audio
# DSP driver (graph commands, LPASS votes and clocks, every packet to and from
# the DSP) and runtime PM usage counts in sysfs (PM_ADVANCED_DEBUG needs
# PM_DEBUG; its sleep debug switches stay off). A kprobe costs nothing until
# it is placed.
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y

# Binder for Lepton (Valve's Android layer, Steam app 3029110). Lepton's
# container mounts binderfs itself and renames anbox-{binder,hwbinder,
# vndbinder}, so those must be binderfs's default devices. Same as the Frame
# kernel, which builds binder in.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="anbox-binder,anbox-hwbinder,anbox-vndbinder"
