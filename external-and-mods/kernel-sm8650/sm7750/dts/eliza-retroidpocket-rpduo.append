/*
 * pb-os: boot through the Duo's STOCK Qualcomm ABL (`fastboot boot
 * KERNEL-rpduo`). Tested 2026-11-20. (Through OpenABL the DTB is used as
 * is: no overlay, nothing below gets in the way. Tested 2026-11-22.)
 *
 * DTB match (LocateDeviceTree.c GetSocDtb): a DTB is dropped unless one
 * qcom,msm-id entry has the chip id in its low 16 bits, so this lists every
 * Eliza id in dt-bindings/arm/qcom,ids.h: SM7750 (659) and the Dragonwing
 * CQ7790M/S (731/732; the Duo reports 732, rev 1.0). board-id variant 0 is
 * never rejected.
 *
 * Overlays: that ABL always applies the device's dtbo partition entry (#50
 * "Kera MTP + WCN7750 + UFS2") and the Gunyah hypervisor's overlays onto this
 * DTB. Its libufdt resolves every label an overlay references through our
 * /__symbols__; one missing label fails the whole overlay, the ABL then never
 * copies the DTB and silently drops back to fastboot ("Booting OKAY", logo
 * stays). So /__symbols__ below points every label of the 19 stock Kera/Sun/
 * Tuna SoC DTBs in the Duo's vendor_boot (a superset of the dtbo fixups) at
 * /abl-dtbo-sink. That node has no phandle, so every fragment resolves to
 * target 0 and is skipped: nothing of the stock overlay lands in our tree.
 *
 * The overlay still replaces the root model, compatible and qcom,* ids with
 * the dtbo's. /abl-dtbo-sink keeps the real model and compatible, and
 * all/patches/0562 copies them back to the root right after the kernel
 * unflattens the DTB (without it the display fails: "Couldn't find UBWC
 * config data for this platform!").
 *
 * The labels list was read from the stock vendor_boot DTBs (label names only).
 */
/ {
	/* Retroid's DTS writes "RetroidPocket Duo"; their RP6 and Nova DTS
	 * say "Retroid Pocket 6" / "Retroid Pocket Nova". */
	model = "Retroid Pocket Duo";
	qcom,msm-id = <659 0x10000>, <731 0x10000>, <732 0x10000>;
	qcom,board-id = <0 0>;

	abl-dtbo-sink {
		pbos,model = "Retroid Pocket Duo";
		pbos,compatible = "retroidpocket,rpduo", "qcom,eliza";
	};

	__symbols__ {
		APC0_MX_CX_PAUSE = "/abl-dtbo-sink";
		APC1_MX_CX_PAUSE = "/abl-dtbo-sink";
		APSS_OFF = "/abl-dtbo-sink";
