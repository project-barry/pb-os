/*
 * pb-os: the fan follows the Duo's stock curve in userspace
 * (sm8550-fand, /usr/share/sm8550-fand/fan-rpduo.conf). Retroid's DT also
 * has the kernel step it from these zones' "active" trips (55 C CPU, 60 C
 * GPU), which would fight the daemon every tick: drop those bindings; the
 * fan stays a plain pwm-fan hwmon device.
 */
&{/thermal-zones/cpuss0-thermal} {
	/delete-node/ cooling-maps;
};

&{/thermal-zones/cpuss1-thermal} {
	/delete-node/ cooling-maps;
};

&{/thermal-zones/gpuss0-thermal} {
	/delete-node/ cooling-maps;
};

&{/thermal-zones/gpuss1-thermal} {
	/delete-node/ cooling-maps;
};

/*
 * pb-os: the controller MCU's joystick frame (SET_PAR 0x01) is 10,4 on the
 * Duo, the value stock Android's librsinput sends; ROCKNIX's driver default
 * 40,7 stays for the RP6 and Nova. Read by all/patches/0566 (it used to be
 * rsinput.mcu_frame on the Duo's own cmdline; the OpenABL boot entry is now
 * shared by every device).
 */
&gamepad {
	mcu-frame = <10 4>;
};
