+def render_layer_config(profile_data: ProfileData, dll: str, process_prefix: str) -> str:
+    """PB-OS: the lsfg-vk 1.x config for the image's aarch64 layer.
+
+    One [[game]] per App ID of every profile; ~/.lsfg sets
+    LSFG_PROCESS=<process_prefix><appid>, which 1.x matches against exe.
+    Profiles with a multiplier below 2 get no entry, so the layer stays off.
+    """
+    lines = [
+        "version = 1",
+        "# Generated by Decky LSFG-VK (PB-OS) from profiles.toml; edits are overwritten.",
+        "",
+        "[global]",
+    ]
+    if dll:
+        lines.append(f"dll = {_toml_value(dll)}")
+    lines.append("no_fp16 = true")
+    for name, raw in sorted(profile_data["profiles"].items()):
+        config = ConfigurationManager.validate_config({**raw, **profile_data.get("global_config", {})})
+        if config["multiplier"] < 2:
+            continue
+        for appid in config["active_in"]:
+            if not appid.lstrip("-").isdigit():
+                continue
+            lines.extend([
+                "",
+                "[[game]] # " + " ".join(str(name).split()),
+                f"exe = {_toml_value(process_prefix + appid)}",
+                f"multiplier = {config['multiplier']}",
+                f"flow_scale = {config['flow_scale']}",
+                f"performance_mode = {_toml_value(config['performance_mode'])}",
+            ])
+    return "\n".join(lines) + "\n"
