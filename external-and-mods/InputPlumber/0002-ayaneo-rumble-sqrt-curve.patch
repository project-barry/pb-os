+    /// Motor drive level for a rumble magnitude. Games mostly ask for a
+    /// quarter to a third of full strength, which these motors render much
+    /// weaker than a Steam Deck does, so the level follows a square-root
+    /// curve: off stays off, full stays full, the low and middle range is
+    /// lifted (25% -> 50%, 50% -> 71%).
+    fn motor_level(magnitude: u16) -> u8 {
+        if magnitude == 0 {
+            return 0;
+        }
+        let level = (magnitude as f32 / u16::MAX as f32).sqrt() * 255.0;
+        (level.round() as u8).max(1)
+    }
+
     fn build_rumble_report(left_magnitude: u16, right_magnitude: u16) -> AyaneoRumbleReport {
         AyaneoRumbleReport {
-            left_motor: (left_magnitude >> 8) as u8,
-            right_motor: (right_magnitude >> 8) as u8,
+            left_motor: Self::motor_level(left_magnitude),
+            right_motor: Self::motor_level(right_magnitude),
             ..Default::default()
         }
     }
