# OpenABL releases staged on every image (BOOT/openabl/): the common one, and
# one for each SoC that has PBOS_ABL_*_<SoC> values below.
# Upstream: https://github.com/OpenHandheldCollective/OpenABL (GPL-3.0-or-later).
# v1.2 is the PB-OS fork's release (project-barry/OpenABL): upstream v1.1 plus
# the fix for the intermittent logo hang between ExitBootServices and the kernel
# (upstream issue OpenHandheldCollective/OpenABL#29).
# A bump needs a new tarball hash here and new releases.tsv rows.
PBOS_ABL_VERSION=1.2
PBOS_ABL_REPO=project-barry/OpenABL
PBOS_ABL_TARBALL_SHA256=cc0aac653bb1eb8ab1f11d03c0cb80a189be26c9c8c8f23787177cca2b3e15f8

# SM7750 (Retroid Pocket Duo) has a release of its own, built from upstream
# main plus SM7750 support; it must not be called 1.2. It isn't out yet:
# replace both UNFILLED values and the row in releases.tsv when it is. Until
# then an image builds only with SKIP_ABL=1 or a test build (ABL_TARBALL_SM7750,
# ABL_VERSION_SM7750 and ABL_SHA256_SM7750, see make-steamos-sm8650.sh).
PBOS_ABL_VERSION_SM7750=UNFILLED
PBOS_ABL_REPO_SM7750=project-barry/OpenABL
PBOS_ABL_TARBALL_SHA256_SM7750=UNFILLED
