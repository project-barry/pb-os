# OpenABL release staged on every image (BOOT/openabl/).
# Upstream: https://github.com/OpenHandheldCollective/OpenABL (GPL-3.0-or-later).
# v1.2 is the PB-OS fork's release (project-barry/OpenABL): upstream v1.1 plus
# the fix for the intermittent logo hang between ExitBootServices and the kernel
# (upstream issue OpenHandheldCollective/OpenABL#29).
# A bump needs a new tarball hash here and new releases.tsv rows.
PBOS_ABL_VERSION=1.2
PBOS_ABL_REPO=project-barry/OpenABL
PBOS_ABL_TARBALL_SHA256=cc0aac653bb1eb8ab1f11d03c0cb80a189be26c9c8c8f23787177cca2b3e15f8
