#!/bin/bash
# pbos-apk — Android apps on SteamOS through Lepton (Valve's Android layer,
# Steam app 3029110; needs the binder kernel from steamos.config).
#
#   pbos-apk install FILE...  .apk / .apkm / .xapk / .apks (split bundles
#                              too). Opening one in Dolphin does the same.
#   pbos-apk run PACKAGE      open an app (what its Steam title calls)
#   pbos-apk store            open the Play Store (once Google Play is added)
#   pbos-apk gapps            add Google Play: download it from its sources
#                              and set it up (the "Add Google Play" title)
#   pbos-apk list             installed apps
#   pbos-apk remove PACKAGE   uninstall (delete its Steam title by hand)
#   pbos-apk inbox            install everything in ~/Android/Inbox
#   pbos-apk stop             shut Android down
#
# All apps share one Android (pbos-android.service, started on demand and
# stopped 10 minutes after the last app closes). Every app installed in it —
# sideloaded or from the Play Store — gets its own Steam title with its name
# and icon. Lepton is presented a Steam launch without an APK
# (SteamAppId=pbos-android), which keeps /data between runs.
#
# Lepton strips SystemServer services that normal apps need (clipboard:
# Firefox dies at start without it). The first Android start for each Lepton
# version builds a fixed services.jar on the device (build_fixes) and starts
# Android again with it. When Valve updates Lepton, that happens again.
#
# PB-OS ships no Google apps. Google Play is the user's choice: `gapps`
# fetches it (google-play-fetch, checked against pinned SHA-256) into
# ~/.local/share/pbos-google-play, which updates never touch.
set -euo pipefail

LEPTON_APPID=3029110
LEPTON_DIR="${HOME}/.local/share/Steam/steamapps/common/Lepton"
LEPTON="${LEPTON_DIR}/lepton"
APPS="${HOME}/Android"
INBOX="${APPS}/Inbox"
SYS="${APPS}/.android"            # shared Android: data, icons, known titles
CTR=lepton-steamlaunch-pbos-android
RUNDIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
READY="${RUNDIR}/pbos-android.ready"
DESKTOP_DIR="${HOME}/.local/share/applications"
APK_INFO=/usr/lib/pbos/apk-info
# Lepton overlay from the image (Steam pad key layout, no freeform windows):
# in home, not on the root partition; the updater installs it there.
OVERLAY_ROOT="${HOME}/.local/share/pbos-android"
# Google Play, added by the user: common/ (Play Store, Play services, touch
# keyboard).
GP_ROOT="${HOME}/.local/share/pbos-google-play"
# Framework fixes built here: lepton-<ver>/ for the installed Lepton, and
# failed-<ver> after a failed build (tried again a day later).
FIXES="${HOME}/.local/share/pbos-apk/framework"
GP_FETCH=/usr/lib/pbos/google-play-fetch
FRAMEWORK=/usr/lib/pbos/android-framework
GP_DESKTOP="${DESKTOP_DIR}/pbos-google-play.desktop"
MODE="${RUNDIR}/pbos-android.mode"
GOOGLE_PKGS=(com.android.vending com.google.android.gms com.google.android.gsf rkr.simplekeyboard.inputmethod)
# Touch keyboard from Google Play's overlay (Simple Keyboard, F-Droid).
IME=rkr.simplekeyboard.inputmethod/.latin.LatinIME
# The default keyboard, from the image's overlay: draws nothing and asks for
# the device's own (Steam's, Barry's on the Thor), see keyboard_watch.
PBOS_IME=org.projectbarry.pbos.keyboard/.PbosKeyboard

google_on() { [[ -f "${GP_ROOT}/common/system/product/priv-app/Phonesky/Phonesky.apk" ]]; }
lepton_ver() { cat "${LEPTON_DIR}/images/version.txt" 2>/dev/null || true; }
# Launchable system apps that get a Steam title too.
system_titles() { google_on && echo com.android.vending; return 0; }

say() {
  echo "pbos-apk: $*" >&2
  notify-send -a "Android apps" -i android-package-archive "Android apps" "$*" 2>/dev/null || true
}
die() { say "$*"; exit 1; }

ensure_lepton() {
  [[ -x "$LEPTON" ]] && return 0
  say "Downloading the Android runtime (Lepton) through Steam…"
  steam "steam://install/${LEPTON_APPID}" >/dev/null 2>&1 &
  local i
  for ((i = 0; i < 360; i++)); do
    [[ -x "$LEPTON" ]] && sleep 20 && return 0  # let Steam finish the depot
    sleep 5
  done
  die "Lepton didn't finish installing. Check Steam's Downloads page, then try again."
}

# Idempotent edits to Steam's Lepton, re-applied every start since Steam
# updates overwrite the tool.
patch_lepton() {
  python3 - "${LEPTON_DIR}" <<'EOF'
import sys, pathlib
root = pathlib.Path(sys.argv[1])
def patch(name, *pairs):
    """Apply the first (old, new) whose old is still in the file.

    Valve rewords these files between Lepton releases, so a patch carries one
    pair per upstream wording it knows (newest Lepton last). Already patched
    with any of them: leave it alone.
    """
    f = root / name
    s = f.read_text()
    if any(new in s for _, new in pairs):
        return
    for old, new in pairs:
        if old in s:
            f.write_text(s.replace(old, new, 1))
            return
    print(f"pbos-apk: WARN {name} changed upstream, patch skipped", file=sys.stderr)

# Edits made before the PB-OS rename are marked konkr-apk and read KONKR_
# variables: give them the current names, so the checks below find them.
for name in ("lepton", "liblepton/mounting.sh", "liblepton/properties.sh"):
    f = root / name
    s = f.read_text()
    t = s.replace("# konkr-apk: ", "# pbos-apk: ").replace("KONKR_LEPTON_", "PBOS_LEPTON_")
    if t != s:
        f.write_text(t)

# A Steam launch without an APK boots straight to Android (like `dev`), but
# keeps its data like a Steam game.
patch("lepton",
      ('        if ! is_steamlaunch && ! is_app; then\n            continue_boot_after_bake\n',
       '        # pbos-apk: shared Android without an app\n'
       '        if ! is_app; then\n            continue_boot_after_bake\n'))

patch("lepton",
      ('        if is_steamlaunch || [[ "${LEPTON_CONTEXT}" == *.apk ]]; then\n'
       '            if [[ -z "${APP_PACKAGE_ID}" ]]; then\n',
       '        # pbos-apk: shared Android has no APK\n'
       '        if { is_steamlaunch && is_app; } || [[ "${LEPTON_CONTEXT}" == *.apk ]]; then\n'
       '            if [[ -z "${APP_PACKAGE_ID}" ]]; then\n'))

# Per-app persistent data only makes sense with an app (an empty app id
# would move the whole compat dir into itself).
patch("liblepton/mounting.sh",
      ('    if [[ -d "${STEAM_COMPAT_DATA_PATH:-}" ]]; then\n'
       '        PERSISTENT_DATA_PATH=',
       '    # pbos-apk: shared Android has no app id\n'
       '    if [[ -d "${STEAM_COMPAT_DATA_PATH:-}" && -n "$(get_app_id)" ]]; then\n'
       '        PERSISTENT_DATA_PATH='))

# Gamepads: the host's live /dev/input, which pbos-apk links pads from
# (Waydroid only forwards touch/keyboard/mouse from Wayland). Steam
# recreates its virtual pads, so per-node mounts would go stale.
patch("liblepton/mounting.sh",
      ('    # By default, we do not allow writes to msg\n',
       '    # pbos-apk: host input devices\n'
       '    if [[ -n "${PBOS_LEPTON_OVERLAY:-}" ]]; then\n'
       '        podman_mount_entry /dev/input /dev/host-input ro\n'
       '    fi\n\n'
       '    # By default, we do not allow writes to msg\n'))

# LuaJIT (xLua/ToLua in many Unity games) needs memory below 2^47, but our
# 48-bit+ VA kernel maps top-down from 2^48 and lua_newstate returns NULL.
# An unlimited stack rlimit selects the legacy bottom-up layout (from 2^46);
# zygote inherits it and every app forks from zygote. Phones use 39-bit VA.
patch("liblepton/mounting.sh",
      ('    # namespaces\n',
       '    # namespaces\n'
       '    # pbos-apk: low mmap layout for LuaJIT\n'
       '    if [[ -n "${PBOS_LEPTON_OVERLAY:-}" ]]; then\n'
       '        podman_cmdline --ulimit stack=-1:-1\n'
       '    fi\n'))

# Extra rootfs overlay (restored framework services, Play Store); Steam's
# own Android games keep Valve's image. Lepton v3.0.3 quotes the two paths.
patch("liblepton/mounting.sh",
      ('    for OVERLAY in ${LEPTON_OVERLAY} ${GUESTOS_OVERLAY}; do\n',
       '    # pbos-apk: extra overlay\n'
       '    for OVERLAY in ${LEPTON_OVERLAY} ${GUESTOS_OVERLAY} ${PBOS_LEPTON_OVERLAY:-}; do\n'),
      ('    for OVERLAY in "${LEPTON_OVERLAY}" "${GUESTOS_OVERLAY}"; do\n',
       '    # pbos-apk: extra overlay\n'
       '    for OVERLAY in "${LEPTON_OVERLAY}" "${GUESTOS_OVERLAY}" ${PBOS_LEPTON_OVERLAY:-}; do\n'))

# Lepton's teardown deletes the baked /data and app layers on every stop
# (remove_prefix), even with LEPTON_NO_CLEANUP, which only guards
# clear_baked_app_data: the shared Android lost every installed app each time
# it stopped (10 minutes after the last app, or a restart). Keep them, as
# LEPTON_NO_CLEANUP means everywhere else.
patch("liblepton/liblepton.sh",
      ('    if [[ -n "${LEPTON_PREFIX:-}" ]]; then\n'
       '        prepare_baked_data_for_removal\n'
       '\n'
       '        # clear the whole prefix\n',
       '    if [[ -n "${LEPTON_PREFIX:-}" ]]; then\n'
       '        # pbos-apk: shared Android keeps its data\n'
       '        if [[ "${LEPTON_NO_CLEANUP:-false}" == "false" ]]; then\n'
       '            prepare_baked_data_for_removal\n'
       '        fi\n'
       '\n'
       '        # clear the whole prefix\n'))

# Lepton v3 runs one app per container: after each install its guest `cmd`
# moves the app's files into the /data/steam_app layer and binds that over
# the app's /data/app dir, for this start only. In the shared Android every
# app landed in that one layer and was gone after the next start ("missing
# scanned package"). Tell the guest it's shared, and leave apps in /data/app.
patch("liblepton/properties.sh",
      ('    # Set correct timezone\n',
       '    # pbos-apk: shared Android\n'
       '    if [[ -n "${PBOS_SHARED_ANDROID:-}" ]]; then\n'
       '        props_echo "pbos.shared_android=1"\n'
       '    fi\n'
       '\n'
       '    # Set correct timezone\n'))
patch("images/rootfs_overlay/system/bin/cmd",
      ('    rm -rf /data/media/0/Android/obb/${APP_ID};\n',
       '    # pbos-apk: shared Android keeps apps (and OBBs) where Android put them\n'
       '    if [ "$(getprop pbos.shared_android)" != 1 ]; then\n'
       '    rm -rf /data/media/0/Android/obb/${APP_ID};\n'))
patch("images/rootfs_overlay/system/bin/cmd",
      ('    cp /data/steam_app/UECommandLine.txt "${APP_PATH}/UECommandLine.txt" 2> /dev/null || true\n',
       '    cp /data/steam_app/UECommandLine.txt "${APP_PATH}/UECommandLine.txt" 2> /dev/null || true\n'
       '    fi  # pbos-apk: shared Android\n'))

# Lepton writes brand/model/manufacturer into its runtime waydroid.prop on
# every start. With Google Play added (PBOS_LEPTON_GOOGLE), match the
# certified identity from props_overlay, or Google sees a Pixel 5 fingerprint
# on a "Valve Lepton" and refuses it again; without it Android keeps Valve's.
# Lepton v3.0.3 dropped the ro.product.brand line.
def identity(valve, gate):
    return ('    # pbos-apk: certified identity\n'
            f'    if [[ -n "${{{gate}:-}}" ]]; then\n'
            '        props_echo "ro.product.brand=google"\n'
            '        props_echo "ro.product.model=Pixel 5"\n'
            '        props_echo "ro.product.manufacturer=Google"\n'
            '    else\n' + valve + '    fi\n')
V2 = ('    props_echo "ro.product.brand=Steam Frame"\n'
      '    props_echo "ro.product.model=Lepton"\n'
      '    props_echo "ro.product.manufacturer=Valve"\n')
V3 = ('    props_echo "ro.product.model=Lepton"\n'
      '    props_echo "ro.product.manufacturer=Valve"\n')
# Files patched before Google Play was optional (gated on the overlay) come
# first: Valve's own lines are still inside them, in the else branch.
patch("liblepton/properties.sh",
      (identity(V2, "PBOS_LEPTON_OVERLAY"), identity(V2, "PBOS_LEPTON_GOOGLE")),
      (identity(V3, "PBOS_LEPTON_OVERLAY"), identity(V3, "PBOS_LEPTON_GOOGLE")),
      (V2, identity(V2, "PBOS_LEPTON_GOOGLE")),
      (V3, identity(V3, "PBOS_LEPTON_GOOGLE")))
EOF
}

# Lepton mounts SteamVR's runtime/config/log dirs (from openvrpaths.vrpath)
# into every container. There's no SteamVR here: point them at empty dirs,
# unless a real SteamVR registered itself.
ensure_vrpaths() {
  local vrp="${HOME}/.config/openvr/openvrpaths.vrpath" base="${HOME}/.local/share/pbos-apk/steamvr"
  # Always: a vrpath left pointing here (a home copied without
  # ~/.local/share/pbos-apk) makes Lepton pass an empty host path to podman
  # ("host directory cannot be empty") and Android never starts.
  mkdir -p "${vrp%/*}" "$base/runtime" "$base/config" "$base/logs"
  [[ -s "$vrp" ]] && return 0
  cat >"$vrp" <<EOF
{
  "config": ["$base/config"],
  "external_drivers": null,
  "jsonid": "vrpathreg",
  "log": ["$base/logs"],
  "runtime": ["$base/runtime"],
  "version": 1
}
EOF
}

# Steam's virtual pads when Steam Input is active (Game Mode), otherwise the
# physical ones — never both, or every press lands twice.
gamepad_nodes() {
  local virt=() phys=() ev sys
  for sys in /sys/class/input/event*; do
    ev="${sys##*/}"
    [[ -r "/dev/input/${ev}" ]] || continue
    udevadm info -q property -n "/dev/input/${ev}" 2>/dev/null | grep -qx 'ID_INPUT_JOYSTICK=1' || continue
    if [[ "$(readlink -f "${sys}/device")" == /sys/devices/virtual/* ]]; then
      virt+=("$ev")
    else
      phys+=("$ev")
    fi
  done
  if ((${#virt[@]})); then echo "${virt[*]}"; else echo "${phys[*]}"; fi
}

# App id of the Steam launch we're running under (the reaper's
# "SteamLaunch AppId=N"), the same way gamescope finds a window's app.
steam_launch_appid() {
  local pid=$$ comm args
  while ((pid > 1)); do
    comm="$(cat "/proc/$pid/comm" 2>/dev/null)" || break
    if [[ "$comm" == reaper ]]; then
      args="$(tr '\0' '\n' <"/proc/$pid/cmdline")"
      grep -qx SteamLaunch <<<"$args" && sed -n 's/^AppId=\([0-9]\+\)$/\1/p' <<<"$args" | head -n1
      return 0
    fi
    pid="$(awk '{print $4}' "/proc/$pid/stat" 2>/dev/null)" || break
  done
  return 0
}

# Shell command inside Android. Stdin is passed through (APK streaming).
asx() { podman exec -i "$CTR" /system/bin/sh -c "$1" 2>/dev/null; }

android_up() { [[ -f "$READY" ]] && systemctl --user -q is-active pbos-android.service; }

# A compositor holds its socket's .lock while it runs; gamescope leaves the
# socket itself behind when it exits.
live_display() { [[ -S "${RUNDIR}/$1" ]] && ! flock -n "${RUNDIR}/$1.lock" true 2>/dev/null; }

# Which Wayland display Android should draw on: gamescope in Game Mode,
# KWin in Desktop Mode.
current_display() {
  if live_display gamescope-0; then echo gamescope-0; else echo "${WAYLAND_DISPLAY:-wayland-0}"; fi
}

ensure_android() {
  local want i
  want="$(current_display)"
  if android_up && [[ "$(cat "$READY")" == "$want" ]]; then
    return 0
  fi
  # Switched between Game and Desktop Mode: the window lives on the old one.
  systemctl --user stop pbos-android.service 2>/dev/null || true
  systemctl --user set-environment PBOS_ANDROID_DISPLAY="$want"
  systemctl --user start pbos-android.service
  say "Starting Android…"
  # Up to 10 minutes: a first start builds the framework fixes (cmd_daemon).
  for ((i = 0; i < 300; i++)); do
    android_up && return 0
    systemctl --user -q is-active pbos-android.service || break
    sleep 2
  done
  die "Android didn't start (journalctl --user -u pbos-android)."
}

# Folders and desktop entries from before the PB-OS rename (konkr): move them
# once, at login and when Android starts. The PB-OS tab moves the Steam
# titles to /usr/bin/pbos-apk (their app ids stay).
migrate_old_names() {
  local old new f
  for old in konkr-android konkr-apk; do
    new="${HOME}/.local/share/pbos-${old#konkr-}"
    old="${HOME}/.local/share/${old}"
    [[ -d "$old" ]] || continue
    if [[ -d "$new" ]]; then rm -rf "$old"; else mv "$old" "$new"; fi
  done
  for f in "${DESKTOP_DIR}"/konkr-android-*.desktop "$GP_DESKTOP"; do
    [[ -f "$f" ]] || continue
    new="${f%/*}/$(basename "$f" | sed 's/^konkr-android-/pbos-android-/')"
    sed 's#/usr/bin/konkr-apk#/usr/bin/pbos-apk#' "$f" >"${new}.tmp" && mv "${new}.tmp" "$new"
    [[ "$f" == "$new" ]] || rm -f "$f"
  done
  # The SteamVR paths Lepton mounts (ensure_vrpaths) pointed into konkr-apk:
  # left so, Lepton passes podman an empty host path and Android never starts.
  f="${HOME}/.config/openvr/openvrpaths.vrpath"
  if [[ -f "$f" ]] && grep -q '/\.local/share/konkr-apk/' "$f"; then
    sed -i 's#/\.local/share/konkr-apk/#/.local/share/pbos-apk/#g' "$f"
  fi
  # The shared Android's container under its old name.
  podman rm -f lepton-steamlaunch-konkr-android >/dev/null 2>&1 || true
  # Framework fixes were Google Play's only (0.5.4.18): every Android has them.
  for f in "${GP_ROOT}"/lepton-*; do
    [[ -d "$f" ]] || continue
    mkdir -p "$FIXES"
    rm -rf "${FIXES:?}/${f##*/}"
    mv "$f" "${FIXES}/"
  done
  rm -f "${GP_ROOT}"/failed-*
  return 0
}

# Rootfs overlays for Lepton (see external-and-mods/pbos-android):
#  common/        (image) Steam pad key layout, no freeform windows
#  lepton-<ver>/  (FIXES) services.jar with the SystemServer services Lepton
#                 strips (clipboard, biometric/auth, cross-profile apps, …)
#                 and the odex/dalvik-cache built against it, for one Lepton
#                 Android image: built here (build_fixes) for each new one.
# With Google Play added, from GP_ROOT:
#  common/        Play Store + Play services, touch keyboard
#  props-<ver>/   build.prop copies (generated below): Google refuses Play
#                 Store sign-in on uncertified builds ("This device isn't Play
#                 Protect certified") and Lepton identifies as a userdebug
#                 LineageOS test-keys build. These present the certified
#                 Pixel 5 build with the same Android 11 build ID instead.
PROPS_REV=2
PROPS_FP=google/redfin/redfin:11/RQ3A.211001.001/7641976:user/release-keys

# Generated from the installed Lepton so it follows Lepton updates; bump
# PROPS_REV when the values change. ro.build.type stays Lepton's userdebug:
# with "user" Android's vendor interface check fails and an "Android System:
# internal problem with your device" popup appears on every start.
props_overlay() {
  local ver="$1" src="${LEPTON_DIR}/images/rootfs" out f
  out="${HOME}/.local/share/pbos-apk/props-${ver}"
  if [[ "$(cat "$out/.rev" 2>/dev/null)" != "$PROPS_REV" ]]; then
    rm -rf "$out"
    for f in system/build.prop system/system_ext/build.prop system/product/build.prop \
        vendor/build.prop vendor/odm/etc/build.prop; do
      [[ -f "$src/$f" ]] || continue
      mkdir -p "$out/${f%/*}"
      sed -E \
        -e "s#^(ro\.([a-z_]+\.)?build\.fingerprint)=.*#\1=${PROPS_FP}#" \
        -e "s#^(ro\.bootimage\.build\.fingerprint)=.*#\1=${PROPS_FP}#" \
        -e 's#^(ro\.([a-z_]+\.)?build\.tags)=.*#\1=release-keys#' \
        -e 's#^(ro\.product\.([a-z_]+\.)?brand)=.*#\1=google#' \
        -e 's#^(ro\.product\.([a-z_]+\.)?manufacturer)=.*#\1=Google#' \
        -e 's#^(ro\.product\.([a-z_]+\.)?model)=.*#\1=Pixel 5#' \
        -e 's#^(ro\.product\.([a-z_]+\.)?(name|device))=.*#\1=redfin#' \
        -e 's#^(ro\.build\.version\.incremental)=.*#\1=7641976#' \
        -e 's#^(ro\.build\.description)=.*#\1=redfin-user 11 RQ3A.211001.001 7641976 release-keys#' \
        -e 's#^(ro\.build\.version\.security_patch)=.*#\1=2021-10-05#' \
        "$src/$f" >"$out/$f"
    done
    if [[ -f "$out/system/build.prop" ]] && ! grep -q '^ro\.build\.fingerprint=' "$out/system/build.prop"; then
      echo "ro.build.fingerprint=${PROPS_FP}" >>"$out/system/build.prop"
    fi
    echo "$PROPS_REV" >"$out/.rev"
  fi
  echo "$out"
}

overlay_dirs() {
  local ver dirs=("${OVERLAY_ROOT}/common")
  ver="$(lepton_ver)"
  [[ -d "${FIXES}/lepton-${ver}" ]] && dirs+=("${FIXES}/lepton-${ver}")
  if google_on; then
    dirs+=("${GP_ROOT}/common")
    dirs+=("$(props_overlay "${ver:-unknown}")")
  fi
  echo "${dirs[*]}"
}

# Rebuild services.jar for the installed Lepton and compile against it inside
# the running Android (as external-and-mods/pbos-android/framework/
# build-framework.sh does on a build machine): a Java runtime and smali come
# from google-play-fetch and are deleted afterwards.
build_fixes() {
  local ver work out java
  ver="$(lepton_ver)"
  [[ -n "$ver" ]] || return 1
  mkdir -p "${HOME}/.cache"
  work="$(mktemp -d "${HOME}/.cache/pbos-apk-framework.XXXXXX")"
  out="${work}/lepton-${ver}"
  java="${work}/jre/bin/java"
  if python3 -I "$GP_FETCH" tools "$work" >&2 \
     && cp "${LEPTON_DIR}/images/rootfs/system/framework/services.jar" "${work}/orig.jar" \
     && python3 -I -c 'import sys, zipfile; zipfile.ZipFile(sys.argv[1]).extract("classes.dex", sys.argv[2])' \
          "${work}/orig.jar" "${work}/jar" \
     && "$java" -jar "${work}/baksmali.jar" d -a 30 "${work}/jar/classes.dex" -o "${work}/classes" \
     && python3 -I "${FRAMEWORK}/restore-services.py" "${work}/classes/com/android/server/SystemServer.smali" >&2 \
     && "$java" -jar "${work}/smali.jar" a -a 30 "${work}/classes" -o "${work}/classes.new.dex" \
     && python3 -I "${FRAMEWORK}/repack-jar.py" "${work}/orig.jar" "${work}/services.jar" \
          "classes.dex=${work}/classes.new.dex" >&2 \
     && podman cp "${work}/services.jar" "${CTR}:/data/local/tmp/services.jar" \
     && podman cp "${FRAMEWORK}/compile-odex.sh" "${CTR}:/data/local/tmp/compile-odex.sh" \
     && podman exec "$CTR" /system/bin/sh /data/local/tmp/compile-odex.sh >"${work}/compile-odex.log" 2>&1 \
     && podman cp "${CTR}:/data/local/tmp/out" "$out" \
     && cp "${work}/services.jar" "${out}/system/framework/services.jar" \
     && [[ "$(find "$out" -type f | wc -l)" == 10 ]]; then
    mkdir -p "$FIXES"
    rm -rf "${FIXES}"/lepton-* "${FIXES}"/failed-*
    mv "$out" "${FIXES}/lepton-${ver}"
  else
    rm -rf "$out"
  fi
  asx 'rm -rf /data/local/tmp/services.jar /data/local/tmp/compile-odex.sh /data/local/tmp/out' || true
  rm -rf "$work"
  [[ -d "${FIXES}/lepton-${ver}" ]]
}

# --- titles -----------------------------------------------------------------

add_title() {
  local pkg="$1" path apk meta label activity desktop icon="${SYS}/icons/${pkg}.png"
  path="$(asx "pm path $pkg" | sed -n 's/^package://p' | grep -m1 '\.apk$' || true)"
  [[ -n "$path" ]] || return 0
  # Read it through Android: installs aren't reliably visible in the host
  # side of Lepton's /data overlay.
  apk="$(mktemp --suffix=.apk)"
  asx "cat '$path'" >"$apk" || true
  mkdir -p "${SYS}/icons"
  mapfile -t meta < <(python3 "$APK_INFO" "$apk" "$icon" 2>/dev/null || true)
  rm -f "$apk"
  activity="${meta[2]:-}"
  [[ -n "$activity" ]] || return 0   # nothing to open (services, libraries)
  label="${meta[1]:-$pkg}"
  [[ -f "$icon" ]] || icon=android-package-archive
  desktop="${DESKTOP_DIR}/pbos-android-${pkg}.desktop"
  mkdir -p "$DESKTOP_DIR"
  cat >"$desktop" <<EOF
[Desktop Entry]
Type=Application
Name=${label}
Comment=Android app (${pkg})
Exec=/usr/bin/pbos-apk run ${pkg}
Icon=${icon}
Categories=Game;
EOF
  grep -qx "$pkg" "${SYS}/titles" 2>/dev/null && return 0
  if steam_add "$desktop" "$pkg"; then
    echo "$pkg" >>"${SYS}/titles"
    say "${label} added to your Steam library."
  fi
  return 0
}

# Is there a Steam shortcut for this package (or "gapps": Add Google Play)?
# Steam stores a .desktop add as exe "/usr/bin/pbos-apk" (what add_title
# writes, see there), LaunchOptions '"run" "<pkg>"' and the .desktop as
# ShortcutPath.
steam_has() {
  local a=("\"run\" \"$1\"" "pbos-android-$1.desktop")
  [[ "$1" == gapps ]] && a=('"gapps"' "${GP_DESKTOP##*/}")
  grep -qaF -e "${a[0]}" -e "${a[1]}" \
    "${HOME}"/.local/share/Steam/userdata/*/config/shortcuts.vdf 2>/dev/null
}

# Add a shortcut and confirm Steam actually took it. steamos-add-to-steam
# only hands Steam a steam:// URL and always succeeds; before the user has
# signed in and the library is up (first boot) Steam drops it silently.
steam_add() {
  local desktop="$1" pkg="$2" i
  steam_has "$pkg" && return 0
  pgrep -x steam >/dev/null 2>&1 || return 1
  compgen -G "${HOME}/.local/share/Steam/userdata/[1-9]*/config/localconfig.vdf" >/dev/null || return 1
  steamos-add-to-steam "$desktop" >/dev/null 2>&1 || return 1
  for ((i = 0; i < 15; i++)); do
    sleep 2
    steam_has "$pkg" && return 0
  done
  return 1
}

# New apps get a title, uninstalled ones lose their desktop entry.
sync_titles() {
  local pkgs pkg f
  pkgs="$(asx "pm list packages -3" | sed -n 's/^package://p' || true)"
  [[ -n "$pkgs" ]] || pkgs=""
  pkgs+=$'\n'"$(system_titles)"
  # Keyboards have a settings screen but aren't something to launch.
  pkgs="$(grep -vxF -f <(asx "ime list -a -s" | cut -d/ -f1 || true) <<<"$pkgs" || true)"
  for pkg in $pkgs; do
    f="${DESKTOP_DIR}/pbos-android-${pkg}.desktop"
    if [[ ! -f "$f" ]]; then
      add_title "$pkg"
    elif ! grep -qx "$pkg" "${SYS}/titles" 2>/dev/null; then
      steam_add "$f" "$pkg" && echo "$pkg" >>"${SYS}/titles"
    fi
  done
  for f in "${DESKTOP_DIR}"/pbos-android-*.desktop; do
    [[ -f "$f" ]] || continue
    pkg="${f##*/pbos-android-}"; pkg="${pkg%.desktop}"
    grep -qx "$pkg" <<<"$pkgs" || rm -f "$f"
  done
  update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true
}

# Link the current pads into Android's /dev/input. EventHub watches that
# dir for create/delete, so relinking whenever a node changes (Steam
# recreates its virtual pad per launch) acts as a hot-plug.
PADS=""
sync_pads() {
  local ev want="" cmd="rm -f /dev/input/event*;"
  for ev in $(gamepad_nodes); do
    want+="${ev}:$(stat -c %i "/dev/input/${ev}") "
    cmd+=" ln -s /dev/host-input/${ev} /dev/input/${ev};"
  done
  [[ "$want" == "$PADS" ]] && return 0
  asx "$cmd" && PADS="$want"
}

# PB-OS Keyboard (external-and-mods/pbos-android/keyboard) logs "show" when a
# text field wants a keyboard: open Steam's, which types into Android through
# gamescope. On the Thor, Barry's keyboard takes the place of Steam's. "hide"
# (the app or Android wants the keyboard gone: focus left the field, a search
# was sent) closes it, unless "show" follows at once: moving from one field
# to the next doesn't flash it.
steam_keyboard() {
  DISPLAY="${DISPLAY:-:0}" steam -ifrunning "steam://$1/keyboard" >/dev/null 2>&1 &
}

keyboard_watch() {
  local line closing="" rc
  asx "logcat -v raw -s PbosKeyboard:I -T '$(date +%s).000'" | while :; do
    if [[ -n "$closing" ]]; then
      read -r -t 0.15 line && rc=0 || rc=$?
      if ((rc > 128)); then closing=""; steam_keyboard close; continue; fi
      ((rc == 0)) || break
    else
      read -r line || break
    fi
    case "$line" in
      show) closing=""; steam_keyboard open ;;
      hide) closing=1 ;;
    esac
  done
}

# --- commands ---------------------------------------------------------------

# pbos-android.service body.
cmd_daemon() {
  migrate_old_names
  ensure_lepton
  patch_lepton
  ensure_vrpaths
  mkdir -p "${SYS}/app" "${SYS}/data" "${SYS}/shadercache/fozpipelinesv6"
  touch "${SYS}/app/lepton-show-flatscreen"
  rm -f "$READY" "$MODE"
  local google="" fixed="" ver
  ver="$(lepton_ver)"
  google_on && google=1
  [[ -d "${FIXES}/lepton-${ver}" ]] && fixed=1

  export SteamAppId=pbos-android
  export STEAM_COMPAT_INSTALL_PATH="${SYS}/app"
  export STEAM_COMPAT_CLIENT_INSTALL_PATH="${HOME}/.local/share/Steam"
  export STEAM_COMPAT_DATA_PATH="${SYS}/data"
  export STEAM_COMPAT_LIBRARY_PATHS="${SYS}"
  export STEAM_COMPAT_SHADER_PATH="${SYS}/shadercache"
  export STEAM_FOSSILIZE_DUMP_PATH="${SYS}/shadercache/fozpipelinesv6/steamapp_pipeline_cache"
  # Never let Lepton wipe the shared /data (it does on "early exit").
  export LEPTON_NO_CLEANUP=true
  # Apps stay in /data/app (see patch_lepton). Files that earlier starts moved
  # into Lepton's one-app layer belong to apps Android has already dropped.
  export PBOS_SHARED_ANDROID=1
  [[ -n "$(ls -A "${SYS}/data/baked/app_overlay" 2>/dev/null)" ]] \
    && podman unshare rm -rf "${SYS}/data/baked/app_overlay" "${SYS}/data/baked/app_workdir"
  export GAMESCOPE_WAYLAND_DISPLAY="${PBOS_ANDROID_DISPLAY:-$(current_display)}"
  export PBOS_LEPTON_GOOGLE="$google"
  # Rootless podman puts the container in its own libpod scope; gamescope
  # shows the shared Android's window for the running Steam title only when
  # it comes from pbos-android.service. Keep the container in this unit.
  mkdir -p "${HOME}/.local/share/pbos-apk"
  printf '[containers]\ncgroups = "split"\n' >"${HOME}/.local/share/pbos-apk/containers.conf"
  export CONTAINERS_CONF_OVERRIDE="${HOME}/.local/share/pbos-apk/containers.conf"

  local lepton_pid="" i
  trap 'rm -f "$READY"; [[ -z "$lepton_pid" ]] || { kill -TERM "$lepton_pid" 2>/dev/null; wait "$lepton_pid"; }; exit 0' TERM INT
  boot_android() {
    export PBOS_LEPTON_OVERLAY="$(overlay_dirs)"
    "$LEPTON" waitforexitandrun &
    lepton_pid=$!
    for ((i = 0; i < 150; i++)); do
      [[ "$(asx "getprop sys.boot_completed" || true)" == 1 ]] && return 0
      kill -0 "$lepton_pid" 2>/dev/null || exit 1
      sleep 2
    done
  }
  boot_android

  # No framework fixes for this Lepton yet (first start, or Valve updated
  # Lepton): build them in this Android, then boot it again with them, before
  # anything opens in it. A failed build is tried again a day later, or right
  # away by "Add Google Play".
  if [[ -z "$fixed" && -z "$(find "${FIXES}/failed-${ver}" -mmin -1440 2>/dev/null)" ]]; then
    echo building >"$MODE"
    say "Setting up Android for this version. The first start takes a few minutes…"
    if build_fixes; then
      fixed=1
      kill -TERM "$lepton_pid" 2>/dev/null || true
      wait "$lepton_pid" || true
      boot_android
    else
      mkdir -p "$FIXES"
      touch "${FIXES}/failed-${ver}"
      say "Couldn't finish setting up Android for this version: apps that use the clipboard may close at start."
    fi
  fi
  # Lepton ships no keyboard. PB-OS's opens the device's own; to Android it
  # is a hardware keyboard (the Wayland one).
  asx 'ime enable '"$PBOS_IME"'; ime set '"$PBOS_IME"';
       settings put secure show_ime_with_hard_keyboard 0' >/dev/null || true
  if [[ -n "$google" ]]; then
    # Google Play's touch keyboard stays available in Android's settings.
    asx 'ime enable '"$IME" >/dev/null || true
  else
    # No Google Play: updates of the Google apps that earlier PB-OS builds
    # shipped stay in /data as plain apps, and would come back as titles.
    asx 'for p in '"${GOOGLE_PKGS[*]}"'; do pm path $p >/dev/null 2>&1 && pm uninstall $p; done' >/dev/null || true
    sed -i '/^com\.android\.vending$/d' "${SYS}/titles" 2>/dev/null || true
  fi
  # No setup wizard runs here, and Android ignores Home ("user setup is in
  # progress") until setup is marked done. It gets reset, so set it each boot.
  asx 'settings put secure user_setup_complete 1; settings put global device_provisioned 1' >/dev/null || true
  # Google checked this Android in under the old, uncertified identity. With
  # no account signed in yet, clear that so it checks in again as certified.
  if [[ -n "$google" && "$(cat "${SYS}/props-rev" 2>/dev/null)" != "$PROPS_REV" ]]; then
    if ! asx 'dumpsys account' | grep -qE 'Account \{name=.*, type=com\.google\}'; then
      asx 'pm clear com.google.android.gsf; pm clear com.google.android.gms; pm clear com.android.vending' >/dev/null || true
    fi
    echo "$PROPS_REV" >"${SYS}/props-rev"
  fi
  echo "$GAMESCOPE_WAYLAND_DISPLAY" >"$READY"

  keyboard_watch &
  if [[ -n "$fixed" ]]; then
    echo "${google:+google}-fixed" >"$MODE"
  else
    echo failed >"$MODE"
  fi

  # Pads every 3 s; titles for apps installed from inside Android (Play
  # Store, F-Droid…) every 15 s.
  for ((i = 0; ; i++)); do
    kill -0 "$lepton_pid" 2>/dev/null || break
    sync_pads || true
    ((i % 5)) || sync_titles || true
    sleep 3 &
    wait $! || true
  done
  rm -f "$READY"
  wait "$lepton_pid"
}

# Unpack FILE into DIR as base.apk (+ splits) and obb/.
unpack() {
  local src="$1" tmp="$2" f p
  case "${src,,}" in
    *.apk)
      cp "$src" "$tmp/base.apk"
      ;;
    *.apkm|*.xapk|*.apks|*.zip)
      mkdir "$tmp/x"
      unzip -qq -o "$src" -d "$tmp/x" 2>/dev/null ||
        7z x -y -bso0 -bsp0 -o"$tmp/x" "$src" ||
        die "can't unpack $(basename "$src") (older password-protected .apkm files aren't supported)"
      # Bundletool .apks keep splits under splits/; the rest are flat.
      while IFS= read -r -d '' f; do cp "$f" "$tmp/"; done \
        < <(find "$tmp/x" -type f -iname '*.apk' -print0)
      [[ -f "$tmp/base.apk" || ! -f "$tmp/base-master.apk" ]] || mv "$tmp/base-master.apk" "$tmp/base.apk"
      if [[ ! -f "$tmp/base.apk" ]]; then
        # XAPK: base is named <package>.apk
        p="$(jq -r '.package_name // empty' "$tmp/x/manifest.json" 2>/dev/null || true)"
        [[ -n "$p" && -f "$tmp/$p.apk" ]] && mv "$tmp/$p.apk" "$tmp/base.apk"
      fi
      [[ -f "$tmp/base.apk" ]] || die "no base APK in $(basename "$src")"
      if [[ -d "$tmp/x/Android/obb" ]]; then
        mkdir -p "$tmp/obb"
        find "$tmp/x/Android/obb" -type f -name '*.obb' -exec cp {} "$tmp/obb/" \;
      fi
      rm -rf "$tmp/x"
      ;;
    *) die "unsupported file: $(basename "$src") (use .apk, .apkm, .xapk or .apks)" ;;
  esac
}

# Subshell: die/trap stay local to one file.
cmd_install() (
  local src tmp meta pkg apks=() size sid f n=0
  src="$(realpath -- "$1")"
  [[ -f "$src" ]] || die "no such file: $1"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  unpack "$src" "$tmp"

  mapfile -t meta < <(python3 "$APK_INFO" "$tmp/base.apk" 2>/dev/null || true)
  pkg="${meta[0]:-}"
  [[ "$pkg" =~ ^[A-Za-z0-9_.]+$ ]] || die "can't read the package name from $(basename "$src")"

  ensure_android
  apks=("$tmp/base.apk")
  for f in "$tmp"/*.apk; do [[ "$f" == "$tmp/base.apk" ]] || apks+=("$f"); done
  # Stream into a PackageInstaller session (works for splits too).
  size=0
  for f in "${apks[@]}"; do size=$((size + $(stat -c %s "$f"))); done
  sid="$(asx "pm install-create -r -g -S $size" | sed -n 's/.*\[\([0-9]*\)\].*/\1/p' || true)"
  [[ -n "$sid" ]] || die "Android refused to install $(basename "$src")"
  for f in "${apks[@]}"; do
    asx "pm install-write -S $(stat -c %s "$f") $sid $((n++)).apk -" <"$f" >/dev/null ||
      die "copying $(basename "$src") into Android failed"
  done
  asx "pm install-commit $sid" | grep -q Success || die "Android couldn't install $(basename "$src")"
  if [[ -d "$tmp/obb" ]]; then
    asx "mkdir -p /sdcard/Android/obb/$pkg" || true
    for f in "$tmp"/obb/*.obb; do
      asx "cat > /sdcard/Android/obb/$pkg/${f##*/}" <"$f" || die "copying $(basename "$f") failed"
    done
  fi
  asx "appops set $pkg REQUEST_INSTALL_PACKAGES allow" >/dev/null || true
  add_title "$pkg"
  say "Installed ${meta[1]:-$pkg}."
)

# PBOS_ANDROID_APPID on gamescope's root window: which Steam title the
# shared Android window belongs to (0 = none).
set_window_appid() {
  [[ -n "${DISPLAY:-}" ]] || return 0
  xprop -root -f PBOS_ANDROID_APPID 32c -set PBOS_ANDROID_APPID "$1" 2>/dev/null || true
}

schedule_idle_stop() {
  systemctl --user stop pbos-android-idle.timer 2>/dev/null || true
  systemd-run --user --quiet --collect --unit=pbos-android-idle --on-active=600 \
    /usr/bin/pbos-apk idle-stop >/dev/null 2>&1 || true
}

cmd_run() {
  local pkg="$1" comp appid focus gone=0 home=0 f
  [[ "$pkg" =~ ^[A-Za-z0-9_.]+$ ]] || die "bad package name: $pkg"
  ensure_android
  if ! asx "pm path $pkg" | grep -q '^package:'; then
    # A title from before the shared Android: install its old copy.
    f="$(compgen -G "${APPS}/${pkg}/base.apk" || true)"
    [[ -n "$f" ]] || die "${pkg} isn't installed"
    cmd_install "$f"
  fi
  comp="$(asx "cmd package resolve-activity --brief -c android.intent.category.LAUNCHER $pkg" | tail -n1 || true)"
  [[ "$comp" == */* ]] || die "${pkg} has nothing to open"

  # Tell gamescope the shared Android window belongs to this Steam title.
  appid="$(steam_launch_appid)"
  set_window_appid "${appid:-0}"
  # Toggling "install unknown apps" at runtime kills the app; grant it upfront.
  asx "appops set $pkg REQUEST_INSTALL_PACKAGES allow; am start -n $comp" >/dev/null || true

  # Steam counts a title as running while it owns a window, so hand the
  # shared Android window back on the way out or Exit Game never finishes.
  trap 'set_window_appid 0; asx "am force-stop '"$pkg"'" >/dev/null || true; schedule_idle_stop; exit 0' TERM INT HUP
  # Stay alive — Steam shows the title as running and keeps feeding the
  # controller to it — while the user is anywhere in Android (Home, Recents,
  # other apps). End when Steam's Exit Game kills us, or once the app has
  # really closed and the Android home screen is up.
  while android_up; do
    sleep 3
    if asx "pidof $pkg" >/dev/null; then gone=0; else gone=$((gone + 1)); fi
    if ((gone >= 2)); then
      focus="$(asx "dumpsys window | grep -m1 mCurrentFocus" || true)"
      if [[ "$focus" == *launcher3* ]]; then home=$((home + 1)); else home=0; fi
      ((home < 2)) || break
    fi
  done
  set_window_appid 0
  schedule_idle_stop
}

# Each login: a title to start from. "Add Google Play" until Google Play is
# added (only once: a user who deletes it keeps it deleted), then the Play
# Store. The PB-OS tab removes the one that no longer fits from Steam.
cmd_setup() {
  migrate_old_names
  if google_on; then rm -f "$GP_DESKTOP"; setup_store_title; else setup_gapps_title; fi
}

setup_gapps_title() {
  local i
  [[ -e "${SYS}/gapps-title" ]] && return 0
  mkdir -p "$SYS" "$DESKTOP_DIR"
  cat >"$GP_DESKTOP" <<EOF
[Desktop Entry]
Type=Application
Name=Add Google Play
Comment=Download Google Play from its sources and set it up for Android apps
Exec=/usr/bin/pbos-apk gapps
Icon=android-package-archive
Categories=Game;
EOF
  for ((i = 0; i < 360; i++)); do
    if steam_add "$GP_DESKTOP" gapps; then
      touch "${SYS}/gapps-title"
      return 0
    fi
    sleep 20
  done
  return 1
}

# Needs no running Android (Google Play's overlay has the APK).
setup_store_title() {
  local i desktop="${DESKTOP_DIR}/pbos-android-com.android.vending.desktop" icon="${SYS}/icons/com.android.vending.png"
  steam_has com.android.vending && return 0
  mkdir -p "${SYS}/icons" "$DESKTOP_DIR"
  python3 "$APK_INFO" "${GP_ROOT}/common/system/product/priv-app/Phonesky/Phonesky.apk" "$icon" >/dev/null 2>&1 || true
  [[ -f "$icon" ]] || icon=android-package-archive
  cat >"$desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Google Play Store
Comment=Android app (com.android.vending)
Exec=/usr/bin/pbos-apk run com.android.vending
Icon=${icon}
Categories=Game;
EOF
  # First boot: Steam still has to be signed in and show the library. Keep
  # trying (2 h), and only record the title once Steam really has it.
  for ((i = 0; i < 360; i++)); do
    if steam_add "$desktop" com.android.vending; then
      grep -qx com.android.vending "${SYS}/titles" 2>/dev/null \
        || echo com.android.vending >>"${SYS}/titles"
      return 0
    fi
    sleep 20
  done
  return 1
}

# Add Google Play: fetch it, start Android with it (its first start builds
# the framework fixes and starts again with them), open the Play Store.
cmd_gapps() {
  local i tmp
  ensure_lepton
  rm -f "${FIXES}"/failed-*
  if ! google_on; then
    say "Downloading Google Play (about 230 MB)…"
    mkdir -p "$GP_ROOT"
    tmp="$(mktemp -d "${GP_ROOT}/.new.XXXXXX")"
    if ! python3 -I "$GP_FETCH" common "$tmp" >&2; then
      rm -rf "$tmp"
      die "Couldn't download Google Play. Check the internet connection and launch Add Google Play again."
    fi
    rm -rf "${GP_ROOT}/common"
    mv "${tmp}/common" "${GP_ROOT}/common"
    rmdir "$tmp"
  fi
  [[ "$(cat "$MODE" 2>/dev/null)" == google-fixed ]] && android_up \
    || systemctl --user stop pbos-android.service 2>/dev/null || true
  ensure_android
  for ((i = 0; i < 300; i++)); do
    case "$(cat "$MODE" 2>/dev/null)" in
      google-fixed) android_up && break ;;
      failed) die "Couldn't set up Google Play for this Android version. Launch Add Google Play to try again." ;;
    esac
    sleep 3
  done
  [[ "$(cat "$MODE" 2>/dev/null)" == google-fixed ]] && android_up \
    || die "Google Play setup didn't finish (journalctl --user -u pbos-android)."
  rm -f "$GP_DESKTOP"
  cmd_run com.android.vending
}

cmd_idle_stop() {
  pgrep -f "pbos-apk run " >/dev/null && return 0
  systemctl --user stop pbos-android.service
}

cmd_list() {
  local f pkg
  for f in "${DESKTOP_DIR}"/pbos-android-*.desktop; do
    [[ -f "$f" ]] || continue
    pkg="${f##*/pbos-android-}"
    printf '%-40s %s\n' "${pkg%.desktop}" "$(sed -n 's/^Name=//p' "$f")"
  done
}

cmd_remove() {
  local pkg="$1"
  [[ "$pkg" =~ ^[A-Za-z0-9_.]+$ ]] || die "bad package name: $pkg"
  ensure_android
  asx "pm uninstall $pkg" | grep -q Success || die "${pkg} isn't installed"
  rm -f "${DESKTOP_DIR}/pbos-android-${pkg}.desktop" "${SYS}/icons/${pkg}.png"
  sed -i "/^${pkg//./\\.}\$/d" "${SYS}/titles" 2>/dev/null || true
  say "Removed ${pkg}. Delete its title from the Steam library by hand."
}

cmd_inbox() {
  mkdir -p "$INBOX" "${APPS}/Failed"
  local f i
  # Titles need a running Steam (the path unit can fire right at login).
  for ((i = 0; i < 36 && !$(pgrep -xc steam || true); i++)); do sleep 5; done
  shopt -s nullglob
  # Everything leaves the inbox, or DirectoryNotEmpty= re-fires forever.
  for f in "$INBOX"/*; do
    # Let copies in progress finish.
    while (( $(date +%s) - $(stat -c %Y "$f") < 5 )); do sleep 2; done
    if cmd_install "$f"; then rm -f "$f"; else mv -f "$f" "${APPS}/Failed/"; fi
  done
}

case "${1:-}" in
  install) shift; (($#)) || die "usage: pbos-apk install FILE..."; for f; do cmd_install "$f"; done ;;
  run) [[ -n "${2:-}" ]] || die "usage: pbos-apk run PACKAGE"; cmd_run "$2" ;;
  store) google_on || die "Google Play isn't added yet: launch Add Google Play in the Steam library."
         cmd_run com.android.vending ;;
  gapps) cmd_gapps ;;
  list) cmd_list ;;
  remove) [[ -n "${2:-}" ]] || die "usage: pbos-apk remove PACKAGE"; cmd_remove "$2" ;;
  inbox) cmd_inbox ;;
  stop) systemctl --user stop pbos-android.service ;;
  daemon) cmd_daemon ;;
  idle-stop) cmd_idle_stop ;;
  setup) cmd_setup ;;
  *) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
