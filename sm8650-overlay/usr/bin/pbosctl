#!/usr/bin/env python3
"""pbosctl — control the KONKR Pocket FIT platform daemon (pbosd).

  pbosctl status
  pbosctl profile lowpower|balanced|next
  pbosctl rgb RRGGBB [brightness]     static stick colour
  pbosctl rgb breath RRGGBB | rainbow | off
  pbosctl mcu status|enable|disable   MCU UART driver (extra buttons + stick RGB; on by default)
  pbosctl buttons steam|system|status Custom Function + K: trackpad clicks Steam
                                       can remap (steam, default) or pbosd actions
                                       (system)
  pbosctl monitor                     print key/button events from the pads
                                       (find out what each extra button sends)
  pbosctl sleep deep|standby|status   deep (Pocket FIT default: full SoC sleep,
                                       ~0.36 W) or standby (Pocket S2 default:
                                       panel off, session frozen, ~1 W)
  pbosctl speaker boost|flat|status   speaker loudness chain (default: boost)
"""
from __future__ import annotations

import glob
import json
import os
import select
import struct
import subprocess
import sys

STATE = "/var/lib/pbosd/state.json"
BLACKLIST = "/etc/modprobe.d/konkr-mcu.conf"
S2IDLE = "/var/lib/pbosd/sleep-s2idle"    # kernel sleep forced on
STANDBY = "/var/lib/pbosd/sleep-standby"  # konkr-standby forced on
PROFILES = ("lowpower", "balanced")
LEGACY_PROFILES = {"silent": "lowpower", "turbo": "balanced"}
BUTTON_MODES = ("steam", "system")
SPEAKER_CONF = "/etc/wireplumber/wireplumber.conf.d/55-konkr-speaker.conf"


def need_root() -> None:
    if os.geteuid() != 0:
        os.execvp("sudo", ["sudo", sys.executable, *sys.argv])


def load() -> dict:
    try:
        with open(STATE, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {"profile": "balanced", "rgb": {"mode": "static", "color": "ff3c00", "brightness": 160}}


def save(st: dict) -> None:
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE + ".tmp", "w", encoding="utf-8") as fh:
        json.dump(st, fh, indent=2)
    os.replace(STATE + ".tmp", STATE)
    subprocess.run(["systemctl", "kill", "-s", "HUP", "pbosd.service"], check=False)


def rd(p: str) -> str:
    try:
        with open(p, encoding="utf-8") as fh:
            return fh.read().strip()
    except OSError:
        return "?"


def status() -> None:
    st = load()
    print(f"profile : {st.get('profile')}")
    print(f"rgb     : {st.get('rgb')}")
    for d in glob.glob("/sys/class/hwmon/hwmon*"):
        if rd(f"{d}/name") == "pwmfan":
            print(f"fan     : pwm {rd(d + '/pwm1')}/255  {rd(d + '/fan1_input')} rpm")
    for d in glob.glob("/sys/class/devfreq/*gpu*"):
        cur = rd(d + "/cur_freq")
        print(f"gpu     : {int(cur) // 1_000_000 if cur.isdigit() else cur} MHz "
              f"(max {int(rd(d + '/max_freq')) // 1_000_000} MHz, {rd(d + '/governor')})")
    for pol in sorted(glob.glob("/sys/devices/system/cpu/cpufreq/policy*")):
        print(f"{os.path.basename(pol):8}: cpus {rd(pol + '/related_cpus'):12} "
              f"{int(rd(pol + '/scaling_cur_freq')) // 1000} MHz  {rd(pol + '/scaling_governor')} "
              f"(max {int(rd(pol + '/scaling_max_freq')) // 1000} MHz)")
    temps = []
    for z in glob.glob("/sys/class/thermal/thermal_zone*"):
        t = rd(z + "/type")
        if t.startswith(("cpu", "gpu")):
            v = rd(z + "/temp")
            if v.lstrip("-").isdigit():
                temps.append(int(v) / 1000)
    if temps:
        print(f"soc temp: {max(temps):.1f} °C (hottest cpu/gpu zone)")
    mode = st.get("buttons_mode", "steam")
    print(f"buttons : {mode} ({'Steam Remap' if mode == 'steam' else 'pbosd actions'})")
    mcu = "loaded" if os.path.isdir("/sys/module/konkr_sysbtn") else "not loaded"
    print("sleep   :", sleep_status())
    print(f"mcu     : {mcu} ({'blacklisted' if os.path.exists(BLACKLIST) else 'enabled at boot'})")


def mcu(cmd: str) -> None:
    need_root()
    if cmd == "status":
        status()
        return
    if cmd == "enable":
        if os.path.exists(BLACKLIST):
            os.remove(BLACKLIST)
        r = subprocess.run(["modprobe", "konkr_sysbtn"], check=False)
        print("konkr_sysbtn loaded" if r.returncode == 0 else "modprobe failed")
        print("Press the extra buttons with `pbosctl monitor` to check the MCU answers.")
    elif cmd == "disable":
        with open(BLACKLIST, "w", encoding="utf-8") as fh:
            fh.write("# Pocket FIT MCU UART driver — opt-in (pbosctl mcu enable)\n"
                     "blacklist konkr_sysbtn\n")
        subprocess.run(["modprobe", "-r", "konkr_sysbtn"], check=False)
        print("konkr_sysbtn disabled")
    else:
        sys.exit(__doc__)


def sleep_status() -> str:
    r = subprocess.run(["/usr/lib/konkr/konkr-sleep-mode"], capture_output=True,
                       text=True, check=False)
    return "deep" if r.stdout.strip() == "kernel" else "standby"


def sleep_mode(cmd: str) -> None:
    if cmd == "status":
        print("sleep   :", sleep_status())
        return
    need_root()
    os.makedirs(os.path.dirname(S2IDLE), exist_ok=True)
    if cmd in ("deep", "s2idle"):  # s2idle: the old name for kernel sleep
        open(S2IDLE, "w").close()
        if os.path.exists(STANDBY):
            os.remove(STANDBY)
    elif cmd == "standby":
        open(STANDBY, "w").close()
        if os.path.exists(S2IDLE):
            os.remove(S2IDLE)
    else:
        sys.exit(__doc__)
    sleep_mode("status")


def speaker(cmd: str) -> None:
    off = SPEAKER_CONF + ".off"
    if cmd == "status":
        print("speaker :", "boost (+12 dB, limited)" if os.path.exists(SPEAKER_CONF) else "flat")
        return
    need_root()
    if cmd == "flat" and os.path.exists(SPEAKER_CONF):
        os.replace(SPEAKER_CONF, off)
    elif cmd == "boost" and os.path.exists(off):
        os.replace(off, SPEAKER_CONF)
    elif cmd not in ("flat", "boost"):
        sys.exit(__doc__)
    # WirePlumber runs in the user session; it rebuilds the sink on restart.
    for uid in os.listdir("/run/user"):
        if uid.isdigit() and uid != "0":
            subprocess.run(["systemctl", "--user", "-M", f"{uid}@", "restart",
                            "wireplumber.service"], capture_output=True)
    speaker("status")


def monitor() -> None:
    need_root()
    ev = struct.Struct("llHHi")
    fds = {}
    for e in glob.glob("/sys/class/input/event*"):
        name = rd(e + "/device/name")
        if any(k in name for k in ("X-Box", "Xbox", "KONKR", "AYANEO", "InputPlumber", "gpio-keys", "pm8941")):
            path = "/dev/input/" + os.path.basename(e)
            try:
                fds[os.open(path, os.O_RDONLY | os.O_NONBLOCK)] = f"{path} {name} [{rd(e + '/device/phys')}]"
            except OSError:
                pass
    for label in fds.values():
        print("watching", label)
    print("press buttons (Ctrl-C to quit)")
    try:
        while True:
            r, _, _ = select.select(list(fds), [], [])
            for fd in r:
                data = os.read(fd, ev.size * 64)
                for off in range(0, len(data) - ev.size + 1, ev.size):
                    _s, _u, t, code, val = ev.unpack_from(data, off)
                    if t == 1:
                        print(f"{fds[fd].split()[0]}  KEY code={code} {'down' if val else 'up'}")
    except KeyboardInterrupt:
        pass


def main() -> None:
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help", "help"):
        sys.exit(__doc__)
    if a[0] == "status":
        status()
    elif a[0] == "profile" and len(a) == 2:
        need_root()
        st = load()
        cur = LEGACY_PROFILES.get(st.get("profile"), st.get("profile"))
        name = LEGACY_PROFILES.get(a[1], a[1])
        if name == "next":
            i = PROFILES.index(cur) if cur in PROFILES else 0
            st["profile"] = PROFILES[(i + 1) % len(PROFILES)]
        elif name in PROFILES:
            st["profile"] = name
        else:
            sys.exit(__doc__)
        save(st)
        print("profile", st["profile"])
    elif a[0] == "rgb" and len(a) >= 2:
        need_root()
        st = load()
        rgb = st.setdefault("rgb", {})
        if a[1] in ("off", "rainbow"):
            rgb["mode"] = a[1]
        elif a[1] == "breath" and len(a) >= 3:
            rgb.update(mode="breath", color=a[2].lstrip("#").lower())
        else:
            rgb.update(mode="static", color=a[1].lstrip("#").lower())
            if len(a) >= 3:
                rgb["brightness"] = int(a[2])
        save(st)
    elif a[0] == "mcu" and len(a) == 2:
        mcu(a[1])
    elif a[0] == "buttons" and len(a) == 2:
        if a[1] == "status":
            print("buttons :", load().get("buttons_mode", "steam"))
            return
        if a[1] not in BUTTON_MODES:
            sys.exit(__doc__)
        need_root()
        st = load()
        st["buttons_mode"] = a[1]
        save(st)   # pbosd switches the InputPlumber map (restarts it if needed)
        print("buttons", a[1])
    elif a[0] == "sleep" and len(a) == 2:
        sleep_mode(a[1])
    elif a[0] == "speaker" and len(a) == 2:
        speaker(a[1])
    elif a[0] == "monitor":
        monitor()
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
