def migrate_from_konkrd() -> None:
    """Keep the settings of a konkrd install, and drop the old panels (KONKR
    Control, then PB-OS Control) once PB-OS Utils, which has their tabs now,
    is there: two panels would both drive the daemon. The updater removes
    them too; this covers anything that brought PB-OS Utils another way."""
    if os.path.isdir(LEGACY_STATE_DIR) and not os.path.exists(STATE):
        os.makedirs(STATE_DIR, exist_ok=True)
        for name in os.listdir(LEGACY_STATE_DIR):
            os.replace(f"{LEGACY_STATE_DIR}/{name}", f"{STATE_DIR}/{name}")
        log(f"moved {LEGACY_STATE_DIR} to {STATE_DIR}")
    if os.path.isdir(LEGACY_STATE_DIR) and not os.listdir(LEGACY_STATE_DIR):
        os.rmdir(LEGACY_STATE_DIR)
    if not os.path.isdir(f"{PLUGINS_DIR}/pbos-utils"):
        return
    gone = [n for n in ("konkr-control", "pbos-control") if os.path.isdir(f"{PLUGINS_DIR}/{n}")]
    for name in gone:
        shutil.rmtree(f"{PLUGINS_DIR}/{name}", ignore_errors=True)
        log(f"removed the old {name} plugin (PB-OS Utils has its tabs)")
    if gone:
        subprocess.run(["systemctl", "try-restart", "plugin_loader.service"], check=False)


def legacy_action(act: str) -> str:
    """Button actions saved before the Silent/Turbo/fan-boost removal."""
    if act == "fan-boost":
        return "none"
    if act.startswith("profile-") and act[8:] in LEGACY_PROFILES:
        return "profile-" + LEGACY_PROFILES[act[8:]]
    return act


def load_state() -> dict:
    try:
        with open(STATE, encoding="utf-8") as fh:
            st = json.load(fh)
    except (OSError, ValueError):
        st = {}
    st.setdefault("profile", "balanced")
    st.setdefault("rgb", {"mode": RGB_DEFAULT_MODE, "color": RGB_DEFAULT_COLOR, "brightness": 160})
    st.setdefault("fan", {"mode": "auto", "fixed": 50})
    st["fan"].pop("boost", None)             # fan boost was removed
    st.setdefault("power_led", True)
    st.setdefault("buttons", {"F13": "rgb-next", "F14": "profile-next"})
    if st.get("buttons_mode") not in BUTTON_MODES:
        st["buttons_mode"] = "steam"
    for key, act in st["buttons"].items():
        st["buttons"][key] = legacy_action(act)
    st["profile"] = LEGACY_PROFILES.get(st["profile"], st["profile"])
    if st["profile"] not in PROFILES:
        st["profile"] = "balanced"
    return st


def save_state(st: dict) -> None:
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(st, fh, indent=2)
    os.replace(tmp, STATE)


