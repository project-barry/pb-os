def apply_buttons_mode(mode: str) -> None:
    """Install the MCU button map for `mode`; restart InputPlumber only when it
    changed. InputPlumber profiles cannot translate to or from trackpad
    clicks, so this cannot be a runtime profile switch."""
    want = rd(SYSBTN_VARIANT.format(mode if mode in BUTTON_MODES else "steam"))
    if not want:
        log(f"buttons: missing {SYSBTN_VARIANT.format(mode)}")
        return
    if rd(SYSBTN_ACTIVE) == want:
        return
    tmp = SYSBTN_ACTIVE + ".tmp"
    try:
        os.makedirs(os.path.dirname(SYSBTN_ACTIVE), exist_ok=True)
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write(want + "\n")
        os.chmod(tmp, 0o644)
        os.replace(tmp, SYSBTN_ACTIVE)
    except OSError as exc:
        log(f"buttons: cannot write {SYSBTN_ACTIVE}: {exc}")
        return
    subprocess.run(["systemctl", "try-restart", "inputplumber.service"], check=False)
    log(f"buttons: {mode} mode (InputPlumber restarted)")
INPUT_EVENT = struct.Struct("llHHi")


def log(msg: str) -> None:
    print(f"pbosd: {msg}", flush=True)


def rd(path: str, default: str = "") -> str:
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read().strip()
    except OSError:
        return default


def wr(path: str, value) -> bool:
    try:
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(str(value))
        return True
    except OSError:
        return False


