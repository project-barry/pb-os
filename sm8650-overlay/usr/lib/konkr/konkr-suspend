#!/bin/sh
# systemd-suspend.service ExecStart on the KONKR Pocket FIT.
# KONKR Pocket FIT: deep sleep (full SoC sleep, ~0.36 W, 2026-10-07) prepared
# by konkr-sleep.service; konkr-standby (panel off, session frozen, big cores
# offline, ~1.1 W) on the AYANEO Pocket S2 or after `pbosctl sleep standby`
# (konkr-sleep-mode decides). konkr-standby drives the Pocket FIT / Pocket S2
# hardware (same AYANEO platform); every other device (Retroid Pocket 6, …)
# gets the stock kernel suspend.
if ! grep -qaE "KONKR Pocket FIT|AYANEO Pocket S2" /sys/firmware/devicetree/base/model 2>/dev/null \
   || [ "$(/usr/lib/konkr/konkr-sleep-mode)" = kernel ]; then
  exec /usr/lib/systemd/systemd-sleep suspend
fi
exec /usr/lib/konkr/konkr-standby
