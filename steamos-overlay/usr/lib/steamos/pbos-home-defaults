#!/bin/bash
# PB-OS defaults for the user's home, put in place at login. Nothing that
# exists is ever replaced: a file the user (or an app) already has stays as
# it is, so changing a setting in the app itself always wins.
#
# - Steam ROM Manager: parsers for the App Store's emulators, one for
#   ~/Emulation/roms/<system> and one for Emulation/roms/<system> on any
#   microSD card (EmuDeck's folder layout), plus its Steam and RetroArch core
#   folders. From SRM's own community presets (GPL-3.0, see CREDITS.md).
# - ~/Emulation/roms/<system>: the empty folders those parsers read.
set -u

DEFAULTS=/usr/share/pb-os/home-defaults

# Copies a template with @HOME@ replaced, only when the target is missing.
seed() {
  local src="$1" dest="$2"
  [[ -e "$dest" || -L "$dest" ]] && return 0
  mkdir -p "$(dirname "$dest")" || return 0
  sed "s|@HOME@|$HOME|g" "$src" >"$dest.pbos-tmp" && mv -n "$dest.pbos-tmp" "$dest"
  rm -f "$dest.pbos-tmp"
}

srm="$HOME/.config/steam-rom-manager/userData"
seed "$DEFAULTS/steam-rom-manager/userConfigurations.json" "$srm/userConfigurations.json"
seed "$DEFAULTS/steam-rom-manager/userSettings.json" "$srm/userSettings.json"

while read -r folder; do
  [[ -n "$folder" ]] && mkdir -p "$HOME/Emulation/roms/$folder"
done <"$DEFAULTS/steam-rom-manager/rom-folders"
exit 0
