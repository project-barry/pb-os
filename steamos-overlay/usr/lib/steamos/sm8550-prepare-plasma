#!/bin/bash
# Switch to Desktop starts official Plasma in the same user systemd as Game Mode.
# start-gamescope-session used to import QT_QPA_PLATFORM=xcb into that manager;
# plasmashell/ksplash then try X11, fail, and leave kwin on a black DSI.
set -u

if [[ ! -d /tmp/.X11-unix ]]; then
  mkdir -p /tmp/.X11-unix
fi
# gamescope creates this dir without the sticky bit; kwin then refuses Xwayland.
chmod 1777 /tmp/.X11-unix 2>/dev/null || true

# Desktop rotation per device. The shipped kwinoutputconfig (Rotated270) suits
# panels with DT rotation 90 (Pocket FIT, AYN Thor); the Retroid Pocket 6
# panel is rotation 270 and needs Rotated90 or the desktop is upside down
# (Game Mode is fine: gamescope reads the DRM panel orientation itself).
# The Retroid Pocket Nova panel is landscape-native (no DT rotation), so it
# gets no rotation and its own 1280x960 mode in place of the 1080x1920 one.
# Done once, before KWin starts, so a rotation chosen later in Display
# Settings is kept.
seed_rotation() {
  local model want mode="" cfg marker
  model="$(tr -d '\0' </sys/firmware/devicetree/base/model 2>/dev/null)"
  case "$model" in
    "Retroid Pocket 6"*) want=Rotated90 ;;
    "Retroid Pocket Nova") want=Normal mode=1280x960 ;;
    *) return 0 ;;
  esac
  cfg="$HOME/.config/kwinoutputconfig.json"
  marker="${XDG_STATE_HOME:-$HOME/.local/state}/sm8550-kwin-rotation-seeded"
  [[ -f "$marker" || ! -f "$cfg" ]] && return 0
  python3 - "$cfg" "$want" "$mode" <<'PY2' && { mkdir -p "$(dirname "$marker")"; : >"$marker"; }
import json, sys
path, want, mode = sys.argv[1], sys.argv[2], sys.argv[3]
with open(path) as f:
    data = json.load(f)
for section in data:
    if section.get("name") == "outputs":
        for out in section.get("data", []):
            if out.get("connectorName") == "DSI-1":
                out["transform"] = want
                if mode:
                    w, h = mode.split("x")
                    out.setdefault("mode", {}).update(width=int(w), height=int(h))
with open(path, "w") as f:
    json.dump(data, f, indent=4)
PY2
}
seed_rotation

# Single-screen devices: Desktop Mode sized for fingers, at 150 % (125 % was
# small to tap) with Plasma's touch mode, which gives KDE apps and the panel
# bigger controls. Images ship 125 %; this raises it once, on the first
# Desktop start, also on devices that updated (an update never touches
# ~/.config). Only the shipped 125 % is raised: a scale picked in Display
# Settings stays. The shipped auto-rotation "in touch mode" becomes "never",
# so a panel with an orientation sensor does not turn with the device. The
# AYN Thor keeps its own two-screen layout (below).
seed_touch_desktop() {
  local cfg="$HOME/.config/kwinoutputconfig.json"
  local marker="${XDG_STATE_HOME:-$HOME/.local/state}/pbos-touch-desktop-seeded"
  [[ -f "$marker" ]] && return 0
  grep -qa 'ayn,thor' /sys/firmware/devicetree/base/compatible 2>/dev/null && return 0
  if [[ -f "$cfg" ]] && python3 - "$cfg" <<'PY'
import json, sys
path = sys.argv[1]
with open(path) as f:
    data = json.load(f)
raised = False
for section in data:
    if section.get("name") == "outputs":
        for out in section.get("data", []):
            if out.get("connectorName") != "DSI-1":
                continue
            if out.get("scale") == 1.25:
                out["scale"] = 1.5; raised = True
            if out.get("autoRotation") == "InTabletMode":
                out["autoRotation"] = "Never"
with open(path, "w") as f:
    json.dump(data, f, indent=4)
sys.exit(0 if raised else 1)
PY
  then
    # X11 apps (Steam's desktop window) and Qt's own setting follow the panel.
    kwriteconfig6 --file kwinrc --group Xwayland --key Scale 1.5
    kwriteconfig6 --file kdeglobals --group KScreen --key ScaleFactor 1.5
    kwriteconfig6 --file kdeglobals --group KScreen --key ScreenScaleFactors "DSI-1=1.5"
  fi
  case "$(kreadconfig6 --file kwinrc --group Input --key TabletMode 2>/dev/null)" in
    ""|auto) kwriteconfig6 --file kwinrc --group Input --key TabletMode on ;;
  esac
  mkdir -p "$(dirname "$marker")" && : >"$marker"
}
seed_touch_desktop

# Retroid Pocket Nova: its 1280x960 panel at 150 % leaves an 854x640 desktop,
# too zoomed in, so it gets 125 % (1024x768). X11 apps run at 100 %: Steam
# draws its on-screen keyboard 1280 px wide times the X11 scale, so anything
# above 100 % pushes it past the panel's edges (the RP6's 1920 px panel fits
# it at 150 %). Steam's keyboard is a dock window like the panel, so the panel
# and the launcher menu could cover it; a window rule makes it an on-screen
# display, which stays above both. Done once, also on Novas that already got
# 150 % (an update never touches ~/.config); only the 125 % or 150 % this
# image sets is changed, a scale picked in Display Settings stays.
seed_nova_desktop() {
  local cfg="$HOME/.config/kwinoutputconfig.json"
  local marker="${XDG_STATE_HOME:-$HOME/.local/state}/pbos-nova-desktop-seeded"
  local rule=steam-osk-above rules
  [[ -f "$marker" ]] && return 0
  [[ "$(tr -d '\0' </sys/firmware/devicetree/base/model 2>/dev/null)" == "Retroid Pocket Nova" ]] || return 0
  if [[ -f "$cfg" ]] && python3 - "$cfg" <<'PY'
import json, sys
path = sys.argv[1]
with open(path) as f:
    data = json.load(f)
ours = False
for section in data:
    if section.get("name") == "outputs":
        for out in section.get("data", []):
            if out.get("connectorName") == "DSI-1" and out.get("scale") in (1.25, 1.5):
                out["scale"] = 1.25; ours = True
with open(path, "w") as f:
    json.dump(data, f, indent=4)
sys.exit(0 if ours else 1)
PY
  then
    kwriteconfig6 --file kwinrc --group Xwayland --key Scale 1
    kwriteconfig6 --file kdeglobals --group KScreen --key ScaleFactor 1.25
    kwriteconfig6 --file kdeglobals --group KScreen --key ScreenScaleFactors "DSI-1=1.25"
  fi
  rules="$(kreadconfig6 --file kwinrulesrc --group General --key rules 2>/dev/null)"
  if [[ ",$rules," != *",$rule,"* ]]; then
    kwriteconfig6 --file kwinrulesrc --group "$rule" --key Description "Steam keyboard above the panel"
    kwriteconfig6 --file kwinrulesrc --group "$rule" --key title "Steam Input On-screen Keyboard"
    kwriteconfig6 --file kwinrulesrc --group "$rule" --key titlematch 1
    kwriteconfig6 --file kwinrulesrc --group "$rule" --key wmclass steam
    kwriteconfig6 --file kwinrulesrc --group "$rule" --key wmclasscomplete false
    kwriteconfig6 --file kwinrulesrc --group "$rule" --key wmclassmatch 1
    kwriteconfig6 --file kwinrulesrc --group "$rule" --key type 16
    kwriteconfig6 --file kwinrulesrc --group "$rule" --key typerule 2
    kwriteconfig6 --file kwinrulesrc --group "$rule" --key above true
    kwriteconfig6 --file kwinrulesrc --group "$rule" --key aboverule 2
    rules="${rules:+$rules,}$rule"
    kwriteconfig6 --file kwinrulesrc --group General --key rules "$rules"
    kwriteconfig6 --file kwinrulesrc --group General --key count "$(tr ',' '\n' <<<"$rules" | grep -c .)"
  fi
  mkdir -p "$(dirname "$marker")" && : >"$marker"
}
seed_nova_desktop

# AYN Thor: the shipped kwinoutputconfig knows one panel, so KWin meets two
# outputs it has no setup for. Seed the Thor's two-panel layout (top DSI-2
# primary, bottom DSI-1 centred under it) when the file has no DSI-2 yet; a
# layout saved later in Display Settings is kept. kded's kscreen module also
# keeps its own per-setup files, never saves them here, and then offers the
# "how to use the new display" picker whenever a panel reconnects; KWin
# restores the layout itself, so the module is switched off.
seed_thor_layout() {
  local cfg="$HOME/.config/kwinoutputconfig.json"
  local thor=/usr/share/steamos-sm8550/kwinoutputconfig-thor.json
  grep -qa 'ayn,thor' /sys/firmware/devicetree/base/compatible 2>/dev/null || return 0
  if [[ -f "$thor" ]] && ! grep -qs '"DSI-2"' "$cfg"; then
    mkdir -p "$HOME/.config"
    cp -f "$thor" "$cfg"
  fi
  kwriteconfig6 --file kded5rc --group Module-kscreen --key autoload false 2>/dev/null || true
}
seed_thor_layout

# AYN Thor: Game Mode silenced the bottom touchscreen; the desktop uses both.
if [[ -x /usr/lib/steamos-sm8550/sm8550-touch-inhibit ]]; then
  /usr/lib/steamos-sm8550/sm8550-touch-inhibit bottom_touchscreen 0
fi

unset QT_QPA_PLATFORM
unset GAMESCOPE_WAYLAND_DISPLAY
unset GAMESCOPE_SESSION_TARGET
export QT_QPA_PLATFORM=wayland
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=KDE
export XDG_SESSION_DESKTOP=KDE
export DESKTOP_SESSION=plasma

if command -v systemctl >/dev/null 2>&1; then
  # The portal left over from Game Mode sees XDG_CURRENT_DESKTOP=KDE below,
  # starts the KDE backend before there is a Wayland display, and that crash
  # (plus the restart) holds up Plasma's start. Plasma starts them itself.
  systemctl --user stop xdg-desktop-portal.service 'xdg-desktop-portal-*.service' \
    plasma-xdg-desktop-portal-kde.service 2>/dev/null || true
  systemctl --user reset-failed plasma-xdg-desktop-portal-kde.service 2>/dev/null || true
  systemctl --user unset-environment \
    QT_QPA_PLATFORM GAMESCOPE_WAYLAND_DISPLAY GAMESCOPE_SESSION_TARGET \
    XDG_DESKTOP_PORTAL_DIR || true
  systemctl --user set-environment \
    QT_QPA_PLATFORM=wayland \
    XDG_SESSION_TYPE=wayland \
    XDG_CURRENT_DESKTOP=KDE \
    XDG_SESSION_DESKTOP=KDE \
    DESKTOP_SESSION=plasma || true
fi

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd \
    QT_QPA_PLATFORM XDG_SESSION_TYPE XDG_CURRENT_DESKTOP \
    XDG_SESSION_DESKTOP DESKTOP_SESSION >/dev/null 2>&1 || true
fi
