#!/bin/bash
# Handheld session: SM8650 (KONKR Pocket FIT / AYANEO Pocket S2) and
# SM8550 (Odin 2 / Thor / Mini / Portal).
# Replaces the Steam Frame OpenVR gamescope command line.

# Create run directory file for startup and stats sockets
#   shellcheck disable=SC2030
tmpdir="$([[ -n ${XDG_RUNTIME_DIR+x} ]] && mktemp -p "$XDG_RUNTIME_DIR" -d -t gamescope.XXXXXXX)"
stats="${tmpdir:+$tmpdir/stats.pipe}"
#   shellcheck disable=SC2031
if [[ -z $tmpdir || -z ${XDG_RUNTIME_DIR+x} ]]; then
  echo >&2 "!! Failed to find run directory in which to create stats session sockets (is \$XDG_RUNTIME_DIR set?)"
  exit 0
fi

export GAMESCOPE_STATS="$stats"
mkfifo -- "$stats"

linkname="gamescope-stats"
#   shellcheck disable=SC2031
sessionlink="${XDG_RUNTIME_DIR:+$XDG_RUNTIME_DIR/}${linkname}"
lockfile="$sessionlink".lck
exec 9>"$lockfile"
if flock -n 9 && rm -f "$sessionlink" && ln -sf "$tmpdir" "$sessionlink"; then
  echo >&2 "Claimed global gamescope stats session at \"$sessionlink\""
else
  echo >&2 "!! Failed to claim global gamescope stats session"
fi

export GAMESCOPE_READY_NOTIFY_SOCKET="$NOTIFY_SOCKET"
unset NOTIFY_SOCKET

if [[ -f /usr/lib/steamos/gamescope-cleanup ]]; then
  # shellcheck disable=SC1091
  source /usr/lib/steamos/gamescope-cleanup
fi

export XCURSOR_THEME="${XCURSOR_THEME:-steam}"

# Performance overlay (mangoapp). mangoapp is GL; GL on the Frame image is
# zink-on-Turnip only, and zink must run on the Turnip it was built with.
# The SM8550 port swapped Turnip, mangoapp crashed, so it switched the
# overlay off. Here a wrapper (first in PATH, see steamos-sm8650/bin/mangoapp)
# pins mangoapp to the Frame's own Turnip, so the overlay works whatever
# Turnip games use. GAMESCOPE_MANGOAPP=0 turns it off.
MANGOAPP=0
if [[ -x /usr/bin/mangoapp ]]; then
  MANGOAPP=1
  if [[ -x /usr/lib/steamos-sm8650/bin/mangoapp ]]; then
    export PATH="/usr/lib/steamos-sm8650/bin:${PATH}"
  elif [[ -e /opt/stock-steamos/usr/lib/libvulkan_freedreno.so ]]; then
    MANGOAPP=0   # swapped Turnip and no pinned copy: would crash
  fi
fi
if [[ "${GAMESCOPE_MANGOAPP:-auto}" == 0 ]]; then MANGOAPP=0; fi
if [[ "$MANGOAPP" == 1 ]]; then
  export GAMESCOPE_MANGOAPP_SOCKET_DISABLE=0
  export STEAM_USE_MANGOAPP=1
  export STEAM_MANGOAPP_PRESETS_SUPPORTED=1
  export STEAM_MANGOAPP_HORIZONTAL_SUPPORTED=1
  export STEAM_DISABLE_MANGOAPP_ATOM_WORKAROUND=1
  MANGOHUD_CONFIGFILE="$(mktemp "$XDG_RUNTIME_DIR/mangohud.XXXXXXXX")"
  export MANGOHUD_CONFIGFILE
  # Steam writes presets into this file; start hidden.
  echo "no_display" >"$MANGOHUD_CONFIGFILE"
else
  export GAMESCOPE_MANGOAPP_SOCKET_DISABLE=1
fi
export QT_IM_MODULE="${QT_IM_MODULE:-xim}"
export GTK_IM_MODULE="${GTK_IM_MODULE:-xim}"
export QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME:-kde}"
# Compositor is Wayland (GAMESCOPE_WAYLAND_DISPLAY). Do not stamp
# XDG_SESSION_TYPE=wayland/x11 — Steam DisplayManager then leaves wayland: modeset.
unset XDG_SESSION_TYPE || true
export XDG_CURRENT_DESKTOP=gamescope
export XDG_SESSION_DESKTOP=gamescope
export DESKTOP_SESSION=gamescope
export QT_QPA_PLATFORM=xcb
export _STEAM_SETENV_MANAGER=1

export SteamDeck=1
export STEAM_MULTIPLE_XWAYLANDS=1
export STEAM_GAMESCOPE_HDR_SUPPORTED=0
export STEAM_ENABLE_VOLUME_HANDLER="${STEAM_ENABLE_VOLUME_HANDLER:-0}"
export SRT_URLOPEN_PREFER_STEAM=1
export ENABLE_GAMESCOPE_WSI=1
export SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0
export vk_xwayland_wait_ready=false
export GAMESCOPE_DISABLE_ASYNC_FLIPS=1
# MSM: KMS plane rotation is EINVAL on Adreno. Shader path is already in
# DRMBackend.cpp; keep it forced so a 0° probe cannot skip it.
# Portrait panel: rotate in the composite shader (safe everywhere). SM8650
# DPU can rotate UBWC buffers inline (ROCKNIX 0066); opt in with
# `pbosctl`-managed flag /var/lib/pbosd/kms-rotation, which lets gamescope
# scan games out directly instead of compositing every frame. Two failed
# starts in a row turn the flag off again.
KMS_ROT_FLAG=/var/lib/pbosd/kms-rotation
KMS_ROT_TRIES="$XDG_RUNTIME_DIR/gamescope-kms-rotation.tries"
KMS_ROTATION=0
DEVICE_MODEL="$(tr -d '\0' </sys/firmware/devicetree/base/model 2>/dev/null)"
# Pocket S2 1440x2560 exceeds the DPU inline rotator height limit.
if [[ -e "$KMS_ROT_FLAG" && "$DEVICE_MODEL" != "AYANEO Pocket S2" ]]; then
  tries="$(cat "$KMS_ROT_TRIES" 2>/dev/null || echo 0)"
  if (( tries >= 2 )); then
    echo >&2 "gamescope-session: KMS rotation failed twice, falling back to shader"
  else
    echo $((tries + 1)) >"$KMS_ROT_TRIES"
    KMS_ROTATION=1
  fi
fi
if [[ "$KMS_ROTATION" == 1 ]]; then
  export GAMESCOPE_KMS_ROTATION=1
  unset GAMESCOPE_USE_ROTATION_SHADER
else
  export GAMESCOPE_USE_ROTATION_SHADER=1
fi
# External DP/HDMI output: gamescope switches to it when connected.
# GAMESCOPE_FORCE_INTERNAL=1 keeps Game Mode on the panel instead. Our
# gamescope fork also skips external connectors whenever a DSI panel is
# connected (drm_skip_external_connectors) unless GAMESCOPE_ALLOW_EXTERNAL is set.
export GAMESCOPE_FORCE_INTERNAL="${GAMESCOPE_FORCE_INTERNAL:-0}"
if [[ "$GAMESCOPE_FORCE_INTERNAL" != 1 ]]; then
  export GAMESCOPE_ALLOW_EXTERNAL="${GAMESCOPE_ALLOW_EXTERNAL:-1}"
fi
# Same physical size the working SM8550 session advertises (not connector mm).
export GAMESCOPE_FAKE_OUTPUT_MM="${GAMESCOPE_FAKE_OUTPUT_MM:-177x100}"
if [[ "$MANGOAPP" != 1 ]]; then
  export STEAM_USE_MANGOAPP=0
  export STEAM_MANGOAPP_PRESETS_SUPPORTED=0
  export STEAM_MANGOAPP_HORIZONTAL_SUPPORTED=0
  export STEAM_DISABLE_MANGOAPP_ATOM_WORKAROUND=1
fi
export STEAM_GAMESCOPE_VRR_SUPPORTED=1
export STEAM_GAMESCOPE_HAS_TEARING_SUPPORT=1
export STEAM_GAMESCOPE_TEARING_SUPPORTED=1
export STEAM_GAMESCOPE_DYNAMIC_FPSLIMITER=1
export STEAM_GAMESCOPE_NIS_SUPPORTED=1
export STEAM_GAMESCOPE_FANCY_SCALING_SUPPORT=1
export STEAM_USE_DYNAMIC_VRS=1
export STEAM_GAMESCOPE_COLOR_MANAGED=1
export STEAM_ALLOW_DRIVE_UNMOUNT=1
export STEAM_ALLOW_DRIVE_ADOPT=1

export VK_ICD_FILENAMES="${VK_ICD_FILENAMES:-/usr/share/vulkan/icd.d/freedreno_icd.aarch64.json}"
export VK_DRIVER_FILES="${VK_DRIVER_FILES:-$VK_ICD_FILENAMES}"
export SDL_GAMECONTROLLERCONFIG_FILE="${SDL_GAMECONTROLLERCONFIG_FILE:-/etc/sdl2/qcom-gamecontrollerdb.txt}"
export SDL_VIDEO_X11_DGAMOUSE=0

# Native rsinput sticks: kernel reports ~±1408; emulators need ±740.
if [[ -x /usr/lib/steamos/sm8550-fixpad ]]; then
  /usr/lib/steamos/sm8550-fixpad apply 740 >/dev/null 2>&1 || true
fi

PANEL_W=1080
PANEL_H=1920
OUTPUT="${GAMESCOPE_OUTPUT:-}"
if [[ -z "$OUTPUT" ]]; then
  best_area=0
  for card in /sys/class/drm/card*-DSI-* /sys/class/drm/card*-eDP-*; do
    [[ -e "$card/status" ]] || continue
    [[ "$(cat "$card/status" 2>/dev/null || true)" == connected ]] || continue
    base="$(basename "$card")"
    name="${base#*-}"
    mode="$(head -1 "$card/modes" 2>/dev/null || true)"
    if [[ "$mode" =~ ^([0-9]+)x([0-9]+) ]]; then
      w="${BASH_REMATCH[1]}"
      h="${BASH_REMATCH[2]}"
      area=$((w * h))
      if (( area > best_area )); then
        best_area=$area
        OUTPUT="$name"
        PANEL_W="$w"
        PANEL_H="$h"
      fi
    fi
  done
  OUTPUT="${OUTPUT:-DSI-1}"
fi

# Two panels (AYN Thor): gamescope takes the first backlight it finds, which is
# the bottom panel's, so Steam's slider dimmed the dark screen. Point it at the
# backlight of the panel it drives (DSI-1 = mdss_dsi0 @ ae94000, DSI-2 =
# mdss_dsi1 @ ae96000; Armada's ayn-thor.conf pairs them the same way).
if [[ -z "${GAMESCOPE_BACKLIGHT_PATH:-}" ]]; then
  backlights=(/sys/class/backlight/*)
  if (( ${#backlights[@]} > 1 )); then
    case "$OUTPUT" in
      DSI-1) bl=/sys/class/backlight/ae94000.dsi.0 ;;
      DSI-2) bl=/sys/class/backlight/ae96000.dsi.0 ;;
      *) bl= ;;
    esac
    if [[ -n "$bl" && -e "$bl" ]]; then
      export GAMESCOPE_BACKLIGHT_PATH="$bl"
    fi
  fi
fi

# AYN Thor: Game Mode drives the top panel (DSI-2) and lends the bottom one
# (DSI-1) to a companion started with sm8550-run-bottom, which also gets the
# bottom touchscreen (Armada's dual-screen design). Without the lease the
# bottom touchscreen is silenced instead, or taps on the dark panel would land
# on the top one.
BOTTOM_LEASE=0
if [[ "$OUTPUT" == DSI-2 && -e /sys/class/drm/card0-DSI-1 ]] \
  && grep -qa 'ayn,thor' /sys/firmware/devicetree/base/compatible 2>/dev/null \
  && [[ -x /usr/lib/steamos-sm8550/sm8550-run-bottom ]]; then
  BOTTOM_LEASE=1
fi
if [[ -x /usr/lib/steamos-sm8550/sm8550-touch-inhibit ]]; then
  /usr/lib/steamos-sm8550/sm8550-touch-inhibit bottom_touchscreen $(( ! BOTTOM_LEASE ))
fi

if [[ "$PANEL_H" -gt "$PANEL_W" ]]; then
  W="${GAMESCOPE_WIDTH:-$PANEL_H}"
  H="${GAMESCOPE_HEIGHT:-$PANEL_W}"
else
  W="${GAMESCOPE_WIDTH:-$PANEL_W}"
  H="${GAMESCOPE_HEIGHT:-$PANEL_H}"
fi
# Highest refresh the panel lists (Pocket FIT: 144/120/90/60 at one pixel
# clock, via kernel patch kernel-sm8650/patches/0003; ROCKNIX's driver alone
# lists only 144). gamescope collects every listed rate into its dynamic refresh
# table; --generate-drm-mode fixed keeps the pixel clock and stretches the
# vertical front porch for rates in between, like the listed modes do.
REFRESH_HZ="${GAMESCOPE_REFRESH:-}"
MIN_HZ=60
MAX_HZ=60
# ROCKNIX panel-ar14-144hz lists 144/120/90/60 Hz
if grep -qaE "KONKR Pocket FIT" /sys/firmware/devicetree/base/model 2>/dev/null; then
  MAX_HZ=144
fi
# AYN Thor top panel (Chipone ICNA35xx) lists 120 and 60 Hz; Barry Launcher's
# dashboard switches between them the way Steam's slider does.
if [[ "$OUTPUT" == DSI-2 ]] && grep -qa 'ayn,thor' /sys/firmware/devicetree/base/compatible 2>/dev/null; then
  MAX_HZ=120
fi
# Start the Steam UI at 60 Hz: at 144 it redraws menus 144x/s, which roughly
# doubles UI GPU/CPU load (heat, fan, sluggishness). Steam's refresh slider
# (STEAM_DISPLAY_REFRESH_LIMITS) still reaches MAX_HZ per game.
REFRESH_HZ="${REFRESH_HZ:-60}"
if (( MAX_HZ > 60 )); then
  export STEAM_DISPLAY_REFRESH_LIMITS="${STEAM_DISPLAY_REFRESH_LIMITS:-${MIN_HZ},${MAX_HZ}}"
fi

GAMESCOPE_SESSION_TARGET="${GAMESCOPE_SESSION_TARGET:-gamescope-session.target}"
WATCH_SERVICE=""

# DRM backend = Wayland compositor + Xwayland. Steam paints on X11 (:0 / xcb).
# --backend wayland/sdl would nest inside another compositor and drop the panel.
GAMESCOPE_ARGS=(
  --backend drm
  --prefer-output "*,$OUTPUT"
  --force-windows-fullscreen
  --scaler fit
  --filter linear
  --steam
  --xwayland-count 2
  --adaptive-sync
  --default-touch-mode 4
  --hide-cursor-delay 3000
  --framerate-limit 0
  --max-scale 2
  --output-width "$W"
  --output-height "$H"
  --nested-width "$W"
  --nested-height "$H"
  --nested-refresh "$REFRESH_HZ"
  --generate-drm-mode fixed
  -T "$stats"
)

if (( BOTTOM_LEASE )); then
  GAMESCOPE_ARGS+=(--lease-connector DSI-1 --ignore-touch-device bottom_touchscreen)
fi
if [[ "$KMS_ROTATION" != 1 ]]; then
  # Shader rotation composites anyway; say so explicitly (MSM default).
  GAMESCOPE_ARGS+=(--use-rotation-shader --force-composition)
fi
if [[ "$MANGOAPP" == 1 ]]; then
  GAMESCOPE_ARGS+=(--mangoapp)
fi

  if [[ -f /usr/share/holo/holo-cursor.png ]]; then
  GAMESCOPE_ARGS+=(--cursor /usr/share/holo/holo-cursor.png --cursor-scale-height 720)
fi

if [[ "${GAMESCOPE_SESSION_TARGET}" != "gamescope-session.target" ]]; then
  WATCH_SERVICE="steamvr-nested-desktop.service"
fi

# Steam (steam.service) does not inherit this script's environment, and the
# gamescope-onready import races Steam's start: Steam then has no refresh-rate
# slider (only 144/n frame limits) and no STEAM_USE_MANGOAPP. Hand the Steam
# session vars over through a file steam.service reads at start.
env | grep -E '^(STEAM_DISPLAY_REFRESH_LIMITS|STEAM_USE_MANGOAPP|STEAM_MANGOAPP_[A-Z_]+|STEAM_DISABLE_MANGOAPP_ATOM_WORKAROUND|GAMESCOPE_MANGOAPP_SOCKET_DISABLE|MANGOHUD_CONFIGFILE)=' \
  >"$XDG_RUNTIME_DIR/gamescope-steam.env" 2>/dev/null || true

echo >&2 "gamescope-session: output=$OUTPUT panel=${PANEL_W}x${PANEL_H} nested=${W}x${H}@${REFRESH_HZ} mangoapp=${MANGOAPP} kms_rotation=${KMS_ROTATION}"

# The boot splash lets go of the panel now (it keeps its last frame up until
# gamescope draws); no-op when no splash is running.
systemctl start --no-ask-password pbos-splash-handoff.service >/dev/null 2>&1 || true

exec gamescope "${GAMESCOPE_ARGS[@]}" -- /usr/lib/steamos/gamescope-onready ${WATCH_SERVICE:-}
