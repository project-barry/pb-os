#!/usr/bin/env python3
"""Odin2 volume rocker: gpio-keys = VOLUP, pmic_resin = VOLDOWN → pactl.

Do not grab USB/Bluetooth keyboards, mice, or the gamepad.

On SM8550 the key can also reach us only through InputPlumber: on the
Retroid Pocket 6 gpio-keys carries the back paddles too, so InputPlumber owns
it and passes volume up on through its virtual keyboard. Steam shows its
volume indicator for that key but does not change the volume, so this
helper also reads "InputPlumber Keyboard" — only for keys no physical device
above already gives us, so nothing is applied twice.

Holding volume up or down keeps stepping until the button is let go: none of
these devices sends key repeats, so the helper repeats the step itself after
SM8550_VOLUME_HOLD_DELAY seconds, every SM8550_VOLUME_HOLD_INTERVAL seconds.
"""
from __future__ import annotations

import array
import fcntl
import glob
import os
import select
import struct
import subprocess
import sys
import time

EVENT_FMT = "llHHi"
EVENT_SIZE = struct.calcsize(EVENT_FMT)
EV_KEY = 0x01
KEY_MUTE = 113
KEY_VOLUMEDOWN = 114
KEY_VOLUMEUP = 115
STEP = os.environ.get("SM8550_VOLUME_STEP", "5%")
LIMIT = os.environ.get("SM8550_VOLUME_LIMIT", "1.0")
HOLD_DELAY = float(os.environ.get("SM8550_VOLUME_HOLD_DELAY", "0.4"))
HOLD_INTERVAL = float(os.environ.get("SM8550_VOLUME_HOLD_INTERVAL", "0.1"))
REPEAT_KEYS = (KEY_VOLUMEUP, KEY_VOLUMEDOWN)
ALLOW = ("gpio-keys", "pmic_resin")
IP_KEYBOARD = "inputplumber keyboard"
RESCAN_S = 3.0


def log(msg: str) -> None:
    print(f"sm8550-volume-keys: {msg}", flush=True)


def wpctl(*args: str) -> None:
    env = os.environ.copy()
    env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    try:
        subprocess.run(
            ["wpctl", *args],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2,
            env=env,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass


def device_name(path: str) -> str:
    name = os.path.basename(path)
    sysname = f"/sys/class/input/{name}/device/name"
    try:
        return open(sysname, encoding="utf-8", errors="ignore").read().strip()
    except OSError:
        return ""


def volume_keys(fd: int) -> set[int]:
    buf = array.array("B", [0] * 96)
    nr = 0x20 + EV_KEY
    ioc = (2 << 30) | (ord("E") << 8) | nr | (len(buf) << 16)
    try:
        fcntl.ioctl(fd, ioc, buf, True)
    except OSError:
        return set()
    return {c for c in (KEY_VOLUMEUP, KEY_VOLUMEDOWN, KEY_MUTE)
            if buf[c // 8] & (1 << (c % 8))}


def is_sm8550() -> bool:
    try:
        with open("/sys/firmware/devicetree/base/compatible", "rb") as f:
            return b"qcom,sm8550" in f.read()
    except OSError:
        return False


class Devices:
    """Physical volume devices, plus InputPlumber's keyboard for the keys
    they do not cover (SM8550 only). fd -> (path, keys to act on)."""

    def __init__(self, use_ip: bool):
        self.use_ip = use_ip
        self.fds: dict[int, tuple[str, set[int]]] = {}
        self.physical: set[int] = set()
        for path in sorted(glob.glob("/dev/input/event*")):
            dname = device_name(path).lower()
            if not any(a in dname for a in ALLOW):
                continue
            fd = self._open(path)
            if fd is None:
                continue
            keys = volume_keys(fd)
            if not keys:
                os.close(fd)
                continue
            log(f"watch {path} ({dname}) {sorted(keys)}")
            self.fds[fd] = (path, keys)
            self.physical |= keys
        self.ip_fd = None
        self.next_scan = 0.0
        # The held volume key and when it next repeats; at most one at a time.
        self.held: int | None = None
        self.next_repeat = 0.0
        self.held_from: dict[int, int] = {}

    @staticmethod
    def _open(path: str) -> int | None:
        try:
            return os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            return None

    def drop(self, fd: int) -> None:
        path, keys = self.fds.pop(fd, ("?", set()))
        self.held_from.pop(fd, None)
        os.close(fd)
        if fd == self.ip_fd:
            self.ip_fd = None
            log(f"lost {path}")

    def rescan_ip(self, now: float) -> None:
        """(Re)attach InputPlumber's keyboard; it comes and goes with its targets."""
        if not self.use_ip or self.ip_fd is not None or now < self.next_scan:
            return
        self.next_scan = now + RESCAN_S
        for path in sorted(glob.glob("/dev/input/event*")):
            if device_name(path).lower() != IP_KEYBOARD:
                continue
            fd = self._open(path)
            if fd is None:
                continue
            keys = volume_keys(fd) - self.physical
            if not keys:
                os.close(fd)
                return
            log(f"watch {path} (inputplumber keyboard) {sorted(keys)}")
            self.fds[fd] = (path, keys)
            self.ip_fd = fd
            return


def pactl(*args: str) -> str:
    env = os.environ.copy()
    env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    try:
        return subprocess.run(["pactl", *args], check=False, capture_output=True,
                              text=True, timeout=2, env=env).stdout
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return ""


def apply(code: int) -> None:
    # Step in the same (PulseAudio/cubic) scale as Steam's volume bar. wpctl
    # steps in a different scale: from ~20 % on the bar one "5 %-" step hit
    # zero and muted the sink.
    if code == KEY_VOLUMEUP:
        pactl("set-sink-mute", "@DEFAULT_SINK@", "0")
        cur = pactl("get-sink-volume", "@DEFAULT_SINK@")
        pct = int(cur.split("/")[1].strip().rstrip("%")) if "/" in cur else 0
        limit = int(float(LIMIT) * 100)
        pactl("set-sink-volume", "@DEFAULT_SINK@", f"{min(limit, pct + int(STEP.rstrip('%')))}%")
    elif code == KEY_VOLUMEDOWN:
        pactl("set-sink-volume", "@DEFAULT_SINK@", f"-{STEP}")
    elif code == KEY_MUTE:
        pactl("set-sink-mute", "@DEFAULT_SINK@", "toggle")


def key_event(devs: Devices, fd: int, code: int, value: int, now: float) -> None:
    if value == 1:
        apply(code)
        if code in REPEAT_KEYS:
            devs.held = code
            devs.held_from[fd] = code
            devs.next_repeat = now + HOLD_DELAY
    elif value == 0 and devs.held_from.get(fd) == code:
        del devs.held_from[fd]
        if devs.held == code:
            devs.held = None


def main() -> int:
    devs = Devices(use_ip=is_sm8550())
    if not devs.fds and not devs.use_ip:
        log("no gpio-keys/pmic_resin volume devices")
        return 0
    while True:
        now = time.monotonic()
        devs.rescan_ip(now)
        if devs.held is not None and devs.held not in devs.held_from.values():
            devs.held = None  # its device went away while held
        if devs.held is not None and now >= devs.next_repeat:
            apply(devs.held)
            devs.next_repeat = max(devs.next_repeat + HOLD_INTERVAL, now)
        timeout = 2.0 if devs.held is None else max(0.0, devs.next_repeat - time.monotonic())
        try:
            ready, _, _ = select.select(list(devs.fds), [], [], timeout)
        except InterruptedError:
            continue
        for fd in ready:
            try:
                data = os.read(fd, EVENT_SIZE * 8)
            except OSError:
                devs.drop(fd)
                continue
            if not data:
                devs.drop(fd)
                continue
            keys = devs.fds[fd][1]
            for off in range(0, len(data) - EVENT_SIZE + 1, EVENT_SIZE):
                _s, _us, etype, code, value = struct.unpack_from(EVENT_FMT, data, off)
                if etype == EV_KEY and code in keys:
                    key_event(devs, fd, code, value, time.monotonic())
    return 0


if __name__ == "__main__":
    sys.exit(main())
