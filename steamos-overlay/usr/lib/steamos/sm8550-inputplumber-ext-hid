#!/bin/bash
# If a real USB/Bluetooth keyboard or mouse is present, drop InputPlumber's
# virtual keyboard. Restore it when the last external HID is gone.
# Never treat InputPlumber's virtual Deck (deck-uhid via uhid, or deck via
# vhci_hcd; Valve 28de) as external — that restarts the composite in a loop
# and Steam never starts.
set -uo pipefail

LOCK=/run/sm8550-inputplumber-ext-hid.lock
exec 9>"$LOCK"
flock 9
sleep 0.35

is_virtual_or_deck() {
  local props="$1" name="$2"
  # uinput/uhid devices (InputPlumber's own keyboard and pads, deck-uhid) live
  # under /devices/virtual and report bus usb; real USB/BT HID never does.
  printf '%s\n' "$props" | grep -q '^DEVPATH=/devices/virtual/' && return 0
  # The deck target is a USB/IP device on vhci_hcd: bus usb, not virtual.
  printf '%s\n' "$props" | grep -q '^DEVPATH=.*/vhci_hcd' && return 0
  case "$name" in
    InputPlumber*|*"Valve Steam Deck"*|"Valve Corporation Steam Controller"*|*Gamepad*|*Motion*) return 0 ;;
  esac
  printf '%s\n' "$props" | grep -qE '^ID_VENDOR_ID=28de$|^ID_USB_VENDOR_ID=28de$' && return 0
  printf '%s\n' "$props" | grep -qE 'DEVPATH=.*/uhid|/virtual/misc/uhid' && return 0
  return 1
}

ext_hid_present() {
  local ev props name bus kbd mouse
  for ev in /sys/class/input/event*; do
    [[ -e "$ev" ]] || continue
    props="$(udevadm info -q property -p "$ev" 2>/dev/null)" || continue
    # udev keeps NAME on the parent input device, not the event node.
    name="$(cat "$ev/device/name" 2>/dev/null)"
    is_virtual_or_deck "$props" "$name" && continue
    kbd="$(printf '%s\n' "$props" | sed -n 's/^ID_INPUT_KEYBOARD=//p')"
    mouse="$(printf '%s\n' "$props" | sed -n 's/^ID_INPUT_MOUSE=//p')"
    [[ "$kbd" == 1 || "$mouse" == 1 ]] || continue
    bus="$(printf '%s\n' "$props" | sed -n 's/^ID_BUS=//p' | head -1)"
    if [[ "$bus" == usb || "$bus" == bluetooth ]] \
      || printf '%s\n' "$props" | grep -q '/bluetooth/'; then
      logger -t sm8550-inputplumber-ext-hid "external HID: $name (${ev##*/})"
      return 0
    fi
  done
  return 1
}

composite_ids() {
  local i found=0
  for i in 0 1 2 3; do
    if busctl --system get-property org.shadowblip.InputPlumber \
         "/org/shadowblip/InputPlumber/CompositeDevice${i}" \
         org.shadowblip.Input.CompositeDevice Name >/dev/null 2>&1 \
      || inputplumber device "$i" targets list >/dev/null 2>&1; then
      printf '%s\n' "$i"
      found=1
    fi
  done
  [[ "$found" -eq 1 ]] || printf '%s\n' 0
}

targets_have_keyboard() {
  local id="$1" listed
  listed="$(inputplumber device "$id" targets list 2>/dev/null)" || listed=""
  printf '%s\n' "$listed" | grep -qiE '(^|[[:space:]])keyboard([[:space:]]|$)'
}

# The composite's current gamepad target (deck or deck-uhid), so toggling the
# keyboard never switches the pad type. Empty while the composite is still
# bringing its targets up (the deck target's USB/IP device takes a moment).
gamepad_target() {
  local id="$1"
  inputplumber device "$id" targets list 2>/dev/null \
    | awk -F'│' 'NF > 3 { gsub(/ /, "", $2); print $2 }' \
    | grep -vxE 'Id|keyboard' | head -1
}

set_targets() {
  local id="$1"
  shift
  if inputplumber device "$id" targets set "$@" >/dev/null 2>&1; then
    return 0
  fi
  local n=$# path="/org/shadowblip/InputPlumber/CompositeDevice${id}"
  busctl --system call org.shadowblip.InputPlumber "$path" \
    org.shadowblip.Input.CompositeDevice SetTargetDevices as "$n" "$@" \
    >/dev/null 2>&1
}

ready=0
for _ in $(seq 1 25); do
  if inputplumber devices list >/dev/null 2>&1 \
    || busctl --system get-property org.shadowblip.InputPlumber \
         /org/shadowblip/InputPlumber/CompositeDevice0 \
         org.shadowblip.Input.CompositeDevice Name >/dev/null 2>&1; then
    ready=1
    break
  fi
  sleep 0.4
done
[[ "$ready" -eq 1 ]] || exit 0

if grep -qaE "retroidpocket,(rp6|rpnova)" /sys/firmware/devicetree/base/compatible 2>/dev/null; then
  # Retroid Pocket 6 and Nova: volume up shares gpio-keys with the back paddles, so it
  # only reaches the system through InputPlumber's keyboard. Keep that target
  # even with a real keyboard attached, or plugging one in kills volume up.
  want_kb=1
elif ext_hid_present; then
  want_kb=0
else
  want_kb=1
fi

# Every device: the real Steam Deck controller (deck, a USB/IP device):
# Steam knows it as a Steam Deck (its trackpads, which Barry Launcher's Deck
# controls on the AYN Thor use; emulator defaults bound to "Steam Deck
# Controller"), where deck-uhid is a generic controller to it. steamos-manager
# resets the composite to deck-uhid when it appears (71-sm8550-ext-hid.rules
# runs this then); put it back. Without USB/IP in the kernel: as it is.
want_pad=""
if modinfo vhci-hcd >/dev/null 2>&1; then
  want_pad=deck
fi

# steamos-manager resets every composite to deck-uhid once it is up (its
# inputplumber module, a moment after it is ready; D-Bus starts it, so unit
# ordering can't put this run after it). A Deck switched to before that
# reset is torn down while the kernel is still probing it, and InputPlumber
# then never feeds the new one: no controller until it restarts (a fast
# internal boot, 2026-10-24 Nova). So the switch to deck waits for the reset
# to be in InputPlumber's log, then for udev to settle. InputPlumber starts
# on deck-uhid too (its device configs), so the reset changes nothing.
SM_BUS=com.steampowered.SteamOSManager1
sm_reset_done() {
  systemctl cat steamos-manager.service >/dev/null 2>&1 || return 0
  gdbus wait --system --timeout 30 "$SM_BUS" >/dev/null 2>&1 || return 0
  local ready
  ready="$(systemctl show -p ActiveEnterTimestampMonotonic --value steamos-manager.service)"
  [[ "$ready" =~ ^[1-9][0-9]*$ ]] || return 0
  # Read through process substitution: bash doesn't wait for journalctl -f.
  python3 -c '
import json, sys
ready = int(sys.argv[1])
for line in sys.stdin:
    try:
        e = json.loads(line)
    except ValueError:
        continue
    m = e.get("MESSAGE")
    if isinstance(m, str) and int(e.get("__MONOTONIC_TIMESTAMP", 0)) > ready \
            and "Setting target devices" in m and "\"deck-uhid\"" in m:
        sys.exit(0)
sys.exit(1)' "$ready" < <(timeout 10 journalctl -b -f -n all -u inputplumber.service -o json \
      --output-fields=MESSAGE,__MONOTONIC_TIMESTAMP 2>/dev/null) && return 0
  logger -t sm8550-inputplumber-ext-hid "no steamos-manager reset seen in 10 s; switching anyway"
  return 0
}
sm_waited=0

# One controller per device: InputPlumber's first composite (the built-in pad,
# made at boot) is it. A second one (another config matching some of the same
# hardware, a device made later) would be a second controller to Steam and
# games; it keeps its devices (so they don't show raw) but gets the null
# target. InputPlumber only manages built-in devices (ManageAllDevices off),
# so a USB/Bluetooth controller someone plugs in is never touched.
primary_composite() {
  busctl --system get-property org.shadowblip.InputPlumber /org/shadowblip/InputPlumber/Manager \
    org.shadowblip.InputManager GamepadOrder 2>/dev/null \
    | grep -o 'CompositeDevice[0-9]*' | head -1 | sed 's/CompositeDevice//'
}

apply() {
  local id="$1" have_kb=0 pad=""
  targets_have_keyboard "$id" && have_kb=1
  for _ in $(seq 1 25); do
    pad="$(gamepad_target "$id")"
    [[ -n "$pad" ]] && break
    sleep 0.4
  done
  if [[ -z "$pad" ]]; then
    logger -t sm8550-inputplumber-ext-hid "composite $id: no gamepad target, left alone"
    return 1
  fi
  local new_pad="${want_pad:-$pad}"
  if [[ -n "$primary" && "$id" != "$primary" ]]; then
    if [[ "$pad" != null ]]; then
      logger -t sm8550-inputplumber-ext-hid "composite $id: a second controller; null target (composite $primary is the pad)"
      set_targets "$id" null || true
      return 1
    fi
    return 0
  fi
  [[ "$want_kb" -eq "$have_kb" && "$new_pad" == "$pad" ]] && return 0
  if [[ "$new_pad" == deck && "$pad" != deck && "$sm_waited" -eq 0 ]]; then
    sm_reset_done
    sm_waited=1
    udevadm settle -t 10 >/dev/null 2>&1 || true
    # The reset may have changed the targets meanwhile.
    pad="$(gamepad_target "$id")"
    targets_have_keyboard "$id" && have_kb=1 || have_kb=0
    [[ "$want_kb" -eq "$have_kb" && "$new_pad" == "$pad" ]] && return 0
  fi
  if [[ "$want_kb" -eq 1 ]]; then
    logger -t sm8550-inputplumber-ext-hid "composite $id: $new_pad + keyboard"
    set_targets "$id" "$new_pad" keyboard || true
  else
    logger -t sm8550-inputplumber-ext-hid "composite $id: $new_pad without keyboard"
    set_targets "$id" "$new_pad" || true
  fi
  return 1
}

# A second pass catches steamos-manager resetting a composite right after
# this one (it handles new composites asynchronously).
for pass in 1 2 3; do
  changed=0
  primary="$(primary_composite)"
  while read -r id; do
    [[ -n "$id" ]] || continue
    apply "$id" || changed=1
  done < <(composite_ids)
  [[ "$changed" -eq 0 ]] && break
  sleep 2
done
exit 0
