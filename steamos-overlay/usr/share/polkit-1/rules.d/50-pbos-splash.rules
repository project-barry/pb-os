// The session (user steamos) may start pbos-splash-handoff.service, which only
// runs `plymouth deactivate`, right before it launches its compositor.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "pbos-splash-handoff.service" &&
        action.lookup("verb") == "start" &&
        subject.user == "steamos") {
        return polkit.Result.YES;
    }
});
