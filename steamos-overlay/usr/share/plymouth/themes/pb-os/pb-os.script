top = Math.Int(Window.GetY() + Window.GetHeight() / 2 - 256);
cat = Sprite(tiles[0]);
cat.SetPosition(Math.Int(Window.GetX() + Window.GetWidth() / 2 - 195), top, 1);
words = Sprite(Image("words.png"));
words.SetPosition(Math.Int(Window.GetX() + Window.GetWidth() / 2 - 135), top + 442, 1);

tick = 0;
shown = 0;
fun refresh_callback ()
  {
    if (tick < 0)
      i = intro[tick];
    else
      i = loop[(tick - 0) % 90];
    if (i != shown)
      {
        cat.SetImage(tiles[i]);
        global.shown = i;
      }
    global.tick = tick + 1;
  }
Plymouth.SetRefreshFunction(refresh_callback);
