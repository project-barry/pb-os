#!/usr/bin/env bash
# Steam Gamepad UI OS-update hook. This image has no RAUC/atomupd payload.
#
#   --supports-duplicate-detection  → 0
#   --mark-oobe-only                → stamp CompletedOOBE, exit 0
#   check / apply                   → 7 (up to date)
#
# apply used to stamp CompletedOOBE and restart Steam during first boot,
# which threw away the rest of the setup (and on some installs skipped it
# entirely). Exit 7 lets the OOBE carry on to sign-in; Steam marks the
# OOBE complete itself. OS updates go through pbos-update instead.
set -uo pipefail

STEAM_HOME="${STEAM_HOME:-/home/steamos}"
REG_STEAM="${STEAM_HOME}/.steam/registry.vdf"
REG_LOCAL="${STEAM_HOME}/.local/share/Steam/registry.vdf"

mark_oobe_complete() {
  python3 - "$@" <<'PY' 2>/dev/null || true
import pathlib, re, sys

WANT = (("CompletedOOBE", "1"), ("CompletedOOBEStage1", "1"))
DROP = ("ForceOOBE", "ForceOOBEStage2")

def upsert(path: pathlib.Path) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    text = path.read_text(encoding="utf-8", errors="replace") if path.is_file() else ""
    if '"Steam"' not in text:
        lines = "\n".join(f'\t\t\t\t\t"{k}"\t\t"{v}"' for k, v in WANT)
        text = (
            '"Registry"\n{\n\t"HKCU"\n\t{\n\t\t"Software"\n\t\t{\n'
            '\t\t\t"Valve"\n\t\t\t{\n\t\t\t\t"Steam"\n\t\t\t\t{\n'
            f"{lines}\n"
            "\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n}\n"
        )
        path.write_text(text, encoding="utf-8")
        return

    for k in DROP:
        text = re.sub(r'^[ \t]*"' + re.escape(k) + r'"[ \t]*"[^"]*"[ \t]*\n', "", text, flags=re.M)

    m = re.search(
        r'("HKCU"\s*\{.*?^[ \t]*"Steam"\s*\n[ \t]*\{)',
        text,
        flags=re.M | re.S,
    )
    if not m:
        m = re.search(r'(^[ \t]*"Steam"\s*\n[ \t]*\{)', text, flags=re.M)
    if not m:
        path.write_text(text, encoding="utf-8")
        return

    head_end = m.end()
    i = head_end
    depth = 1
    while i < len(text) and depth:
        if text[i] == "{":
            depth += 1
        elif text[i] == "}":
            depth -= 1
        i += 1
    block = text[head_end : i - 1]
    indent = "\t\t\t\t\t"
    child = re.search(r'\n([ \t]+)"', "\n" + block)
    if child:
        indent = child.group(1)

    for k, v in WANT:
        pat = r'^[ \t]*"' + re.escape(k) + r'"[ \t]*"[^"]*"'
        if re.search(pat, block, flags=re.M):
            block = re.sub(pat, f'"{k}"\t\t"{v}"', block, count=1, flags=re.M)
            block = re.sub(
                r'^"' + re.escape(k) + r'"\t\t"' + re.escape(v) + r'"',
                f'{indent}"{k}"\t\t"{v}"',
                block,
                count=1,
                flags=re.M,
            )
        else:
            block = f'\n{indent}"{k}"\t\t"{v}"' + (block if block.startswith("\n") else "\n" + block)

    text = text[:head_end] + block + text[i - 1 :]
    path.write_text(text, encoding="utf-8")

for p in sys.argv[1:]:
    upsert(pathlib.Path(p))
PY
}

for arg in "$@"; do
  case "$arg" in
    --supports-duplicate-detection) exit 0 ;;
    --mark-oobe-only)
      mark_oobe_complete "$REG_STEAM" "$REG_LOCAL"
      exit 0
      ;;
  esac
done

exit 7
