#!/bin/bash
# pbos-report: a problem report, for the user to send to the PB-OS team.
# PB-OS Quick Access (System > Report a Problem) runs it as root and saves
# its output in ~/Desktop/PB-OS Reports; in Desktop Mode, `pbos-report
# audio > report.txt` does the same (some logs need sudo).
#
# It only reads: logs, settings and the state of the part named. It changes
# nothing and sends nothing anywhere.
#
# Usage: pbos-report AREA   (audio, sleep, controller, display, wifi, other)
#        pbos-report audio-root   (root only: just the audio path below PipeWire;
#        pbos-report-audio-root.service runs it for PB-OS Sound Check)
#        pbos-report audio-trace  (root only: starts the audio event recorder;
#        pbos-report-audio-trace.service runs it at boot)
set -u

area="${1:-other}"
case "$area" in audio|audio-root|audio-trace|sleep|controller|display|wifi|other) ;; *) echo "unknown area: $area" >&2; exit 2 ;; esac
export LC_ALL=C

# The desktop user's sound server and settings: as that user.
user=steamos
uid="$(id -u "$user" 2>/dev/null || echo 1000)"
as_user() {
  if [[ $EUID -eq 0 ]]; then
    setpriv --reuid="$uid" --regid="$(id -g "$user")" --init-groups -- \
      env HOME="/home/$user" XDG_RUNTIME_DIR="/run/user/$uid" "$@"
  else
    "$@"
  fi
}
section() { printf '\n=== %s\n' "$1"; }
# A command, at most 10 s; its errors in the report.
cmd() { timeout 10 "$@" 2>&1; }
# This boot's journal, wall-clock times.
log() { cmd journalctl -b --no-pager -o short-iso "$@"; }

common() {
  section "PB-OS problem report: $area, $(date '+%F %T %Z')"
  cat /usr/share/pb-os/version 2>/dev/null
  uname -r
  { tr -d '\0' < /proc/device-tree/model; } 2>/dev/null; echo
  uptime
  section "boots"
  cmd journalctl --list-boots --no-pager | tail -n 4
  section "sleep and wake (this boot)"
  log -g 'PM: suspend (entry|exit)|System returned from sleep|Entering sleep state' | tail -n 60
  section "memory and space"
  cmd free -m
  cmd df -h / /home
}

audio() {
  section "default output"
  as_user pactl get-default-sink 2>&1
  section "outputs"
  as_user pactl list sinks 2>&1 | grep -E '^Sink|Name:|State:|Mute:|^\s+Volume:|Driver:'
  section "streams (which output each plays on)"
  as_user pactl list short sink-inputs 2>&1
  as_user pactl list sink-inputs 2>&1 | grep -E '^Sink Input|Sink:|Mute:|^\s+Volume:|node.name|application.name|media.name'
  section "inputs"
  as_user pactl list short sources 2>&1
  section "wpctl status"
  as_user wpctl status 2>&1
  section "links"
  links="$(as_user timeout 10 pw-link -l 2>&1)"
  [[ -n $links ]] && printf '%s\n' "$links" || echo "(none: nothing is playing)"
  section "sound card"
  cat /proc/asound/cards 2>&1
  for s in /proc/asound/card*/pcm*/sub0/status; do
    [[ -r $s ]] && printf '%s: %s\n' "$s" "$(tr '\n' ' ' < "$s")"
  done
  section "mixers (card 0)"
  # name = values, one line each
  cmd amixer -c 0 contents | awk -F"'" '/^numid=/{n=$2} /: values=/{sub(/^ *: values=/,""); print n " = " $0}'
  section "sound services"
  as_user systemctl --user --no-pager status pipewire wireplumber pipewire-pulse 2>&1 | grep -E '●|Active:|Main PID'
  section "sound log (this boot)"
  # By field, not --user-unit: as root that matches only root's own units.
  local m=() u
  for u in pbos-thor-audio sm8550-audio-setup; do m+=(_SYSTEMD_UNIT=$u.service + UNIT=$u.service +); done
  for u in pipewire wireplumber pipewire-pulse barry_launcher_audio sm8550-audio-pipewire \
           sm8550-volume-keeper sm8550-volume-keys; do
    m+=(_SYSTEMD_USER_UNIT=$u.service + USER_UNIT=$u.service +)
  done
  unset 'm[${#m[@]}-1]'
  log "${m[@]}" | tail -n 300
  section "memory guard (this boot)"
  log -g 'memguard' | tail -n 40
  section "kernel sound lines (this boot)"
  log -k | grep -iE 'snd|audio|q6|adsp|remoteproc|PDR|gpr|apm|soundwire|wsa|wcd|lpass' | tail -n 200
  [[ $EUID -eq 0 ]] && audio_root
}

# Below PipeWire, root only (debugfs): which DAPM widgets are powered (where
# the path from the DSP to the speakers stops), the speaker amps' (aw88166 or
# WSA884x) and the LPASS WSA macro's registers, SoundWire, and the playback
# pointer twice a second apart (does the DSP take the audio at playback speed?).
# A little-endian number, n bytes, for a WAV header.
le() { local v=$1 n=$2 i; for ((i = 0; i < n; i++)); do printf "\\x$(printf %02x $(((v >> (8 * i)) & 255)))"; done; }

# Silence (48 kHz stereo, 16 bit): the audio path is read while it plays, so
# it is powered as it is for sound, and nobody hears anything.
silence() {
  local n=$((48000 * 4 * $2))
  { printf 'RIFF'; le $((36 + n)) 4; printf 'WAVEfmt '; le 16 4; le 1 2; le 2 2; le 48000 4; le 192000 4
    le 4 2; le 16 2; printf 'data'; le "$n" 4; head -c "$n" /dev/zero; } > "$1"
}

# The audio event recorder (pbos-report-audio-trace.service, from boot): two
# tracefs ring buffers that audio_root reads, so a report shows what changed
# at the moment the playback stream froze, not only the state after.
# "pbos-audio" keeps the rare events: LPASS clocks and DSP votes (clk), runtime
# PM of the LPASS codec macros and SoundWire (rpm), DAPM and bias levels,
# suspend and wake, and each DSP graph and DAI step with its result.
# "pbos-audio-io" keeps the data flow: each buffer written to the DSP, each
# packet back from it, each period done. The monotonic clock, as ALSA's
# playback status uses, so the frozen pointer's time lines up with the events.
T=/sys/kernel/tracing
AT=$T/instances/pbos-audio
AIO=$T/instances/pbos-audio-io

audio_trace() {
  [[ $EUID -eq 0 ]] || { echo "audio-trace: root only" >&2; return 1; }
  [[ -d $T/instances ]] || { echo "audio-trace: no tracefs at $T" >&2; return 1; }
  mkdir -p "$AT" "$AIO" || return 1
  local i e
  for i in "$AT" "$AIO"; do
    echo mono > "$i/trace_clock"
    echo 256 > "$i/buffer_size_kb"
  done
  # Tracepoints, filtered to the audio parts (6*.pinctrl: the LPASS pin
  # controller, not the SoC's main one).
  local devs='name ~ "*.codec" || name ~ "*soundwire*" || name ~ "sdw-*" || name ~ "6*.pinctrl" || name ~ "*remoteproc*" || name == "sound"'
  local clks='name ~ "LPASS*" || name ~ "*mclk*" || name ~ "fsgen*" || name ~ "*npl*"'
  event() {
    local d=$AT/events/$1
    [[ -d $d ]] || { echo "audio-trace: no event $1"; return; }
    if [[ -n ${2:-} ]]; then echo "$2" > "$d/filter" || echo "audio-trace: filter refused on $1"; fi
    echo 1 > "$d/enable" || echo "audio-trace: cannot enable $1"
  }
  for e in rpm_suspend rpm_resume rpm_return_int; do event "rpm/$e" "$devs"; done
  for e in clk_prepare clk_unprepare clk_enable clk_disable clk_set_rate; do event "clk/$e" "$clks"; done
  for e in asoc/snd_soc_bias_level_start asoc/snd_soc_dapm_widget_power; do event "$e"; done
  # Sleep and wake: one line each (not every CPU and phase).
  event power/suspend_resume 'action == "machine_suspend"'
  # Probes on the DSP driver (MOD:SYM waits for a module not loaded yet).
  # Each on its own: one the compiler renamed or inlined only loses itself.
  if [[ ! -w $T/kprobe_events ]]; then echo "audio-trace: no kprobes in this kernel"; return 0; fi
  probe() {
    local inst=$1 def=$2 n
    n=${def%% *}; n=${n#*/}
    [[ -d $inst/events/pbosaudio/$n ]] || echo "$def" >> "$T/kprobe_events" 2>/dev/null \
      || { echo "audio-trace: no probe $def"; return; }
    echo 1 > "$inst/events/pbosaudio/$n/enable" || echo "audio-trace: cannot enable $n"
  }
  probe "$AT" 'p:pbosaudio/apm_open snd_q6apm:q6apm_graph_open graph_id=%x3:s32'
  probe "$AT" 'r:pbosaudio/apm_open_ret snd_q6apm:q6apm_graph_open graph=$retval:x64'
  probe "$AT" 'p:pbosaudio/apm_close snd_q6apm:q6apm_graph_close graph=%x0:x64'
  for e in prepare start stop flush; do
    probe "$AT" "p:pbosaudio/apm_$e snd_q6apm:q6apm_graph_$e graph=%x0:x64"
    probe "$AT" "r:pbosaudio/apm_${e}_ret snd_q6apm:q6apm_graph_$e ret=\$retval:s32"
  done
  probe "$AT" 'p:pbosaudio/prm_clock q6prm:q6prm_set_lpass_clock id=%x1:u32 attr=%x2:u32 root=%x3:u32 freq=%x4:u32'
  probe "$AT" 'r:pbosaudio/prm_clock_ret q6prm:q6prm_set_lpass_clock ret=$retval:s32'
  probe "$AT" 'p:pbosaudio/prm_vote q6prm:q6prm_vote_lpass_core_hw block=%x1:u32 client=+0(%x2):string'
  probe "$AT" 'r:pbosaudio/prm_vote_ret q6prm:q6prm_vote_lpass_core_hw ret=$retval:s32'
  probe "$AT" 'p:pbosaudio/prm_unvote q6prm:q6prm_unvote_lpass_core_hw block=%x1:u32 handle=%x2:u32'
  probe "$AT" 'r:pbosaudio/prm_unvote_ret q6prm:q6prm_unvote_lpass_core_hw ret=$retval:s32'
  for e in open close prepare; do
    probe "$AT" "p:pbosaudio/fe_$e q6apm_dai:q6apm_dai_$e"
    probe "$AT" "r:pbosaudio/fe_${e}_ret q6apm_dai:q6apm_dai_$e ret=\$retval:s32"
  done
  probe "$AT" 'p:pbosaudio/fe_trigger q6apm_dai:q6apm_dai_trigger cmd=%x2:s32'
  for e in startup prepare; do
    probe "$AT" "p:pbosaudio/be_$e q6apm_lpass_dais:q6apm_lpass_dai_$e"
    probe "$AT" "r:pbosaudio/be_${e}_ret q6apm_lpass_dais:q6apm_lpass_dai_$e ret=\$retval:s32"
  done
  probe "$AT" 'p:pbosaudio/be_shutdown q6apm_lpass_dais:q6apm_lpass_dai_shutdown'
  probe "$AT" 'p:pbosaudio/be_trigger q6apm_lpass_dais:q6apm_lpass_dai_trigger cmd=%x1:s32'
  probe "$AIO" 'p:pbosaudio/dsp_write snd_q6apm:q6apm_write_async graph=%x0:x64 len=%x1:u32'
  # Every packet from the DSP (GPR header: token at 16, opcode at 20).
  probe "$AIO" 'p:pbosaudio/dsp_rx apr_callback len=%x2:s32 token=+16(%x1):x32 opcode=+20(%x1):x32'
  probe "$AIO" 'p:pbosaudio/period q6apm_dai:event_handler opcode=%x0:x32 token=%x1:x32'
  echo "audio-trace: recording"
}

# What the recorder holds that no report read showed yet (a marker is written
# after each read), at most $2 lines, newest last, short (a sent report is cut
# at 400 KB): "time task event: fields", without CPU, flags and offsets.
trace_new() {
  local d=$1
  [[ -r $d/trace ]] || { echo "(not recording: see pbos-report-audio-trace.service)"; return; }
  awk '/pbos-report read/{n=NR} {l[NR]=$0} END{for (i = n + 1; i <= NR; i++) if (l[i] !~ /^#/) print l[i]}' "$d/trace" \
    | tail -n "$2" \
    | awk '{ for (i = 2; i <= NF; i++) if ($i ~ /^[0-9]+\.[0-9]+:$/) break
             if (i > NF) { print; next }
             s = $i; for (j = i + 1; j <= NF; j++) s = s " " $j
             gsub(/\+0x[0-9a-f]+\/0x[0-9a-f]+/, "", s)
             print s, "[" $1 "]" }'
  echo "pbos-report read" > "$d/trace_marker"
}

# ADSP interrupts and packet counts (does the DSP still answer?).
dsp_irqs() { grep -iE 'glink|ipcc|smp2p|adsp|lpass|swr|soundwire|6800000' /proc/interrupts | tr -s ' '; }

# The stall check (the Thor sound dropout, seen live 10-27): which side
# stopped, read before anything is changed. With the speakers IRQ-driven
# (api.alsa.disable-tsched), PipeWire's ALSA sink turns its poll off while the
# graph runs a cycle and on again when it writes; when the graph refuses the
# cycle, nothing turns it on again. Then the PCM stays RUNNING with hw_ptr
# frozen, PipeWire's data loop sleeps in epoll_wait with the PCM fd polled for
# errors only (events 18: no POLLOUT, 0x4) and its timers off, and the DSP is
# fine. The class, in the report's "stall class:" line, picks PB-OS Sound
# Check's first fix:
#   A  PipeWire stopped writing: hw_ptr frozen, the PCM fd in the data loop's
#      epoll set without POLLOUT, no timer armed (the data loop's switches are
#      shown; it may still wake for other fds on the same loop).
#   B  DSP or kernel: hw_ptr frozen while PipeWire still waits for the PCM
#      (POLLOUT or a timer armed) or keeps writing to the DSP.
#   C  anything else, a working stream included: everything is recorded.
# PBOS_REPORT_ASOUND: a test's stand-in for /proc/asound.
ASOUND="${PBOS_REPORT_ASOUND:-/proc/asound}"

# A field of a PCM status file ("hw_ptr      : 1234" -> 1234).
pcm_field() {
  awk -v k="$2" '{ i = index($0, ":"); n = substr($0, 1, i - 1); gsub(/[ \t]/, "", n)
                   if (n == k) { v = substr($0, i + 1); gsub(/^[ \t]+|[ \t]+$/, "", v); print v; exit } }' "$1" 2>/dev/null
}
mono_now() { awk '/^now at/{printf "%.6f\n", $3 / 1e9; exit}' /proc/timer_list 2>/dev/null; }

# Each thread of process $1: "tid comm state policy/rtprio switches", the
# switches voluntary and not, added.
threads() {
  local t st
  for t in /proc/$1/task/*; do
    st="$(cat "$t/stat" 2>/dev/null)" || continue
    set -- ${st##*) }
    printf '%s %s %s %s/%s %s\n' "${t##*/}" "$(tr ' ' '_' < "$t/comm")" "$1" "${39:-?}" "${38:-?}" \
      "$(awk '/^(non)?voluntary_ctxt_switches/{s += $2} END{print s + 0}' "$t/status" 2>/dev/null)"
  done
}

# The recorder's writes to the DSP, packets back and periods between two
# monotonic times (its clock).
trace_counts() {
  [[ -r $AIO/trace ]] || { echo "(recorder off)"; return; }
  awk -v a="$1" -v b="$2" '
    { for (i = 2; i <= NF; i++) if ($i ~ /^[0-9]+\.[0-9]+:$/) break
      if (i >= NF) next
      t = $i + 0; if (t < a || t > b) next
      e = $(i + 1); sub(/:$/, "", e); n[e]++ }
    END { printf "dsp_write %d, dsp_rx %d, period %d\n", n["dsp_write"], n["dsp_rx"], n["period"] }' "$AIO/trace"
}

audio_stall() {
  section "stall check ($1): which side stopped (the classes: audio_stall in pbos-report)"
  local s pcms=() pids=() pid t0 t1 i
  for s in "$ASOUND"/card*/pcm*p/sub*/status; do
    [[ $(pcm_field "$s" state) == RUNNING ]] && pcms+=("$s")
  done
  if ((${#pcms[@]} == 0)); then
    echo "stall class: C (no playback stream running)"
    return
  fi
  # The process holding each PCM (owner_pid is the thread that opened it).
  for s in "${pcms[@]}"; do
    pid="$(pcm_field "$s" owner_pid)"
    pid="$(awk '/^Tgid:/{print $2}' "/proc/${pid:-0}/status" 2>/dev/null)"
    pids+=("${pid:-0}")
  done
  # Everything twice, 1 s apart.
  local before=() th0=()
  t0="$(mono_now)"
  for i in "${!pcms[@]}"; do
    before+=("$(cat "${pcms[i]}")")
    th0+=("$(threads "${pids[i]}")")
  done
  sleep 1
  t1="$(mono_now)"
  local cls="" why="" anchor="" seen=()
  for i in "${!pcms[@]}"; do
    s="${pcms[i]}"
    pid="${pids[i]}"
    local card dev node h0 h1 st1 fd f e line tfd link ep="" evs="" armed=0 dl="" dsw=""
    card="${s#"$ASOUND"/card}"; card="${card%%/*}"
    dev="${s#"$ASOUND"/card*/pcm}"; dev="${dev%%p/*}"
    node="/dev/snd/pcmC${card}D${dev}p"
    h0="$(pcm_field <(printf '%s\n' "${before[i]}") hw_ptr)"
    h1="$(pcm_field "$s" hw_ptr)"
    st1="$(pcm_field "$s" state)"
    echo "-- ${s#"$ASOUND"/} ($node), process $pid ($(cat "/proc/$pid/comm" 2>/dev/null))"
    printf 'status: %s\n' "$(tr '\n' ' ' <<< "${before[i]}")"
    printf '1 s later: %s\n' "$(tr '\n' ' ' < "$s")"
    # The epoll sets holding the PCM's fd, and what each fd in them is.
    for fd in /proc/$pid/fd/*; do
      [[ $(readlink "$fd" 2>/dev/null) == "$node" ]] || continue
      fd="${fd##*/}"
      for f in /proc/$pid/fdinfo/*; do
        e="$(awk -v n="$fd" '$1 == "tfd:" && $2 == n {print $4; exit}' "$f" 2>/dev/null)"
        [[ -n $e ]] || continue
        ep+="${ep:+ }${f##*/}"
        evs+="${evs:+ }$e"
        echo "epoll fd ${f##*/}: the PCM's fd $fd with events 0x$e (POLLOUT $( ((0x$e & 0x4)) && echo on || echo off))"
        while read -r line; do
          tfd="$(awk '{print $2}' <<< "$line")"
          link="$(readlink "/proc/$pid/fd/$tfd" 2>/dev/null)"
          printf '  %s -> %s' "$line" "$link"
          case "$link" in
            *timerfd*)
              printf ' [%s]' "$(grep -E '^(clockid|ticks|it_value|it_interval)' "/proc/$pid/fdinfo/$tfd" 2>/dev/null | tr '\n' ' ')"
              grep -qE '^it_value: \(0, 0\)' "/proc/$pid/fdinfo/$tfd" 2>/dev/null || armed=$((armed + 1)) ;;
            *eventfd*)
              printf ' [%s]' "$(grep -E '^eventfd-count' "/proc/$pid/fdinfo/$tfd" 2>/dev/null)" ;;
          esac
          echo
        done < <(grep '^tfd:' "$f")
      done
    done
    # Each thread, and which one sleeps on that epoll set (the first argument
    # of its epoll_pwait; else the thread named data-loop).
    local tl task c0 sc
    while read -r tl; do
      set -- $tl
      task=$1
      sc="$(cat "/proc/$pid/task/$task/syscall" 2>/dev/null)"
      c0="$(awk -v t="$task" '$1 == t {print $5}' <<< "${th0[i]}")"
      printf 'thread %s %s: state %s, policy/rtprio %s, %s switches in 1 s, wchan %s, syscall %s\n' "$task" "$2" "$3" "$4" \
        "$(($5 - ${c0:-$5}))" "$(cat "/proc/$pid/task/$task/wchan" 2>/dev/null)" "${sc:-?}"
      for e in $ep; do
        if [[ ${sc#* } == "$(printf '0x%x' "$e") "* ]] || [[ -z $dl && $2 == data-loop* ]]; then
          dl="$task ($2)"
          dsw=$(($5 - ${c0:-$5}))
        fi
      done
    done < <(threads "$pid")
    for task in /proc/$pid/task/*; do
      [[ -r $task/stack ]] && printf 'kernel stack %s (%s):\n%s\n' "${task##*/}" "$(cat "$task/comm")" "$(sed 's/^/  /' "$task/stack")"
    done
    local counts
    counts="$(trace_counts "$t0" "$t1")"
    echo "recorder, the same second: $counts"
    # The class: the first frozen stream's.
    if [[ -z $cls && $st1 == RUNNING && -n $h0 && $h0 == "$h1" ]]; then
      anchor="$(pcm_field "$s" tstamp)"
      local pollout=0 x
      for x in $evs; do ((0x$x & 0x4)) && pollout=1; done
      if [[ -n $ep && $pollout == 0 && $armed == 0 ]]; then
        cls=A
        why="PipeWire stopped writing: ${node##*/} hw_ptr $h1 frozen, its fd polled without POLLOUT (events 0x${evs// /, 0x}),"
        why+=" no timer armed, data loop ${dl:-not found} ${dsw:-?} switches in 1 s"
      elif [[ -n $ep ]] || [[ $counts == "dsp_write "[1-9]* ]]; then
        cls=B
        why="DSP or kernel: ${node##*/} hw_ptr $h1 frozen while PipeWire waits for it"
        why+=" (POLLOUT $( ((pollout)) && echo on || echo off), $armed timer(s) armed, data loop ${dsw:-?} switches; $counts)"
      else
        cls=C
        why="${node##*/} hw_ptr $h1 frozen, but its fd is in no epoll set of process $pid"
      fi
    fi
    seen+=("${node##*/} $st1 hw_ptr ${h0:-?} -> ${h1:-?}")
  done
  if [[ -z $cls ]]; then
    cls=C
    why="no frozen playback stream: $(IFS=';'; echo "${seen[*]}")"
  fi
  echo "stall class: $cls ($why)"
  # The freeze's time: the frozen status's tstamp (CLOCK_MONOTONIC, as
  # journalctl -o short-monotonic; /proc/uptime counts sleep too).
  echo "freeze time (monotonic): ${anchor:-none}, read at $t1"
  stall_context "${pids[0]}" "${anchor:-$t1}"
}

# What surrounds a stall: the ALSA plugin PipeWire runs (PB-OS's patched one
# logs "graph did not start a cycle"), its nodes and their clients, and the
# journal in the 2 minutes before $2 (monotonic s).
stall_context() {
  local pid=$1 at=$2 m l=""
  section "PipeWire's ALSA plugin (process $pid)"
  for m in /proc/$pid/map_files/*; do
    l="$(readlink "$m" 2>/dev/null)"
    [[ $l == */libspa-alsa.so* ]] || { l=""; continue; }
    printf 'mapped %s: sha256 %s, "did not start a cycle" %s\n' "$l" "$(sha256sum < "$m" | cut -c1-64)" \
      "$(grep -qa 'did not start a cycle' "$m" && echo 'present (patched)' || echo 'absent (stock)')"
    break
  done
  [[ -n $l ]] || echo "(no libspa-alsa.so in its map_files)"
  printf 'on disk: sha256 %s\n' "$(sha256sum 2>/dev/null < /usr/lib/spa-0.2/alsa/libspa-alsa.so | cut -c1-64)"
  local refused
  refused="$(journalctl -b --no-pager -o short-monotonic _SYSTEMD_USER_UNIT=pipewire.service -g 'did not start a cycle' 2>/dev/null \
    | grep -v '^-- ')"
  printf '"did not start a cycle" warnings this boot: %s\n' "$(grep -c . <<< "$refused")"
  [[ -n $refused ]] && tail -n 5 <<< "$refused" | sed -E 's/^(\[[^]]*\]) [^ ]+ /\1 /'
  section "PipeWire nodes and their clients (pw-dump)"
  as_user timeout 10 pw-dump 2>&1 | python3 -I -c '
import json, sys
raw = sys.stdin.read()
try:
    d = json.loads(raw)
except ValueError as e:
    sys.exit("pw-dump unreadable (%s): %s" % (e, raw[:300]))
clients = {o["id"]: (o.get("info") or {}).get("props", {}) for o in d if o.get("type") == "PipeWire:Interface:Client"}
for o in d:
    if o.get("type") != "PipeWire:Interface:Node":
        continue
    i = o.get("info") or {}
    p = i.get("props", {})
    c = clients.get(p.get("client.id"), {})
    print("node %s %s [%s] %s, client %s %s pid %s%s" % (o["id"], p.get("node.name", "?"), p.get("media.class", ""),
          i.get("state"), p.get("client.id", "-"), c.get("application.name", ""), c.get("application.process.id", "?"),
          ", error " + i["error"] if i.get("error") else ""))
' 2>&1
  section "pw-top (batch, 2 samples)"
  as_user timeout 6 pw-top -b -n 2 2>&1 | tail -n 60
  section "journal, 2 minutes before the freeze (monotonic s): sound, Barry, the bottom screen"
  # --since takes wall time, which counts sleep; /proc/uptime does too, so
  # this start is early enough, and awk keeps the exact monotonic window.
  local up since
  up="$(cut -d. -f1 /proc/uptime)"
  since=$(($(date +%s) - (up - ${at%.*}) - 125))
  journalctl -b --no-pager -o short-monotonic --since "@$since" 2>/dev/null \
    | awk -v a="$at" '{ s = $0; sub(/^\[ */, "", s); t = s + 0; if (t >= a - 120 && t <= a + 2) print }' \
    | grep -E 'pipewire|wireplumber|[Bb]arry|run-bottom|gamescope|firefox|pbos-platformd|pbosd|sm8550-audio|volume-keeper|systemd\[[0-9]+\]: (Start|Stop)' \
    | sed -E 's/^(\[[^]]*\]) [^ ]+ /\1 /' | tail -n 300
}

audio_root() {
  if [[ $EUID -ne 0 ]]; then section "audio path (root only): skipped, not root"; return; fi
  # A stream still running is checked as found, before anything new plays.
  local found=""
  if grep -qs 'state: RUNNING' "$ASOUND"/card*/pcm*p/sub*/status; then
    audio_stall "as found"
    found=1
  fi
  local quiet player=""
  quiet="$(mktemp /tmp/pbos-report-silence.XXXXXX.wav)"
  silence "$quiet" 10
  chmod 0644 "$quiet"
  as_user timeout 12 pw-play "$quiet" >/dev/null 2>&1 &
  player=$!
  # Until a playback stream runs (after a PipeWire restart the outputs take a
  # few seconds to come back), at most 6 s.
  local p i
  for ((i = 0; i < 24; i++)); do
    grep -qs 'state: RUNNING' /proc/asound/card*/pcm*p/sub0/status && break
    sleep 0.25
  done
  sleep 1
  [[ -n $found ]] || audio_stall "while silence plays"
  section "playback stream while silence plays (hw_params, then status twice, 1 s apart)"
  awk '/^now at/{printf "monotonic now: %.6f\n", $3 / 1e9; exit}' /proc/timer_list
  for p in /proc/asound/card*/pcm*p/sub0; do
    [[ -r $p/status ]] || continue
    printf '%s hw_params: %s\n' "$p" "$(tr '\n' ' ' < "$p/hw_params")"
    printf '%s status: %s\n' "$p" "$(tr '\n' ' ' < "$p/status")"
  done
  local irq1
  irq1="$(dsp_irqs)"
  sleep 1
  for p in /proc/asound/card*/pcm*p/sub0; do
    [[ -r $p/status ]] && printf '%s status: %s\n' "$p" "$(tr '\n' ' ' < "$p/status")"
  done
  section "DSP interrupts, 1 s apart"
  printf '%s\n-- 1 s later\n' "$irq1"
  dsp_irqs
  section "ASoC links (front end and back end state)"
  for p in /sys/kernel/debug/asoc/*/*/state; do
    [[ -r $p ]] && { echo "-- ${p#/sys/kernel/debug/asoc/}"; cat "$p"; }
  done
  section "LPASS devices (runtime PM)"
  local d a
  for d in /sys/bus/platform/devices/*; do
    case "${d##*/}" in *.codec|*soundwire*|*pinctrl*|*remoteproc*|sound|*dais*|*prm*|*apm*) ;; *) continue ;; esac
    [[ -r $d/power/runtime_status ]] || continue
    printf '%s:' "${d##*/}"
    for a in runtime_status control runtime_usage runtime_active_kids autosuspend_delay_ms runtime_active_time runtime_suspended_time; do
      [[ -r $d/power/$a ]] && printf ' %s=%s' "$a" "$(cat "$d/power/$a" 2>/dev/null)"
    done
    echo
  done
  # Each clock's own counts: clk_summary would wake the codec macros (runtime
  # PM) and so vote the very LPASS blocks this looks at.
  section "LPASS clocks in use (enable / prepare counts)"
  for d in /sys/kernel/debug/clk/*; do
    case "${d##*/}" in LPASS*|*mclk*|fsgen*|*npl*) ;; *) continue ;; esac
    [[ -r $d/clk_enable_count ]] || continue
    a="$(cat "$d/clk_enable_count" 2>/dev/null) / $(cat "$d/clk_prepare_count" 2>/dev/null)"
    [[ $a == "0 / 0" ]] || printf '%s: %s\n' "${d##*/}" "$a"
  done
  section "power domains (audio)"
  [[ -r /sys/kernel/debug/pm_genpd/pm_genpd_summary ]] \
    && grep -iE '^domain|lcx|lmx|lpass|audio|codec|soundwire|6800000' /sys/kernel/debug/pm_genpd/pm_genpd_summary
  section "remote processors"
  for d in /sys/class/remoteproc/*; do
    [[ -r $d/state ]] && printf '%s: %s %s\n' "${d##*/}" "$(cat "$d/name" 2>/dev/null)" "$(cat "$d/state")"
  done
  section "DAPM widgets while silence plays (powered On/Off)"
  local w
  for w in /sys/kernel/debug/asoc/*/dapm/* /sys/kernel/debug/asoc/*/*/dapm/*; do
    [[ -f $w && ${w##*/} != bias_level ]] || continue
    printf '%s: %s\n' "${w#/sys/kernel/debug/asoc/}" "$(head -n 1 "$w" 2>&1)"
  done | sort
  for w in /sys/kernel/debug/asoc/*/dapm/bias_level /sys/kernel/debug/asoc/*/*/dapm/bias_level; do
    [[ -f $w ]] && printf '%s: %s\n' "${w#/sys/kernel/debug/asoc/}" "$(cat "$w")"
  done
  section "SoundWire devices"
  local d a
  for d in /sys/bus/soundwire/devices/*; do
    [[ -d $d ]] || continue
    printf '%s: driver %s' "${d##*/}" "$(basename "$(readlink "$d/driver" 2>/dev/null)" 2>/dev/null)"
    for a in status power/runtime_status; do
      [[ -r $d/$a ]] && printf ', %s %s' "$a" "$(cat "$d/$a" 2>/dev/null)"
    done
    echo
  done
  local f
  for f in /sys/kernel/debug/soundwire/master-*/registers; do
    [[ -r $f ]] && { echo "-- $f"; head -n 200 "$f"; }
  done
  section "register maps"
  local r n
  for r in /sys/kernel/debug/regmap/*; do
    printf '%s (%s)\n' "${r##*/}" "$(cat "$r/name" 2>/dev/null)"
  done
  # The speaker amps: aw88166 on I2S (AYN Odin 2 family, Thor, Retroid) or
  # WSA884x on SoundWire, and the LPASS WSA macro.
  section "speaker amp and WSA macro registers"
  for r in /sys/kernel/debug/regmap/*; do
    n="$(cat "$r/name" 2>/dev/null)"
    case "${r##*/} $n" in *wsa*|*aw88*|*aw87*|*0217:0204*|*0217:0202*) ;; *) continue ;; esac
    echo "-- ${r##*/} ($n)"
    head -n 1500 "$r/registers" 2>&1
  done
  kill "$player" 2>/dev/null
  wait "$player" 2>/dev/null
  rm -f "$quiet"
  sleep 0.5
  section "audio recorder"
  journalctl -b --no-pager -o cat -u pbos-report-audio-trace.service 2>&1 | tail -n 40
  grep -s pbosaudio "$T/kprobe_profile" | tr -s ' '
  for i in "$AT" "$AIO"; do
    [[ -d $i ]] && printf '%s: lost %s events\n' "${i##*/}" \
      "$(awk '/^overrun:/{s += $2} END{print s + 0}' "$i"/per_cpu/cpu*/stats 2>/dev/null)"
  done
  section "audio events since the last read (LPASS clocks and votes, runtime PM, DAPM, DSP graph and DAI steps; monotonic s)"
  trace_new "$AT" 1500
  section "audio data flow since the last read (writes to the DSP, packets back, periods; last 300)"
  trace_new "$AIO" 300
}

sleep_area() {
  section "suspend stats"
  for f in /sys/power/suspend_stats/*; do [[ -r $f ]] && printf '%s: %s\n' "${f##*/}" "$(cat "$f")"; done
  cat /sys/power/mem_sleep 2>&1
  section "wake sources (most events)"
  sort -t$'\t' -k3 -n -r /sys/kernel/debug/wakeup_sources 2>/dev/null | head -n 25
  section "sleep log (this boot)"
  log -g 'suspend|resume|sleep|wake|lid|PM:' | tail -n 300
  section "previous boot, last lines"
  cmd journalctl -b -1 --no-pager -o short-iso | tail -n 120
}

controller() {
  section "input devices"
  grep -E '^N: |^H: ' /proc/bus/input/devices 2>&1
  section "USB"
  cmd lsusb
  section "InputPlumber"
  cmd systemctl --no-pager status inputplumber | head -n 5
  log -u inputplumber | tail -n 200
  section "input kernel lines (this boot)"
  log -k | grep -iE 'input|hid|usb|xpad|rsinput|gamepad' | tail -n 150
}

display() {
  section "screens"
  for c in /sys/class/drm/card*-*; do
    [[ -r $c/status ]] && printf '%s: %s, enabled %s, %s\n' "${c##*/}" "$(cat "$c/status")" \
      "$(cat "$c/enabled" 2>/dev/null)" "$(head -n 1 "$c/modes" 2>/dev/null)"
  done
  for b in /sys/class/backlight/*; do
    [[ -r $b/brightness ]] && printf '%s: %s / %s\n' "${b##*/}" "$(cat "$b/brightness")" "$(cat "$b/max_brightness")"
  done
  section "gamescope (this boot)"
  log -g 'gamescope' | grep -viE 'binding:' | tail -n 200
  section "display kernel lines (this boot)"
  log -k | grep -iE 'drm|dsi|dpu|panel|msm|edp|displayport' | tail -n 150
}

wifi() {
  section "network"
  cmd nmcli -f DEVICE,TYPE,STATE,CONNECTION device
  cmd iw dev wlan0 link | grep -vE '^Connected to|SSID'
  section "Wi-Fi log (this boot)"
  log -u NetworkManager -u wpa_supplicant -u iwd | tail -n 200
  section "Wi-Fi kernel lines (this boot)"
  log -k | grep -iE 'wlan|ath1|ath12|wcn|cfg80211|mac80211' | tail -n 150
}

if [[ $area == audio-root ]]; then
  audio_root
  exit 0
fi
if [[ $area == audio-trace ]]; then
  audio_trace
  exit
fi
common
case "$area" in
  audio) audio ;;
  sleep) sleep_area ;;
  controller) controller ;;
  display) display ;;
  wifi) wifi ;;
esac
section "warnings and errors (this boot)"
log -p warning | tail -n 300
section "end"
